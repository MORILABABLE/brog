{
  // ★ 現在このファイルは使われていない。
  //   本番は Cloudflare Pages で稼働しており、Pages はこの設定を読まない。
  //   将来 Cloudflare が Pages を Workers に完全統合したときの移行先として残している。
  //   （2026-08 時点で Cloudflare は Pages → Workers の統合を進めており、
  //     新規作成のUIは Workers 側に誘導される。Pages の作成画面は
  //     dash.cloudflare.com/?to=/:account/pages/new/provider/github から開ける）
  //
  // Workers に移行する場合のダッシュボード設定:
  //   Root directory        : site
  //   Build command         : npm run build
  //   Deploy command        : npx wrangler deploy
  //   Non-production branch : npx wrangler versions upload   ← PRプレビュー用
  //   ※ wrangler を devDependency に入れ直す必要がある（Pages では不要なので外してある）
  "name": "brog",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // 拡張子なしのURL（/posts/xxx）で .html を返す。
    // astro.config.mjs の build.format: 'file' と対になる設定。
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
