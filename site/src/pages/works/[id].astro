---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import Thumb from '../../components/Thumb.astro'
import AfbCta from '../../components/AfbCta.astro'
import WorkCover from '../../components/WorkCover.astro'
import WatchStar from '../../components/WatchStar.astro'
import DemandShelf from '../../components/DemandShelf.astro'
import { amazonTagFor, ATTRIBUTION, SITE, hubFor, WORK_FIND_ENABLED } from '../../config'
import { relFor, withAmazonTag } from '../../lib/affiliate'
import { hasCalendar } from '../../lib/events-data'
import { amazonVideoLink, otherServiceLinks } from '../../lib/search-links'
import { seriesRefFor } from '../../lib/series-for-work'
import { hubArticleFor } from '../../lib/work-hub-article'
import {
  coverLink,
  HISTORY_LABEL,
  STATE_CATEGORY,
  observationStart,
  passedCheck,
  passedNote,
  publishableWorkPages,
  relatedWorks,
  STOCK_HEADING,
  serviceCtaLabel,
  serviceUrl,
  stateBadge,
  statusRows,
  statusSentence,
  noticeAsOf,
  stockAnswer,
  seriesArticleFor,
  workDescription,
  workHeadline,
  workIndexable,
  workPage,
} from '../../lib/works'
import type { WorkPage } from '../../lib/works'
import { personHref } from '../../lib/people'
import { formatDate, isoDate } from '../../utils/date'

/**
 * 作品ページ `/works/<作品ID>`。
 *
 * ■ 何のためにあるか
 * 記事も常設ページも「その月に何が起きたか」の軸で、
 * **1作品を名指しで探しに来た読者の受け皿が無かった**。
 * 狙うのは「〇〇 いつまで Netflix」「〇〇 どこで見れる」のような語で、
 * **終了日を出せるサイトがほとんど無い**ぶん当てられる。
 * 設計は docs/WORK-PAGES.md、位置づけは docs/GROWTH.md 3-1。
 *
 * ■ LLMを使わない
 * 出すのは作品名・日付・年・監督・出演といった事実だけ。
 * **文言はすべて状態と日付から組み立てる。手書きの説明文を置かない。**
 * 置くとビルドのたびに古くなる（常設ページと同じ方針。lib/events-data.ts 冒頭）。
 *
 * ■ 絶対に守ること
 * **「配信中」と書かない。** 持っているのは「変化の観測」であって
 * 「現在の在庫」ではない。言い回しの規則は lib/works.ts の `WorkState`。
 */
export function getStaticPaths() {
  // ★ 掲載判定を通らない作品は**ここで返さない**（noindex で隠すのではない）。
  //   返さなければサイトマップにも載らず、リンクを張らない工夫も要らない。
  return publishableWorkPages().map((w) => ({ params: { id: w.id }, props: { work: w } }))
}

interface Props {
  work: WorkPage
}

// props から受け取る。getStaticPaths が渡しているので再検索は要らないが、
// 念のため落ちない形にしておく（dev の単発描画で props が欠ける場合の保険）。
const { work } = Astro.props as Props
const w = work ?? workPage(Astro.params.id!)!

// --- 言い回し ------------------------------------------------------------------

/*
 * **文言は lib/works.ts に移した（2026-09-06）。**
 *
 * 以前はここに `sentence()` と h1 を持ち、「WorkState の表と1対1で対応させること」と
 * 注意書きで縛っていた。状態は毎日の収集で勝手に動く（leaving → passed → ended）ので、
 * **人が対応を保つ形にしておくと、動いた日に静かにずれる。**
 * `WorkState` と同じファイルに置けば、状態を足したときに型エラーで気づく。
 *
 * 見出しをどう組むか・なぜ問いを先に置くかは `workHeadline()` の注意書き。
 */
const head = w.services[0]!
const title = workHeadline(w)
const description = workDescription(w)

// パンくずの親。作品ページは公開日を持たないので、状態で親を決める。
const hub = hubFor(w.state === 'started' ? 'arrivals' : 'leaving')

/**
 * 「☆ 気になる」を出すか。**2026-09-22 から全作品に出している**（運用者の指定）。
 *
 * 9-21 に一度止めた（約束が「終了日が近づいたときに気づける」だけで、
 * 終了日がこれから来る作品が678件中84件しか無かった）。戻すにあたり、
 * 「※配信再開時はブックマーク一覧でお知らせします」を**約束できる作品にだけ**添える形にした。
 * 判定と理由は components/WatchStar.astro と lib/works.ts の `promisesResume()`。
 *
 * ★ **止めるのはここ（呼び出し側）。** 部品の中で描画だけ止めても、
 *   あちらの `<script>` は678ページに残る（向こうの注意書きのとおり実測した）。
 *   止めるときはフッターの `SHOW_WATCHLIST_LINK` も一緒に false にする。
 */
const SHOW_STAR = true

/*
 * この作品を扱っているシリーズ記事（2026-09-13 追加）。
 *
 * ■ なぜ出すか
 * **シリーズ級の検索語で、作品ページ同士が食い合っている。**
 * 実測（GSC 2026-08-25〜09-12）で「ハリーポッター ネトフリ いつまで」に
 * 作品ページ4枚が9〜10.6位で並び、**表示13・クリック0**。
 * 記事（CTR 10.2%・7.5位）はその検索語に出ていない。
 * 判定の根拠と、canonical/noindex を採らなかった理由は `lib/series-for-work.ts`。
 *
 * ★ **公開されている記事だけ。** 台帳（`data/articles.json`）には
 *   下書きや退役した記事も残りうるので、コレクション側で必ず突き合わせる。
 *   ここを省くと 404 への常設リンクができる。
 */
const seriesRef = seriesRefFor(w.title)
const seriesPost = seriesRef
  ? (await getCollection('posts', ({ id, data }) => id === seriesRef.slug && !data.draft))[0]
  : undefined

// --- 外部リンク ----------------------------------------------------------------

/*
 * 「他のサービスで探す」。**在庫は主張しない。**
 * U-NEXT / Hulu / DMM TV の配信状況データは持っていないので、
 * 渡せるのは検索結果へのリンクだけ（lib/search-links.ts 冒頭）。
 *
 * ★ **Amazon（レンタル・購入）を最後に足す**（2026-09-13）。
 *   それまでこの節は U-NEXT / Hulu / DMM TV の3社だけで、**1本も成果にならなかった**
 *   （U-NEXT・Hulu は未提携、DMM TV は対象外）。記事側の同じ節
 *   （`plugins/rehype-find-links.ts`）と表のチップ（`rehype-availability.ts` の
 *   `findChips`）は 2026-09-12 から Amazon を含んでいるので、**構成をそこに揃える。**
 *   並びは `search-links.ts` の定義順のまま Amazon が最後で、
 *   **紹介料の順に並べ替えない**（docs/AFFILIATE.md 7節）。
 *
 * ★ tag= と rel はここで付ける。常設ページは .astro なので rehype を通らない
 *   （components/WorkTable.astro と同じ理由・同じ関数を使う）。
 *
 * ★ **枠は2つに分かれる。** 上の配信状況の行は `work`、この節は `find`。
 *   作品ページのリンクは読者の意図が最もはっきりしている（その作品を名指しで
 *   見に来ている）ので `work` で数えるが、**この節だけは記事側と同じ意味の導線**
 *   （答えを出せなかったときの逃げ先）なので `find` に入れる。
 *   **HTMLの `data-slot` とトラッキングIDを必ず揃えること。** 片方だけにすると
 *   GA4 のクリック数とアソシエイトのレポートが別の枠を数えることになる。
 */
const WORK_TAG = amazonTagFor('work')
const FIND_TAG = amazonTagFor('find')

const findLinks = [...otherServiceLinks(w.title), amazonVideoLink(w.title)].map((l) => {
  const url = withAmazonTag(l.url, FIND_TAG)
  return { label: l.label, url, rel: relFor(url) }
})

function decorate(url: string) {
  const tagged = withAmazonTag(url, WORK_TAG)
  return { url: tagged, rel: relFor(tagged) }
}

/*
 * 「いま見放題で観られるサービス」（lib/works.ts の stockAnswer）。
 *
 * ★ **状態行とは根拠が違う。** 上の行は変化ログ（いつ終わるか）、こちらは
 *   在庫台帳（いまどこにあるか）。台帳に無い作品では `undefined` が返り、
 *   **節そのものが出ない**（「ほかでは観られません」とは書かない）。
 *   理由の全文は lib/works.ts の該当ブロック。
 *
 * ★ **枠は `stock`。`work` にも `find` にも入れない。**
 *   `work` は状態行のボタン、`find` は答えを出せなかったときの逃げ先で、
 *   ここは**答えそのもの**。在庫を埋めた施策（docs/FUNNEL.md 7-1-4）の効果は
 *   この枠でしか読めない。**HTMLの `data-slot` とトラッキングIDを必ず揃えること。**
 */
const STOCK_TAG = amazonTagFor('stock')
const stock = stockAnswer(w)
const stockLinks = (stock?.services ?? []).map((x) => {
  if (!x.url) return { label: x.label }
  const url = withAmazonTag(x.url, STOCK_TAG)
  return { label: x.label, url, rel: relFor(url) }
})

/*
 * 小さいポスター（2026-09-17・components/WorkCover.astro）。**絵は `w.poster` があれば必ず出し、
 * リンクは Prime Video に在庫があると分かっている作品だけに付ける。**
 * 判定と、Amazon 以外へ送らない理由は lib/works.ts の `coverLink()`。
 *
 * ■ 置き場所（運用者の指定・2026-09-17）。**どの作品ページでも配信状況の行の左に置く**
 *   Prime Video の行があり、リンクになる … **その行の枠の中、バッジの左**。
 *                                          行き先の Prime Video と、その行の「終了予定」などが隣り合う。
 *   それ以外                            … **行の枠の外、左に1枚**（`sideCover`）。**リンクにしない。**
 * ★ **枠の外の絵をリンクにしないこと。** Prime Video の行が無い作品（在庫台帳だけが根拠）でも、
 *   隣に並ぶのは「Netflixで終了予定」などの行で、押して Amazon に着くと行と行き先が食い違う。
 *   Prime Video の在庫は「見放題で配信中」のボタンと「他のサービスで探す」が受け持つ。
 *
 * ★ 枠は `cover`。`work`（状態行）とも `poster`（記事の節ポスター）とも分ける。
 */
const COVER_TAG = amazonTagFor('cover')
const coverTarget = w.poster ? coverLink(w) : undefined
const coverUrl = coverTarget ? withAmazonTag(coverTarget.url, COVER_TAG) : undefined
const cover =
  coverTarget && coverUrl
    ? { url: coverUrl, rel: relFor(coverUrl), name: `「${w.title}」を${coverTarget.label}` }
    : undefined
/*
 * 配信状況の行。**見放題が終わった社が2つ以上あれば1行にまとめてある**（2026-09-22・`statusRows()`）。
 * ★ ポスターを置く行も**まとめたあとの行**で探す。`w.services` の添字で探すと、
 *   まとめて行が減ったぶん、別の社の行にポスターが付く。
 */
const rows = statusRows(w)
const coverRow = cover ? rows.findIndex((r) => r.services.some((s) => s.service === 'prime-video')) : -1
const sideCover = w.poster && coverRow < 0 ? w.poster : undefined

/*
 * 関連する常設ページ。**そのサービスのページが実在するときだけ出す。**
 * カレンダーの無いサービス（Apple TV+ など）へ機械的にリンクを組むと 404 になる。
 * ★ 2026-09-17 から、カレンダーのある社は終了側・新着側の**両方**を持つ（Disney+ にも終了側がある）。
 */
const related = w.services.flatMap((s) => {
  const out: { href: string; label: string }[] = []
  if (hasCalendar(s.service)) {
    out.push({ href: `/leaving/${s.service}`, label: `${s.label}の配信終了カレンダー` })
    out.push({ href: `/arrivals/${s.service}`, label: `${s.label}の新着・配信予定カレンダー` })
  }
  return out
})

// --- 人名（docs/STOCK.md S-3）---------------------------------------------------

/*
 * 監督・出演の名前を人物ページへのリンクにする。
 *
 * ★ **ページのある人だけ**（`personHref` が undefined を返したら文字のまま）。
 *   3作品以上を持つ人にしかページが無い（lib/people.ts の MIN_WORKS）。
 * ★ 区切りは「、」のまま。**「・」で繋がない**（カタカナの人名が中黒を含むため）。
 */
function nameLinks(names: string[]): { name: string; href?: string }[] {
  return names.map((name) => ({ name, href: personHref(name) }))
}

// --- 配信の記録（docs/STOCK.md S-2）-------------------------------------------

/*
 * 観測したできごとを古い順に並べた表。**1行しか無いときは出さない。**
 *
 * 1行だけの履歴は上の「配信状況」と同じことを繰り返すだけで、
 * 節をもう1つ作る意味がない（実測 2026-08-29: 2行以上あるのは1,065作品中87件。
 * **収集を続けるほど増える**ので、この節は月を追うごとに厚くなる）。
 *
 * ★ **観測を始めた日を必ず添える。** それ以前の出入りは1件も持っていない。
 *   添えないと「この日に配信が始まった作品」という、観測していない主張になる
 *   （/stats の「観測できた数であって起きた数ではない」と同じ規律）。
 */
const history = w.history.length >= 2 ? w.history : []
const observedSince = history.length > 0 ? observationStart() : null

// --- 関連する作品（docs/WORK-PAGES.md 6節）------------------------------------

/*
 * 作品ページ同士を繋ぐ唯一の場所。**枠と上限は lib/works.ts が決める。**
 * ここで件数を足したり、別の条件で拾い直したりしないこと。
 */
const relatedGroups = relatedWorks(w)

/**
 * 出演者を何人まで開いたまま出すか。**4人までは全部出す**
 * （1人だけたたんでも読者の得が無い）。5人以上は3人＋たたみ。
 */
const castShown = w.cast.length > 4 ? 3 : w.cast.length

/*
 * この作品を載せた記事（あれば）。
 *
 * ★ **記事→作品の一方通行にしない**（2026-09-10）。記事の表からは
 *   plugins/rehype-work-links.ts がここへリンクを張るが、戻る道が無いと
 *   読者はまとめへ帰れず、クローラにも記事へ返る線が1本も無い。
 *   判定は lib/works.ts の `seriesArticleFor()`（記事の表に載っているか）。
 *
 * ★ **月次記事も落とし先にする**（2026-09-14）。それまでシリーズ記事だけを
 *   見ていたので、**658枚中91枚にしか戻る道が無かった**。表に載っている
 *   作品ページは250枚あり、**159枚が「記事に載っているのに戻れない」**状態だった
 *   （実測。作品ページからの回遊は90日で0件）。文言は `kind` で書き分ける。
 *
 * ★ **上の `series-ref` と同じ記事なら出さない。** 同じリンクが1ページに
 *   2本並ぶだけで、読者には次の一手が増えたように見えない。
 */
const seriesArticle = seriesArticleFor(w.id)
const backLink = seriesArticle?.slug === seriesPost?.id ? undefined : seriesArticle

/*
 * **どちらにも当たらなかったときの落とし先**（2026-09-16 追加）。
 *
 * ■ なぜ足したか
 * 上の2つ（シリーズ記事 ／ その作品を載せた記事）に当たるのは
 * **673枚中262枚だけ**で、**411枚には記事への出口が1本も無かった。**
 * 実測で流入の多い作品ページ（`/works/14281` = リコリス・リコイル・表示81）も
 * そちら側で、その作品を扱った記事がまだ無い。
 *
 * ここが返すのは「同じ月に、同じサービスで、同じことが起きた作品のまとめ」。
 * **その作品が載っているとは限らない**ので、下の `nextArticle` で文言を分けてある。
 * 判定と言い回しは `lib/work-hub-article.ts`。
 *
 * ★ 上の2つが当たっているときは**引かない**。1ページに1つだけ（下の★）。
 */
const hubArticle =
  seriesPost || backLink
    ? undefined
    : hubArticleFor(w, await getCollection('posts'), [seriesRef?.slug, seriesArticle?.slug])

/*
 * この作品の「次の1本」。**1ページに1つだけ、配信状況のすぐ下に置く**（2026-09-14）。
 *
 * ■ なぜ位置を変えたか（実測 2026-09-14・90日）
 * セッションの**71%がスマホ**だが、左レールも右レールも 1200px 以上でしか出ない。
 * スマホの本文に出る内部リンクは、**上から順に**
 * シリーズ枠（91枚だけ）→ 出演者 → Amazon の枠 → 関連作品 だった。
 * つまり**記事への戻り道を持つ162枚では、それが Amazon の枠より下**にあった。
 * `/works/*` からの回遊は90日で**0件**。
 *
 * ★ **シリーズ記事が先、月次記事は落とし先**（`seriesArticleFor()` と同じ順）。
 * ★ **1ページに1つだけ。** 同じ記事が2か所に出ると、読者には
 *   次の一手が増えたようには見えず、リンクが重複しているようにしか見えない。
 *
 * ■ 3段目（2026-09-16）— **その作品を載せていない記事**
 * 上の2つに当たらない411枚のための落とし先（`hubArticle`）。
 * 🔴 **文言を上の2つと共有しないこと。** あちらは「この作品を載せた記事」と
 *   約束しているが、こちらは載っているとは限らない。
 *   名乗るのは「同じ月に同じサービスで起きたことのまとめ」までで、
 *   その言い回しは `lib/work-hub-article.ts` の `labelFor()` が持つ
 *   （作品ページ側で書き換えない。書き換えると約束と中身がずれる）。
 */
const nextArticle = seriesPost
  ? {
      href: `/posts/${seriesPost.id}`,
      title: seriesPost.data.title,
      label: 'このシリーズをまとめた記事はコチラ',
      image: seriesPost.data.heroImage,
      category: seriesPost.data.category,
    }
  : backLink
    ? {
        href: `/posts/${backLink.slug}`,
        title: backLink.title,
        label:
          backLink.kind === 'series'
            ? 'このシリーズをまとめた記事はコチラ'
            : 'この作品を載せた記事はコチラ',
        image: backLink.heroImage,
        category: backLink.category,
      }
    : hubArticle
      ? {
          href: `/posts/${hubArticle.slug}`,
          title: hubArticle.title,
          label: hubArticle.label,
          image: hubArticle.heroImage,
          category: hubArticle.category,
        }
      : undefined

/*
 * U-NEXT（afb）の掲載NG判定に渡す文字列。
 *
 * **このページに名前が出る作品を全部渡す。** 本作だけでなく関連作品も渡すのは、
 * 掲載NGの作品名がページのどこかに出ていたら「扱っている」と読まれうるため
 * （ガイドライン「掲載NG権利元、作品について」）。取りこぼすより広く止める。
 */
const adPageText = [
  w.title,
  w.originalTitle ?? '',
  ...relatedGroups.flatMap((g) => g.items.map((i) => i.title)),
].join('\n')

// --- 構造化データ --------------------------------------------------------------

/*
 * Movie / TVSeries。
 *
 * ★ **`offers` も `WatchAction` も出さない。**
 *   価格も「いま観られるか」も観測していない。
 *   画面で断定しないものを構造化データでだけ断定してはいけない。
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': w.type === 'series' ? 'TVSeries' : 'Movie',
  name: w.title,
  ...(w.originalTitle ? { alternateName: w.originalTitle } : {}),
  ...(w.year ? { datePublished: String(w.year) } : {}),
  ...(w.poster ? { image: new URL(w.poster, Astro.site ?? SITE.url).href } : {}),
  ...(w.genres.length > 0 ? { genre: w.genres } : {}),
  ...(w.directors.length > 0
    ? { director: w.directors.map((n) => ({ '@type': 'Person', name: n })) }
    : {}),
  ...(w.cast.length > 0 ? { actor: w.cast.map((n) => ({ '@type': 'Person', name: n })) } : {}),
  /*
   * ★ `description` を出さない。配信APIのあらすじは**全件が英語**で、
   *   画面に出していないものを構造化データにだけ入れることになる。
   * ★ `inLanguage` も出さない。持っているのは日本語に訳した言語名で、
   *   この項目が想定する言語コードではない。**確かでない値を入れない。**
   */
}
---

{/* adQuery は下の <AmazonCta query={w.title}> と同じ値。画面下の追従枠が使う */}
{/* noindex は検索の実績が無い終了済みだけ（lib/works.ts の workIndexable・2026-09-26） */}
<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  adQuery={w.title}
  noindex={!workIndexable(w)}
>
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a> ›
    <a href={`/category/${hub.slug}`}>{hub.label}</a>
  </nav>

  <h1>{title}</h1>

  <AffiliateNotice />

  {/*
    読者は「いつまで観られるか」を知りに来ている。答えを先に出す。
    ★ 小さいポスターは行の左（上の `coverRow` / `sideCover` の注記）。
      作品の情報の大きいポスターはそのまま残す（同じ画像なので読み込みは1回）。
  */}
  <section class:list={['status', { 'with-side-cover': sideCover }]} aria-label="配信状況">
    {sideCover && <WorkCover src={sideCover} />}
    <div class="status-rows">
    <ul class="states">
      {
        rows.map((row, i) => {
          // まとめた行（2社以上が終了済み）では、代表の社（いちばん遅く終わった社）でバッジとボタンを決める
          const s = row.head
          /*
           * ★ 終了予定日を過ぎた（`passed`）行だけ、在庫台帳で確かめた結果を使う（2026-09-17）。
           *   バッジは確かめた結果で言い分け、状態行の文はそのまま残して、
           *   **確かめた結果は別の文で、台帳の日付を付けて**続ける
           *   （lib/works.ts の `passedCheck` の注記。根拠の違う文を混ぜない）。
           */
          const check = passedCheck(w, s)
          const badge = stateBadge(w, s)
          const go = decorate(serviceUrl(w, s, check))
          const body = (
            <>
              <span class="badge" data-category={badge.category}>
                {badge.label}
              </span>
              {/*
                ★ まとめた行は「NetflixとDisney+では2026年9月4日までに…」（運用者の指定の言い方）。
                  3社以上は「A、BとC」。1社の行は従来どおり「Netflixで…」。
              */}
              <span class="line">
                {row.services.map((x, j) => (
                  <>
                    {j > 0 && (j === row.services.length - 1 ? 'と' : '、')}
                    <strong>{x.label}</strong>
                  </>
                ))}
                {row.services.length > 1 ? 'では' : 'で'}
                <time datetime={isoDate(s.at)}>{statusSentence(row)}</time>
                {s.state === 'passed' && <span class="check">{passedNote(check)}</span>}
              </span>
              {/*
                ★ 文言は**リンク先**から決める（works.ts の serviceCtaLabel）。
                  見放題が終わった作品は Amazon の検索に落ちるので、
                  状態から「{s.label}で見る」と組むと**Netflix と書いてある広告リンクが
                  Amazon に飛ぶ**。2026-09-06 の実測で 517枚中248枚がその状態だった。
              */}
              <a class="go" href={go.url} rel={go.rel} target="_blank" data-slot="work">
                {serviceCtaLabel(s, go.url, check)}
              </a>
            </>
          )
          /*
           * ★ リンクになるポスターは Prime Video の行の左に置く（上の `coverRow`）。
           *   バッジ・文・ボタンは右の列にまとめ、**行の中の並び方は他の行と同じ**にする
           *   （スマホでは右の列の中で折り返す）。
           */
          return i === coverRow && w.poster ? (
            <li class="with-cover">
              <WorkCover src={w.poster} link={cover} />
              <div class="row-body">{body}</div>
            </li>
          ) : (
            <li>{body}</li>
          )
        })
      }
    </ul>

    {
      /*
       * ★ **読者がいちばん知りたい1行。** 上の行は「終わる／終わった」で、
       *   その次に来る問いは必ず「**では、どこで観るのか**」（docs/GROWTH.md 3-1）。
       *   在庫台帳を持っている作品でだけ、その答えをここで返す。
       * ★ **リンクにならない社がある。** `availabilityUrl()` は印と行き先が
       *   食い違わない先しか返さない（Prime Video 以外は台帳の直リンクだけ）。
       *   URLが無ければ**文字のまま**出す。Amazon へ振り替えないこと。
       */
      /*
       * ★ **サービスはボタンの形で並べる**（2026-09-17・運用者の指定）。
       *   文字リンクを「・」で繋いでいた頃は、上の行の塗りのボタンと比べて
       *   押せるものに見えなかった。塗りにはせず輪郭だけにして、上の行のボタンより一段弱くする。
       * ★ **ロゴは使わない。** サービス名は文字のまま（docs/APPEARANCE.md の商標の注意）。
       * ★ 日付の一文は置かない。下の注意書きが古いほうの日付を名乗る（works.ts の `noticeAsOf()`）。
       */
      stock && (
        <div class="stock">
          <span class="badge" data-category="arrivals">
            {STOCK_HEADING}
          </span>
          <ul class="stock-services">
            {stockLinks.map((x) => (
              <li>
                {x.url ? (
                  <a class="stock-service" href={x.url} rel={x.rel} target="_blank" data-slot="stock">
                    {x.label}
                    <svg class="ext" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                      <path d="M4.5 2.5h5v5M9.5 2.5 3 9" />
                    </svg>
                  </a>
                ) : (
                  <span class="stock-service is-plain">{x.label}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    </div>
  </section>

  {/*
    ★ **答えのすぐ下、注意書きより上。** 読者は「いつ消えるか」を読み終えた
      直後にだけ「覚えておきたい」と思う。詳細まで下げると届かない。
      なぜこの機能があるかは components/WatchStar.astro と docs/FUNNEL.md 9-4。
    ★ 2026-09-21 に一度止め、**2026-09-22 から全作品に戻した**（上の `SHOW_STAR`）。
  */}
  {SHOW_STAR && <WatchStar work={w} />}

  {/* 配信状況は変わる。いつ時点のデータかを必ず出す。 */}
  <p class="notice">
    配信情報は<strong>{formatDate(noticeAsOf(w, stock))}時点</strong>のものです。
    その後の配信状況は各サービスの都合で変わることがあります。ご視聴前に公式サイトでご確認ください。
  </p>

  {
    /*
     * ★ **この作品の答えより下、作品の詳細より上。** 読者はまずこの1作の
     *   配信状況を知りに来ているので、そこを先に返す。そのうえで
     *   「シリーズ全体を知りたかった人」を記事へ送る。
     * ★ リンクの文字は**記事のタイトルそのもの。** 「こちら」にしない —
     *   押す前に何が待っているか分かる形にするのと、
     *   内部リンクの文字はそのまま記事の主題の手がかりになるため。
     */
    nextArticle && (
      <aside class="series-ref">
        {/*
          ★ **記事カードと同じ絵**（`PostCard.astro` と同じ `Thumb`・同じ 72px）。
            一覧で見た絵と同じものがここにも出ることで、読者は
            「さっき見た記事」なのか「まだ見ていない記事」なのかを絵で判別できる。
          ★ 画像が無い記事でも **Thumb がカテゴリ色のタイルを出す**ので、
            枠の高さが揃う（画像あり/なしで並びが乱れない）。
        */}
        <Thumb src={nextArticle.image} category={nextArticle.category} size={72} radius={8} />
        <div class="series-ref-body">
          <p class="series-ref-label">{nextArticle.label}</p>
          <a href={nextArticle.href}>{nextArticle.title}</a>
        </div>
      </aside>
    )
  }

  {/*
    afb（U-NEXT / Hulu）への導線。**状態行のすぐ下に置く**（2026-09-14 に移動）。

    ■ なぜここなのか — **踏まれている枠の隣だから**
    枠別のクリック実測（`data-slot`・2026-09-11 まで）はこうだった。

        work（状態行のボタン）        4回  ← サイト最多
        table（表の作品名）           3回
        bar（下の追従枠）             2回
        poster（節ポスター）          1回
        **find（他のサービスで探す）  0回**
        **cta（記事末尾）             0回**

    それまでこの枠は「他のサービスで探す」の直後に置いていた。根拠は
    「find はサイト2番目に踏まれている導線」（docs/FUNNEL.md 7-4）だったが、
    **あれは行き先ホストからの推測で、枠別の実測はそれを否定した。**

    そして状態行のボタン（`work` 枠）は**705本中591本が Amazon の検索**で、
    紹介料は数十円（docs/AFFILIATE.md 3-0-1）。afb は 917〜1,430円。
    **同じクリック数なら桁が2つ違う。** だから最多クリックの隣に置く。

    ★ **状態行そのものは動かさない。** 読者が来た目的の答えで、
      広告より先に返すもの（上の .status の注意書き）。
    ★ **記事への導線（series-ref）より下。** あれは 2026-09-14 に
      「作品ページからの回遊が90日で0件」を直すために入れたばかりで、
      広告で押し下げると効果が測れなくなる。
    ★ 掲載NGの作品が本作にも関連作品にも無いときだけ出る。
    ★ **枠は1ページに1つで、中身が入れ替わる**（AfbCta.astro）。
      U-NEXT が出せない面には Hulu が落ちる。2社は掲載NGの範囲が
      噛み合っていない（日テレ作品は U-NEXT ✕ / Hulu ○、
      ディズニー・Disney+ は U-NEXT ○ / Hulu ✕）ので、枠を増やさずに空白が埋まる。
      `services` は Hulu 側が Disney+ のページを避けるために要る。
  */}
  {/*
    ★ `fallback` を渡してある（2026-09-19・運用者の指定）。afb が2社とも出せない面
      （ディズニー作品・TBS作品を含むページ）は、これまで**枠ごと空白**だった。
      そこに Amazon Prime Video のバナーを出す。**afb が出る面には出ない**ので枠は増えない。
  */}
  <AfbCta spot="work" pageText={adPageText} services={w.services.map((s) => s.service)} fallback />

  {
    /*
     * 「見放題の終了が近い作品」の棚（2026-09-16 追加・docs/DEMAND.md 6節の出口A）。
     *
     * ■ **記事への出口が「ゆるい当たり」のページにだけ出す**
     * 出すのは次の2つのとき。**673枚中412枚**（2026-09-16 実測）。
     *
     *   1. `hubArticle` に落ちた … その作品を載せていない記事しか出せていない
     *   2. `nextArticle` が無い  … 記事が1本も引けなかった（Apple TV+ だけの作品など）
     *
     * ★ **その作品を載せた記事・シリーズ記事が引けている261枚には出さない。**
     *   あちらは「この作品の話が続いている記事」という強い約束が成立していて、
     *   そこに別の棚を足すと次の一手が2つになる（上の `nextArticle` の★）。
     *   **弱い出口しか出せていないページでだけ、2本目を出す。**
     *
     * ■ なぜ `AfbCta` の**下**なのか
     * あちらの位置は枠別のクリック実測で決めてある（上の注意書き）。
     * **測って決めた収益枠を、まだ測っていない枠のために押し下げない。**
     * 効いていることが分かったら、そのとき順番を検討する。
     *
     * ★ 関連作品の枠（下の `related`）とは軸が違う。あちらは
     *   「同じ監督・同じジャンル・同じ日」で、こちらは**サービスを横断した終了日順**。
     * ★ 自分自身は棚から外す（`excludeId`）。
     */
    (hubArticle || !nextArticle) && <DemandShelf excludeId={w.id} />
  }

  <section class="detail">
    <h2>作品の情報</h2>
    <div class="detail-body">
      {
        w.poster && (
          <img
            class="poster"
            src={w.poster}
            alt=""
            width="240"
            height="360"
            loading="lazy"
            decoding="async"
          />
        )
      }
      <dl>
        {w.originalTitle && (<><dt>原題</dt><dd>{w.originalTitle}</dd></>)}
        {w.year && (<><dt>製作年</dt><dd>{w.year}年</dd></>)}
        <dt>種別</dt>
        <dd>{w.type === 'series' ? 'シリーズ' : '映画'}</dd>
        {w.genres.length > 0 && (<><dt>ジャンル</dt><dd>{w.genres.join('・')}</dd></>)}
        {/* ★ 「製作国」ではなく「原語」。origins.json は Wikidata の P364。 */}
        {w.languages.length > 0 && (<><dt>原語</dt><dd>{w.languages.join('・')}</dd></>)}
        {/*
          ★ 人名は「、」で区切る。**「・」で繋がない。**
            カタカナの人名は「ヒラリー・ダフ」のように中黒を含むので、
            中黒で連結すると区切りが消える
            （「ヒラリー・ダフ・イアン・マクシェーン」＝1人に見える）。
        */}
        {w.directors.length > 0 && (
          <>
            <dt>監督</dt>
            <dd>
              {nameLinks(w.directors).map((n, i) => (
                <>
                  {i > 0 && '、'}
                  {n.href ? <a href={n.href}>{n.name}</a> : n.name}
                </>
              ))}
            </dd>
          </>
        )}
        {/*
          ★ 「主演」と書かない。Wikidata の並びは主演順ではない。

          ★ **5人以上は3人でたたむ**（2026-09-14）。実測で**315枚が10人ちょうど**
            （上限）で、スマホでは名前の列が数行を占めていた。読者が次に押すもの
            （上のシリーズ枠・下の関連作品）の間に、長い名前の列が挟まっている。
            `/person` は229枚あって**90日で8表示・0クリック**で、
            読者がここから辿っている形跡は無い。

          ★ **名前を消さない。`<details>` でたたむだけ。** 中身はHTMLに残るので
            `/person` への820本のリンクは1本も減らない（孤立させない）。
            JSも足さない（素のHTMLで開閉する）。
        */}
        {w.cast.length > 0 && (
          <>
            <dt>出演</dt>
            <dd>
              {nameLinks(w.cast.slice(0, castShown)).map((n, i) => (
                <>
                  {i > 0 && '、'}
                  {n.href ? <a href={n.href}>{n.name}</a> : n.name}
                </>
              ))}
              {w.cast.length > castShown && (
                <details class="more-cast">
                  <summary>ほか{w.cast.length - castShown}人</summary>
                  {nameLinks(w.cast.slice(castShown)).map((n, i) => (
                    <>
                      {i > 0 && '、'}
                      {n.href ? <a href={n.href}>{n.name}</a> : n.name}
                    </>
                  ))}
                </details>
              )}
            </dd>
          </>
        )}
        {w.rating && (<><dt>評価</dt><dd>{w.rating}/100</dd></>)}
      </dl>
    </div>
    {/*
      ★ あらすじは出さない。配信APIの overview は**実測780件すべてが英語**で、
        日本語のページに英文を貼ることになる。日本語のあらすじを持てるように
        なったら、ここに足す（lib/works.ts の掲載判定も一緒に見直すこと）。
    */}
  </section>

  {
    history.length > 0 && (
      <section class="history">
        <h2>配信の記録</h2>
        <p class="history-note">
          当サイトが観測している範囲で、この作品の見放題配信に起きた変化です。
          {observedSince && (
            <>
              記録は<strong>{formatDate(observedSince)}</strong>から始まっており、
              それ以前の配信開始・終了は含みません。
            </>
          )}
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">日付</th>
                <th scope="col">サービス</th>
                <th scope="col">できごと</th>
                <th scope="col">判明した日</th>
              </tr>
            </thead>
            <tbody>
              {history.map((h) => (
                <tr>
                  <td>
                    <time datetime={isoDate(h.at)}>{formatDate(h.at)}</time>
                  </td>
                  <td>{h.label}</td>
                  <td>{HISTORY_LABEL[h.kind]}</td>
                  <td class="found">{formatDate(h.foundAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {/* 止めるのは config.ts の WORK_FIND_ENABLED（2026-09-26 から false） */}
  {WORK_FIND_ENABLED && (
    <section class="find">
      <h2>他のサービスで探す</h2>
      {/*
        ★ **名乗るのは、この節に実際にリンクがあるサービスだけ**（2026-09-14・運用者の指定）。
          リンクの並びから組むので、`search-links.ts` を足し引きしても文が自動で合う。
          **手で社名を書かないこと** — 書いた社名とリンクがずれるのがいちばん悪い。

        ★ **U-NEXT の一文は残す。** リンクはこの節にあるが、
          **配信状況のデータを持っているのは記事だけ**（作品ページの表には入らない）。
          読者が「この作品ページにU-NEXTの状況が出ていない」ことに気づくのはここ。
      */}
      <p class="find-note">
        {findLinks.map((l) => l.label).join('・')}
        の配信状況をリンクから検索できます。U-NEXTは記事でのみ扱っております。
      </p>
      <p class="find-links">
        {
          /*
            ★ 枠名は `find`。**ここは実測でサイト2番目に踏まれている導線。**
              90日の外部クリック8件のうち2件（25%）が U-NEXT の検索リンクだった
              （docs/FUNNEL.md 7-4）。成果にはならないが、
              **どの作品でU-NEXTへ向かう意図が出ているか**の唯一の信号なので、
              必ず枠として数えること。
          */
          findLinks.map((l) => (
            <a href={l.url} rel={l.rel} target="_blank" data-slot="find">
              {l.label}で探す
            </a>
          ))
        }
      </p>
    </section>
  )}

  <AmazonCta category={STATE_CATEGORY[w.state]} query={w.title} />

  {
    relatedGroups.length > 0 && (
      <section class="related-works">
        <h2>関連する作品</h2>
        {relatedGroups.map((g) => (
          <div class="group">
            <h3>{g.heading}</h3>
            <ul>
              {g.items.map((i) => (
                <li>
                  {/* ★ 内部リンク。rel も target も付けない（自サイトへの sponsored は誤り） */}
                  <a href={`/works/${i.id}`}>{i.title}</a>
                  {i.note && <span class="note">{i.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }

  {
    related.length > 0 && (
      <p class="related">
        関連する一覧:
        {related.map((r) => (
          <a href={r.href}>{r.label}</a>
        ))}
      </p>
    )
  }

  <section class="sources">
    <h2>出典</h2>
    <ul>
      <li>
        <a href={ATTRIBUTION.url} rel="noopener noreferrer" target="_blank">
          {ATTRIBUTION.text}
        </a>
      </li>
      <li>
        <a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank">
          作品タイトル・監督・出演・原語（Wikidata・CC0）
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }


  /*
   * --- シリーズ記事への導線 ---
   *
   * ★ **広告の枠（.status の `.go` や AmazonCta）と見た目を分ける。**
   *   これはサイト内の記事へのリンクで、PR ではない。同じ塗りのボタンにすると
   *   読者には広告に見え、押されないうえに枠が1つ増えたようにしか映らない。
   *   左の縦線だけで「補足」だと分かる形にしてある。
   */
  .series-ref {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin: 1.2rem 0 0;
    padding: 0.7rem 0.9rem 0.7rem 0.9rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .series-ref-body {
    min-width: 0;
  }
  .series-ref-label {
    margin: 0 0 0.25rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .series-ref a {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.6;
  }

  /* 出演者のたたみ。**開閉の印だけを出し、枠で囲わない**（詳細の1行なので） */
  .more-cast {
    display: inline;
  }
  .more-cast summary {
    display: inline;
    margin-left: 0.4rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    cursor: pointer;
  }
  .more-cast[open] summary {
    margin-right: 0.4rem;
  }

  /* --- 配信状況 --- */
  .status {
    margin: 1.6rem 0 1rem;
  }
