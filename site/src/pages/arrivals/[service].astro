---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import WorkTable from '../../components/WorkTable.astro'
import WorkSearch from '../../components/WorkSearch.astro'
import LeadImage from '../../components/LeadImage.astro'
import { ATTRIBUTION, CATEGORIES, EVERGREEN_BADGE, SITE } from '../../config'
import { formatDate } from '../../utils/date'
import { serviceImage } from '../../lib/images'
import { evergreenTitle } from '../../lib/evergreen'
import {
  ARRIVALS_SERVICES,
  ARRIVALS_WINDOW_DAYS,
  LEAVING_SERVICES,
  groupByDate,
  loadArrivals,
} from '../../lib/events-data'

/**
 * 常設ページ「◯◯で最近見放題になった作品」。
 *
 * 配信終了予定ページ（/leaving/…）と対になる。
 * 違いは1つだけ。
 *   - 「新着」と呼べる期間に限る（ARRIVALS_WINDOW_DAYS）
 *
 * ★ 並びは**配信開始日の古い順**（2026-08-27 に新しい順から変更）。
 *   終了予定ページと同じく、上から下へ時間が進む向きにそろえてある。
 *   並べ替えは lib/events-data.ts の `loadArrivals()`。ここでは並べ替えない。
 *   **説明文（下の description と .summary）も必ず並びと同じ言葉にすること。**
 *
 * ★ Apple TV+ のページは作っていない。収集期間を通して `new` が1件しか
 *   無かったため（events-data.ts の ARRIVALS_SERVICES を参照）。
 */
export function getStaticPaths() {
  return ARRIVALS_SERVICES.map((s) => ({
    params: { service: s.key },
    props: { label: s.label },
  }))
}

const { service } = Astro.params
const { label } = Astro.props

const { works, dataAsOf } = loadArrivals(service!)
const groups = groupByDate(works)
const lead = serviceImage(service!)

/*
 * タイトルの頭に基準日を出す（`【2026年8月25日時点】…`）。
 * 常設ページは公開日を持たず中身だけが入れ替わるので、
 * **いつ時点の一覧なのかをタイトルで先に伝える**（2026-08-25）。
 * 組み立ては lib/evergreen.ts の1か所に寄せてある。ここで文字列を作らないこと。
 */
const title = evergreenTitle(`${label}で見放題になった作品一覧`, dataAsOf)
const description =
  works.length > 0
    ? `${label}で直近${ARRIVALS_WINDOW_DAYS}日間に見放題配信が始まった作品${works.length}本を、配信開始日の古い順にまとめています。`
    : `${label}で最近見放題配信が始まった作品をまとめています。現在、直近${ARRIVALS_WINDOW_DAYS}日間に取得できた作品はありません。`
---

<BaseLayout title={title} description={description}>
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a> ›
    <a href="/category/arrivals">新着配信</a>
  </nav>

  {/* 見出しの直上。src/assets/services/<キー>.png を置くと出る */}
  <LeadImage image={lead} alt="" />

  <h1>{title}</h1>

  {/*
    ★ 記事ページ（pages/posts/[...slug].astro）の `.meta` と同じ位置・同じ形。
      **違いはバッジだけ**にしてある。記事は「公開 ◯月◯日」が並び、
      ここは「随時更新」が並ぶ。並べて比べれば種類の違いが一目で分かる。
      説明の1行は**外から直接来た読者**のためのもの（config.ts の EVERGREEN_BADGE）。
      ★ 終了予定の常設ページ（pages/leaving/[service].astro）と同じ形にすること。
  */}
  <div class="meta">
    <span class="badge" data-category={CATEGORIES.arrivals.slug}>{CATEGORIES.arrivals.label}</span>
    <span class="badge evergreen">{EVERGREEN_BADGE.label}</span>
  </div>

  <p class="kind-note">{EVERGREEN_BADGE.note}</p>

  <AffiliateNotice />

  <p class="notice">
    {
      dataAsOf ? (
        <>
          配信情報は <strong>{formatDate(dataAsOf)}時点</strong>のものです。
        </>
      ) : (
        <>配信情報の取得時刻が不明です。</>
      )
    }
    {label}の都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
  </p>

  {
    works.length === 0 ? (
      <p class="empty">
        直近{ARRIVALS_WINDOW_DAYS}日間に、{label}で見放題配信が始まった作品は取得できていません。
      </p>
    ) : (
      <>
        {/*
          冒頭文の右の空きに作品検索を置く。
          入力すると該当作品の行まで自動でスクロールする（絞り込みはしない）。
          レイアウトは styles/global.css の .list-head。
        */}
        <div class="list-head">
          <p class="summary">
            直近{ARRIVALS_WINDOW_DAYS}日間で<strong>{works.length}本</strong>
            が見放題に追加されました。配信開始日の古い順に並べています。
          </p>
          <WorkSearch label="新着の作品を探す" />
        </div>
        {/*
          ★ 「いま観られる」と断定しない。
            new は「配信が始まった」という過去の記録で、その後に終了している
            可能性がある。ページ下部の注記と合わせて誤読を防ぐ。
        */}
        <WorkTable groups={groups} dateNoun="追加" service={service!} />
      </>
    )
  }

  <AmazonCta category="arrivals" />

  <section class="sources">
    <h2>出典</h2>
    <ul>
      <li>
        <a href={ATTRIBUTION.url} rel="noopener noreferrer" target="_blank">
          {ATTRIBUTION.text}
        </a>
      </li>
      <li>
        <a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank">
          作品タイトル（Wikidata・CC0）
        </a>
      </li>
    </ul>
  </section>

  <p class="related">
    ほかの常設ページ:
    {
      ARRIVALS_SERVICES.filter((s) => s.key !== service).map((s) => (
        <a href={`/arrivals/${s.key}`}>{s.label}の新着</a>
      ))
    }
    {
      LEAVING_SERVICES.some((s) => s.key === service) && (
        <a href={`/leaving/${service}`}>{label}の終了予定</a>
      )
    }
    <a href="/stats">見放題の増減</a>
  </p>

  <p class="site-note">
    掲載しているのは<strong>配信が始まった記録</strong>です。
    その後に配信が終了している場合があります。
    このページの配信記録は Netflix・Amazon Prime Video・Disney+・Apple TV+ の4サービスぶんです
    （{SITE.name}が追いかけている U-NEXT は記事でのみ扱っており、このページには入っていません）。
    「他で探す」のリンクは各サービスの検索結果に飛ぶだけです。
  </p>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  /* 記事ページの .meta と同じ値。**ずらさないこと**（並べて比べる前提の形なので） */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  /* バッジの意味を1行で補う。すぐ下の広告表記と続けて読める大きさにする */
  .kind-note {
    margin: 0.7rem 0 0;
    font-size: 0.84rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
  /* 冒頭文の位置は .list-head 側で決めている（styles/global.css） */
  .empty {
    margin: 1.5rem 0;
    color: var(--text-muted);
  }
  .sources h2 {
    font-size: 1rem;
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
  .related a {
    margin-left: 0.7rem;
  }
  .site-note {
    margin-top: 2rem;
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
</style>
