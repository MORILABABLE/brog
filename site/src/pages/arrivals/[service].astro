---
import { getCollection } from 'astro:content'
import ServiceCalendarPage from '../../components/ServiceCalendarPage.astro'
import { CALENDAR_SERVICES } from '../../lib/events-data'

/**
 * 配信カレンダー（新着側）「◯◯の見放題 新着・配信予定の作品一覧・カレンダー」。
 *
 * 中身は components/ServiceCalendarPage.astro（`/leaving/<サービス>` と共有）。
 * **ここで持つのは作るページの一覧だけ。**
 *
 * ★ 2026-09-17 から**配信開始予定**（各社の告知から取り込んだもの・docs/ANNOUNCEMENTS.md）も並ぶ。
 *   それまでは新着（配信が始まった記録）だけだった。
 * ★ Apple TV+ のページは作っていない。収集期間を通して `new` が1件しか
 *   無かったため（events-data.ts の ARRIVALS_SERVICES を参照）。
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return CALENDAR_SERVICES.map((s) => ({
    params: { service: s.key },
    props: { label: s.label, posts },
  }))
}

const { service } = Astro.params
const { label, posts } = Astro.props
---

<ServiceCalendarPage direction="arrivals" service={service!} label={label} posts={posts} />
