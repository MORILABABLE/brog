---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import EvergreenCard from '../../components/EvergreenCard.astro'
import { CATEGORIES, SITE } from '../../config'
import { evergreenFor, evergreenSummary } from '../../lib/evergreen'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)

  return Object.values(CATEGORIES).map((cat) => ({
    params: { category: cat.slug },
    props: {
      cat,
      posts: posts
        .filter((p) => p.data.category === cat.slug)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

const { cat, posts } = Astro.props

/*
 * 常設ページを記事カードと同じ体裁で先頭に出す。
 * 「常に最新の◯◯を見る」という箱にまとめていたのをやめた（2026-08-23）。
 * サービスごとの見分けがつかず、周囲の記事カードから浮いていたため。
 *
 * 件数と基準日はここで読む。ビルド時にしか動かないので費用はかからない。
 */
const evergreen = evergreenFor(cat.slug).map((page) => ({
  page,
  ...evergreenSummary(page),
}))
---

<BaseLayout
  title={`${cat.label}の記事一覧`}
  description={`${SITE.name}の「${cat.label}」カテゴリの記事一覧です。`}
>
  <h1>{cat.label}</h1>

  {
    evergreen.map((e) => (
      <EvergreenCard page={e.page} count={e.count} dataAsOf={e.dataAsOf} />
    ))
  }

  {
    posts.length === 0 ? (
      <p class="muted">このカテゴリの記事はまだありません。</p>
    ) : (
      posts.map((post) => <PostCard post={post} />)
    )
  }
</BaseLayout>

