---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { CATEGORY_HUBS, SERVICE_HUBS, SITE } from '../../config'

/**
 * ★ 生成するのは**ハブ1つにつき1ページ**（カテゴリ1つにつき1ページではない）。
 *   「配信終了予定」と「終了済み」は同じページに並べる。理由は config.ts の
 *   CATEGORY_HUBS を参照。**`/category/ended` は生成されない**ので、
 *   `public/_redirects` で `/category/leaving` へ転送してある。
 *
 * ★ **常設ページのカード（EvergreenCard）はここに出さない**（2026-08-27）。
 *   ここは「そのハブの記事の一覧」に徹する。
 *   常設ページは中身が `collect` のたびに入れ替わる別の性質のものなので、
 *   サービスを選んだ次のページ（/category/<ハブ>/<サービス>）と
 *   左の枠（LeftRail.astro）だけに置いてある。
 *   一覧の先頭に戻すと、記事を探しに来た読者が毎回それを読み飛ばすことになる。
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)

  return CATEGORY_HUBS.map((hub) => ({
    params: { category: hub.slug },
    props: {
      hub,
      posts: posts
        .filter((p) => (hub.includes as readonly string[]).includes(p.data.category))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

const { hub, posts } = Astro.props

/**
 * 記事が0本のハブは**索引から外す**（2026-08-31）。
 *
 * 器だけ先に作ったハブ（いまはランキング）は「記事はまだありません」しか出せない。
 * ページ自体は残す（メニューから外しても、どこかに古いリンクが残りうる）が、
 * 中身の無いページを検索結果に出すのは読者にもサイトの評価にも損になる。
 * lib/service-pages.ts の `serviceHasContent()` と同じ考え方。
 *
 * ★ 記事が1本入れば自動で索引対象に戻る。ヘッダーのメニューも同時に戻る
 *   （components/Header.astro の `hubs`）。
 */
const empty = posts.length === 0
---

<BaseLayout
  title={`${hub.heading}の記事一覧`}
  description={`${SITE.name}の${hub.description}`}
  noindex={empty}
>
  <h1>{hub.heading}</h1>

  {
    /*
     * サービスで絞り込む導線。ヘッダーのメニューと同じ行き先だが、
     * **メニューを開き直さずに絞り込める**ようにここにも置く。
     * 出すのは `serviceMenu: true` のハブだけ（ランキングには出ない）。
     */
    hub.serviceMenu && (
      <nav class="services" aria-label="サービスで絞り込む">
        {SERVICE_HUBS.map((s) => (
          <a class="service" href={`/category/${hub.slug}/${s.slug}`}>
            {s.label}
          </a>
        ))}
      </nav>
    )
  }

  {
    posts.length === 0 ? (
      <p class="muted">この分類の記事はまだありません。</p>
    ) : (
      posts.map((post) => <PostCard post={post} />)
    )
  }
</BaseLayout>

<style>
  /* カテゴリ×サービスのページ側と同じ見た目にすること（あちらは [service].astro） */
  .services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.4rem;
  }
  .service {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--text);
    text-decoration: none;
  }
  .service:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

