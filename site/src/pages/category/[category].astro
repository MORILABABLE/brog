---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import EvergreenCard from '../../components/EvergreenCard.astro'
import { CATEGORY_HUBS, SITE } from '../../config'
import { evergreenFor, evergreenSummary } from '../../lib/evergreen'

/**
 * ★ 生成するのは**ハブ1つにつき1ページ**（カテゴリ1つにつき1ページではない）。
 *   「配信終了予定」と「終了済み」は同じページに並べる。理由は config.ts の
 *   CATEGORY_HUBS を参照。**`/category/ended` は生成されない**ので、
 *   `public/_redirects` で `/category/leaving` へ転送してある。
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)

  return CATEGORY_HUBS.map((hub) => ({
    params: { category: hub.slug },
    props: {
      hub,
      posts: posts
        .filter((p) => (hub.includes as readonly string[]).includes(p.data.category))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

const { hub, posts } = Astro.props

/*
 * 常設ページを記事カードと同じ体裁で先頭に出す。
 * 「常に最新の◯◯を見る」という箱にまとめていたのをやめた（2026-08-23）。
 * サービスごとの見分けがつかず、周囲の記事カードから浮いていたため。
 *
 * 件数と基準日はここで読む。ビルド時にしか動かないので費用はかからない。
 */
const evergreen = hub.includes
  .flatMap((c) => evergreenFor(c))
  .map((page) => ({ page, ...evergreenSummary(page) }))
---

<BaseLayout title={`${hub.heading}の記事一覧`} description={`${SITE.name}の${hub.description}`}>
  <h1>{hub.heading}</h1>

  {
    evergreen.map((e) => (
      <EvergreenCard page={e.page} count={e.count} dataAsOf={e.dataAsOf} />
    ))
  }

  {
    posts.length === 0 ? (
      <p class="muted">この分類の記事はまだありません。</p>
    ) : (
      posts.map((post) => <PostCard post={post} />)
    )
  }
</BaseLayout>

