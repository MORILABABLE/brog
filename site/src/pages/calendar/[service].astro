---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import EventCalendar from '../../components/EventCalendar.astro'
import PrimeCta from '../../components/PrimeCta.astro'
import WorkSearch from '../../components/WorkSearch.astro'
import WorkTable from '../../components/WorkTable.astro'
import { ATTRIBUTION, CATEGORIES, EVERGREEN_BADGE, SITE } from '../../config'
import { buildCalendar } from '../../lib/calendar'
import {
  ARRIVALS_WINDOW_DAYS,
  CALENDAR_SERVICES,
  groupByDate,
  hasArrivals,
  hasLeaving,
  loadArrivals,
  loadLeaving,
} from '../../lib/events-data'
import { calendarTitleBase, evergreenTitle } from '../../lib/evergreen'
import { primeAd } from '../../lib/prime-ad'
import { formatDate } from '../../utils/date'

/**
 * 常設ページ「◯◯の見放題カレンダー」。**サービス1社につき1枚。**
 *
 * ■ 何を足したページなのか（2026-09-07）
 * 従来の常設ページは「終了予定」と「新着」で別々の5枚だった。
 * 中身は正しいが、**読者は日付で探している**（「今月末で消えるのはどれか」）のに、
 * 一覧を上から追う以外に日付へ辿り着く手が無かった。
 * ここは同じデータに**月の升目**を先に置いて、点いている日から本文へ飛ばす。
 *
 * ■ ★ 主役は従来の5ページ。このページはその補助
 * 一度は左の枠（LeftRail.astro）の行き先をこの3枚に寄せたが、**2026-09-07 に戻した。**
 * 畳んだ形ではカードの外に「終了予定／新着」の小さいリンクがぶら下がり、見た目が悪かった。
 * **升目そのものは5ページの中に入れた**ので、読者が欲しかったもの（日付から入る）は
 * そちらが持っている。
 *
 * ★ このページは**残してあるが、左の枠からは外した。**
 *   サイト内の入口は `/leaving/<サービス>` `/arrivals/<サービス>` の末尾の関連リンクだけ。
 *   **あの2本を消すと孤立ページになる。**
 * ★ 中身は5ページの和集合なので、**検索では自社の2ページと競合しうる。**
 *   索引から外すなら BaseLayout に `noindex` を渡すだけでよい（1行）。
 *   いまは入れていない（残置の判断は 2026-09-07）。
 *
 * ■ 表を2つ置くので id が衝突する
 * 日付見出しの id は `2026-09-30` のような日付そのもの（WorkTable.astro）。
 * 終了予定と新着を同じページに並べると同じ id が2つできるので、
 * **`idPrefix` で頭を分けている。** カレンダー側の `leavingPrefix` /
 * `arrivalsPrefix` と必ず同じ文字列にすること。**片方だけ変えるとリンクが死ぬ。**
 *
 * ■ 見出しの階層
 * 節に h2（「見放題配信が終了する予定」）を置くので、日付見出しは h3 に落とす
 * （`headingLevel={3}`）。同じ階層に h2 が2種類並ぶと読み上げで木が崩れる。
 */
export function getStaticPaths() {
  return CALENDAR_SERVICES.map((s) => ({
    params: { service: s.key },
    props: { label: s.label },
  }))
}

const { service } = Astro.params
const { label } = Astro.props

/*
 * ★ そのサービスが持っていない種類は**読み込まない**。
 *   Disney+ には終了予定が無い（実測。events-data.ts の LEAVING_SERVICES）。
 *   空の一覧を読んで空の節を出すと、「終了予定は0件です」という
 *   *観測できていないだけ*の事実を、無いことのように見せてしまう。
 */
const leaving = hasLeaving(service!) ? loadLeaving(service!) : null
const arrivals = hasArrivals(service!) ? loadArrivals(service!) : null

const leavingWorks = leaving?.works ?? []
const arrivalsWorks = arrivals?.works ?? []

/*
 * 基準日は2つの一覧のうち**新しいほう**。片方だけを見ると、
 * 終了予定を持たないサービスで日付が付かなくなる。
 * ★ lib/evergreen.ts の `calendarSummary()` と同じ決め方にすること
 *   （左の枠とページで違う日付を名乗ることになる）。
 */
const dates = [leaving?.dataAsOf, arrivals?.dataAsOf].filter((d): d is Date => Boolean(d))
const dataAsOf = dates.length > 0 ? new Date(Math.max(...dates.map((d) => d.getTime()))) : null

/*
 * 升目。**渡すのは表に出しているのと同じ配列**（lib/calendar.ts）。
 * 別の絞り込みを掛けると、点いているのに飛び先が無い日ができる。
 */
const calendar = buildCalendar(leavingWorks, arrivalsWorks)

// ★ カレンダーの行き先と、下の WorkTable の idPrefix は同じ文字列にすること
const LEAVING_PREFIX = '#leaving-'
const ARRIVALS_PREFIX = '#arrivals-'

const leavingGroups = groupByDate(leavingWorks)
const arrivalsGroups = groupByDate(arrivalsWorks)
// `loadLeaving` は終了日の近い順（2026-09-07）。**いちばん近い終了日は先頭**
const nearest = leavingGroups[0]

/*
 * タイトル。**素の文言も基準日の付け方も lib/evergreen.ts の1か所。**
 * ここで文字列を作らないこと（同じページがカードと見出しで別の名前を名乗る）。
 */
const title = evergreenTitle(calendarTitleBase(label), dataAsOf)

/*
 * 本文のCTA。**Prime Video の面だけ行き先が変わる。**
 * ★ `calendar: true` を渡す。カテゴリを渡すと、渡さなかった側の作品について
 *   文言が嘘になる（lib/prime-ad.ts の `COPY.calendar`）。
 * ★ 他社の面で出る `AmazonCta` には**カテゴリを渡さない**。
 *   カテゴリ別の文面はどちらも面の全部について名乗る書き方なので、
 *   2種類が混ざるこのページでは汎用の文面が正しい。
 */
const primeSlot = primeAd({ service, calendar: true })

const description =
  leavingWorks.length > 0
    ? `${label}で見放題配信が終了する予定の作品${leavingWorks.length}本と、直近${ARRIVALS_WINDOW_DAYS}日間に見放題になった作品${arrivalsWorks.length}本をカレンダーで確認できます。`
    : `${label}で直近${ARRIVALS_WINDOW_DAYS}日間に見放題配信が始まった作品${arrivalsWorks.length}本をカレンダーで確認できます。`
---

<BaseLayout title={title} description={description}>
  {/* 上位のカテゴリを1つに決められない面なので、区切りの「›」は付けない */}
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a>
  </nav>

  {/*
    ★ 見出しの直上のサービス画像（LeadImage）は**置いていない**（2026-09-07）。
      理由は pages/leaving/[service].astro の同じ位置に書いてある。
      3枚とも同じ扱いにすること。
  */}
  <h1>{title}</h1>

  {/*
    ★ カテゴリのバッジを**2つ出す**。ここだけ他の常設ページと違う。
      このページは「配信終了予定」と「新着配信」の両方を持っているので、
      片方だけ出すと、出さなかったほうの作品が載っていることが伝わらない。
      色が2つ並ぶことになるが、どちらもラベル文字を持っているので読める
      （色だけに意味を持たせない。styles/global.css の :root）。
      終了予定を持たないサービス（Disney+）では1つに減る。
  */}
  <div class="meta">
    {
      leavingWorks.length > 0 && (
        <span class="badge" data-category={CATEGORIES.leaving.slug}>
          {CATEGORIES.leaving.label}
        </span>
      )
    }
    {
      arrivalsWorks.length > 0 && (
        <span class="badge" data-category={CATEGORIES.arrivals.slug}>
          {CATEGORIES.arrivals.label}
        </span>
      )
    }
    <span class="badge evergreen">{EVERGREEN_BADGE.label}</span>
  </div>

  <p class="kind-note">{EVERGREEN_BADGE.note}</p>

  <AffiliateNotice />

  {/* 配信状況は変わる。いつ時点のデータかを必ず出す。 */}
  <p class="notice">
    {
      dataAsOf ? (
        <>
          配信情報は <strong>{formatDate(dataAsOf)}時点</strong>のものです。
        </>
      ) : (
        <>配信情報の取得時刻が不明です。</>
      )
    }
    {label}の都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
  </p>

  {
    calendar.hasEvents ? (
      <EventCalendar
        months={calendar.months}
        leavingPrefix={LEAVING_PREFIX}
        arrivalsPrefix={ARRIVALS_PREFIX}
      />
    ) : (
      <p class="empty">
        現在、{label}について取得できている配信の予定・記録はありません。
        しばらくしてから再度ご確認ください。
      </p>
    )
  }

  {
    calendar.hasEvents && (
      <div class="list-head">
        <p class="summary">
          {leavingWorks.length > 0 && (
            <>
              <strong>{leavingWorks.length}本</strong>が終了予定です（最も近い終了日は
              {formatDate(nearest!.date)}）。
            </>
          )}
          直近{ARRIVALS_WINDOW_DAYS}日間に<strong>{arrivalsWorks.length}本</strong>
          が見放題に追加されました。
        </p>
        {/*
          作品検索。**このページの表2つをまとめて引く。**
          WorkSearch は文書内の `[data-work-row]` を全部見るので、
          終了予定と新着のどちらに居る作品でも当たる（部品側の変更は不要）。
        */}
        <WorkSearch label="この一覧から作品を探す" />
      </div>
    )
  }

  {
    leavingWorks.length > 0 && (
      <section class="block" id="leaving">
        <h2>見放題配信が終了する予定</h2>
        <p class="block-note">
          終了日の近い順（きょうに近い日付が上）に並べています。
          {label === 'Amazon Prime Video' &&
            'Prime Video は終了の約11日前にならないと終了予定が出ないため、先の日付ほど件数が少なくなります。'}
        </p>
        <WorkTable
          groups={leavingGroups}
          dateNoun="終了"
          service={service!}
          idPrefix="leaving-"
          headingLevel={3}
        />
      </section>
    )
  }

  {
    arrivalsWorks.length > 0 && (
      <section class="block" id="arrivals">
        <h2>最近見放題になった作品</h2>
        {/*
          ★ 「いま観られる」と断定しない。
            new は「配信が始まった」という過去の記録で、その後に終了している
            可能性がある。ページ下部の注記と合わせて誤読を防ぐ。
        */}
        <p class="block-note">
          直近{ARRIVALS_WINDOW_DAYS}日間ぶんを、配信開始日の新しい順（直近のものが上）に並べています。
        </p>
        <WorkTable
          groups={arrivalsGroups}
          dateNoun="追加"
          service={service!}
          idPrefix="arrivals-"
          headingLevel={3}
        />
      </section>
    )
  }

  {primeSlot ? <PrimeCta service={service} calendar /> : <AmazonCta />}

  <section class="sources">
    <h2>出典</h2>
    <ul>
      <li>
        <a href={ATTRIBUTION.url} rel="noopener noreferrer" target="_blank">
          {ATTRIBUTION.text}
        </a>
      </li>
      <li>
        <a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank">
          作品タイトル（Wikidata・CC0）
        </a>
      </li>
    </ul>
  </section>

  {/*
    ★ 従来の常設ページへの導線。**消さないこと。**
      左の枠の行き先をカレンダーに移した結果、
      `/leaving/<サービス>` `/arrivals/<サービス>` へのサイト内リンクが
      カテゴリ一覧とここだけになった。ここを外すと、
      サイト最多の表示を持つ面（docs/FUNNEL.md 4-1）が内部リンクを失う。
  */}
  <p class="related">
    種類ごとの一覧:
    {hasLeaving(service!) && <a href={`/leaving/${service}`}>{label}の終了予定</a>}
    {hasArrivals(service!) && <a href={`/arrivals/${service}`}>{label}の新着配信</a>}
    {
      CALENDAR_SERVICES.filter((s) => s.key !== service).map((s) => (
        <a href={`/calendar/${s.key}`}>{s.label}のカレンダー</a>
      ))
    }
    <a href="/stats">見放題の増減</a>
  </p>

  <p class="site-note">
    このページの配信記録は Netflix・Amazon Prime Video・Disney+・Apple TV+ の4サービスぶんです
    （{SITE.name}が追いかけている U-NEXT は記事でのみ扱っており、このページには入っていません）。
    「最近見放題になった作品」に載せているのは<strong>配信が始まった記録</strong>で、
    その後に配信が終了している場合があります。
    「他で探す」のリンクは各サービスの検索結果に飛ぶだけで、
    配信の有無を保証するものではありません。
  </p>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  /* 記事ページの .meta と同じ値。**ずらさないこと**（並べて比べる前提の形なので） */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  /* バッジの意味を1行で補う。すぐ下の広告表記と続けて読める大きさにする */
  .kind-note {
    margin: 0.7rem 0 0;
    font-size: 0.84rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
  /* 冒頭文の位置は .list-head 側で決めている（styles/global.css） */
  .empty {
    margin: 1.5rem 0;
    color: var(--text-muted);
  }
  /*
   * 節（終了予定 / 新着）。**カレンダーから飛んでくる先の入れ物。**
   * 節の頭に余白を入れて、前の節の表と地続きに見えないようにする。
   */
  .block {
    margin-top: 2.2rem;
  }
  .block h2 {
    margin-bottom: 0.2rem;
    /* ページ内リンクで直接飛ばれることがある。ヘッダーに潜らせない */
    scroll-margin-top: 6rem;
  }
  .block-note {
    margin: 0 0 0.8rem;
    font-size: 0.84rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
  .sources h2 {
    font-size: 1rem;
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
  .related a {
    margin-left: 0.7rem;
  }
  .site-note {
    margin-top: 2rem;
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
</style>
