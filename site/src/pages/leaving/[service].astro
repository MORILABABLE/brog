---
import { getCollection } from 'astro:content'
import ServiceCalendarPage from '../../components/ServiceCalendarPage.astro'
import { CALENDAR_SERVICES } from '../../lib/events-data'

/**
 * 配信カレンダー（終了側）「◯◯で見放題配信が終了する作品一覧・カレンダー」。
 *
 * 中身は components/ServiceCalendarPage.astro（`/arrivals/<サービス>` と共有）。
 * **ここで持つのは作るページの一覧だけ。**
 *
 * 月次記事は公開時点のスナップショットで月をまたぐと古くなるが、
 * このページはURLが固定で `collect` のたびに中身だけが入れ替わる。
 * LLMを使わないので生成コストはゼロ、誤情報のリスクもない。
 *
 * ★ 月次記事の取りこぼしを埋める役割がある。
 *   Prime Video は終了の11日前にしか終了予定を出さないため、
 *   月次記事はどう頑張っても月後半分を落とす（HANDOVER.md の落とし穴）。
 *   ここは収集のたびに追従するので、そこが埋まる。
 *
 * ★ 作るのは**カレンダーのある全社**（2026-09-17 から Disney+ を含む）。
 *   Disney+ は終了予定を返さないので、**終了済みだけ**のページになる（lib/events-data.ts の CALENDAR_SERVICES）。
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return CALENDAR_SERVICES.map((s) => ({
    params: { service: s.key },
    props: { label: s.label, posts },
  }))
}

const { service } = Astro.params
const { label, posts } = Astro.props
---

<ServiceCalendarPage direction="leaving" service={service!} label={label} posts={posts} />
