---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import WorkTable from '../../components/WorkTable.astro'
import WorkSearch from '../../components/WorkSearch.astro'
import LeadImage from '../../components/LeadImage.astro'
import { ATTRIBUTION, SITE } from '../../config'
import { formatDate } from '../../utils/date'
import { serviceImage } from '../../lib/images'
import { LEAVING_SERVICES, groupByDate, loadLeaving } from '../../lib/events-data'

/**
 * 常設ページ「◯◯で配信終了予定の作品」。
 *
 * 月次記事は公開時点のスナップショットで月をまたぐと古くなるが、
 * このページはURLが固定で `collect` のたびに中身だけが入れ替わる。
 * LLMを使わないので生成コストはゼロ、誤情報のリスクもない。
 *
 * ★ 月次記事の取りこぼしを埋める役割がある。
 *   Prime Video は終了の11日前にしか終了予定を出さないため、
 *   月次記事はどう頑張っても月後半分を落とす（HANDOVER.md の落とし穴）。
 *   ここは収集のたびに追従するので、そこが埋まる。
 */
export function getStaticPaths() {
  return LEAVING_SERVICES.map((s) => ({
    params: { service: s.key },
    props: { label: s.label },
  }))
}

const { service } = Astro.params
const { label } = Astro.props

const { works, dataAsOf } = loadLeaving(service!)
const groups = groupByDate(works)
const lead = serviceImage(service!)

const title = `${label}で配信終了予定の作品一覧`
const description =
  works.length > 0
    ? `${label}で見放題配信が終了する予定の作品${works.length}本を終了日順にまとめています。最も近い終了日は${formatDate(groups[0]!.date)}です。`
    : `${label}で見放題配信が終了する予定の作品を終了日順にまとめています。現在、終了予定として取得できている作品はありません。`
---

<BaseLayout title={title} description={description}>
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a> ›
    <a href="/category/leaving">配信終了予定</a>
  </nav>

  {/* 見出しの直上。src/assets/services/<キー>.png を置くと出る */}
  <LeadImage image={lead} alt="" />

  <h1>{title}</h1>

  <AffiliateNotice />

  {/* 配信状況は変わる。いつ時点のデータかを必ず出す。 */}
  <p class="notice">
    {
      dataAsOf ? (
        <>
          配信情報は <strong>{formatDate(dataAsOf)}時点</strong>のものです。
        </>
      ) : (
        <>配信情報の取得時刻が不明です。</>
      )
    }
    {label}の都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
  </p>

  {
    works.length === 0 ? (
      <p class="empty">
        現在、{label}で終了予定として取得できている作品はありません。
        {label === 'Amazon Prime Video'
          ? 'Prime Video は終了の約11日前にならないと終了予定が出ないため、時期によっては空になります。'
          : 'しばらくしてから再度ご確認ください。'}
      </p>
    ) : (
      <>
        {/*
          冒頭文の右の空きに作品検索を置く。
          入力すると該当作品の行まで自動でスクロールする（絞り込みはしない）。
          レイアウトは styles/global.css の .list-head。
        */}
        <div class="list-head">
          <p class="summary">
            <strong>{works.length}本</strong>が終了予定です。終了日の早い順に並べています。
          </p>
          <WorkSearch label="終了予定の作品を探す" />
        </div>
        <WorkTable groups={groups} dateNoun="終了" />
      </>
    )
  }

  <AmazonCta category="leaving" />

  <section class="sources">
    <h2>出典</h2>
    <ul>
      <li>
        <a href={ATTRIBUTION.url} rel="noopener noreferrer" target="_blank">
          {ATTRIBUTION.text}
        </a>
      </li>
      <li>
        <a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank">
          作品タイトル（Wikidata・CC0）
        </a>
      </li>
    </ul>
  </section>

  <p class="related">
    ほかの常設ページ:
    {
      LEAVING_SERVICES.filter((s) => s.key !== service).map((s) => (
        <a href={`/leaving/${s.key}`}>{s.label}の終了予定</a>
      ))
    }
    <a href={`/arrivals/${service}`}>{label}の新着配信</a>
    <a href="/stats">見放題の増減</a>
  </p>

  <p class="site-note">
    {SITE.name}が配信状況を把握しているのは Netflix・Amazon Prime Video・Disney+・Apple TV+
    の4サービスです。「他で探す」のリンクは各サービスの検索結果に飛ぶだけで、
    配信の有無を保証するものではありません。
  </p>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  /* 冒頭文の位置は .list-head 側で決めている（styles/global.css） */
  .empty {
    margin: 1.5rem 0;
    color: var(--text-muted);
  }
  .sources h2 {
    font-size: 1rem;
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
  .related a {
    margin-left: 0.7rem;
  }
  .site-note {
    margin-top: 2rem;
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
</style>
