---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdSlot from '../../components/AdSlot.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import { CATEGORIES, hubFor } from '../../config'
import { formatDate, isoDate } from '../../utils/date'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const cat = CATEGORIES[post.data.category]
/*
 * パンくずの行き先は**カテゴリではなくハブ**。
 * 「配信終了済み」の記事は /category/ended ではなく /category/leaving に載っている
 * （ページを1つにまとめたため。config.ts の CATEGORY_HUBS）。
 * ここを cat.slug のままにすると、生成されないURLへのリンクになる。
 */
const hub = hubFor(post.data.category)
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  ogImagePath={`/cards/${post.id}.jpg`}
>
  <article>
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a> ›
      <a href={`/category/${hub.slug}`}>{hub.label}</a>
    </nav>

    {/*
      ★ 見出しの直上のヘッダー画像は**出していない**（2026-08-25 に非表示）。

      表の全作品にサムネイル付きのリンクが並ぶようになり、
      冒頭にもう1枚ポスターを置く意味が無くなった。
      **記事の本題（表）に届くまでのスクロールを削るほうが効く。**

      frontmatter の `heroImage` は残してある。**一覧カードの左サムネイル**
      （PostCard.astro → Thumb.astro）がこれを読んでいるので、
      トップページ・カテゴリ一覧・新着記事枠には今までどおりポスターが出る。
      生成（scripts/make-sections.mjs）も変えていない。

      また出したくなったら、LeadImage を import して
      `<LeadImage src={post.data.heroImage} alt="" />` をここに戻すだけでよい。
      （常設ページ側の LeadImage は今も使っている。消さないこと）
    */}

    <h1>{post.data.title}</h1>

    <div class="meta">
      {/* 記事単体で開かれたときも、色で種別が分かるようにする。 */}
      <span class="badge" data-category={cat.slug}>{cat.label}</span>
      <time datetime={isoDate(post.data.pubDate)}>公開 {formatDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <time datetime={isoDate(post.data.updatedDate)}>
            更新 {formatDate(post.data.updatedDate)}
          </time>
        )
      }
    </div>

    {/*
      広告（PR）表記。景品表示法（ステマ規制）上の義務なので、
      本文を読み進めた先ではなく**冒頭**に置く。
      アフィリエイトが未設定のときは何も描画されない。
    */}
    <AffiliateNotice />

    {/* 配信状況は変わるため、基準日を必ず明示する */}
    <p class="notice">
      配信情報は <strong>{formatDate(post.data.dataAsOf)}時点</strong>のものです。
      各サービスの都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
    </p>

    <div class="prose">
      <Content />
    </div>

    {/*
      Amazon への導線。文面は記事カテゴリで変わる
      （配信終了記事に「見放題で探す」と出すのは誤誘導になるため）。
      トラッキングID未設定なら描画されない。
    */}
    <AmazonCta category={post.data.category} />

    <AdSlot />

    <section class="sources">
      <h2>出典</h2>
      <ul>
        {
          post.data.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    /* バッジと日付が並ぶので、縦位置を揃える */
    align-items: center;
    gap: 0.7rem 1rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  .sources h2 {
    font-size: 1rem;
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
