---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdSlot from '../../components/AdSlot.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import { CATEGORIES, SERVICE_HUBS, hubFor } from '../../config'
import { genreBadges } from '../../lib/genres'
import { firstPublished, formatDate, isoDate, lastModified } from '../../utils/date'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const cat = CATEGORIES[post.data.category]
/*
 * ジャンル（アニメ／洋画／邦画）。**全記事が名乗る**（2026-09-15）。
 * 入っているものを全部出すので最大3枚並ぶ。組み立ては lib/genres.ts。
 *
 * ★ `soleGenre`（1つのジャンルだけを名乗れる記事で値が入る）は 2026-09-19 に
 *   ここから外した。U-NEXT のLP選びに使っていたが、広告の判定ごと
 *   `plugins/rehype-section-ads.ts` へ移したため。
 */
const genres = genreBadges(post.data)
/*
 * パンくずの行き先は**カテゴリではなくハブ**。
 * 「配信終了済み」の記事は /category/ended ではなく /category/leaving に載っている
 * （ページを1つにまとめたため。config.ts の CATEGORY_HUBS）。
 * ここを cat.slug のままにすると、生成されないURLへのリンクになる。
 */
const hub = hubFor(post.data.category)
/*
 * 公開日と更新日（2026-09-25）。画面の「公開／更新」と構造化データの
 * `datePublished` / `dateModified` に**同じ値**を渡す。
 *
 * ★ それまでは公開日に `pubDate` を出していた。`--apply` が書き直しのたびに振り直すので、
 *   8月31日に出た記事が「9月23日公開」を名乗っていた（transformers）。
 *   Google は `datePublished` に**初めて公開した日**を求めている。
 * ★ 同じ日に書き直しただけなら「更新」は出さない（公開日と同じ日付が2つ並ぶだけになる）。
 */
const published = firstPublished(post.data)
const modified = lastModified(post.data)
const wasModified = isoDate(modified) !== isoDate(published)
/*
 * ★ **広告の判定はこのファイルから消えた**（2026-09-19 のテンプレ改修）。
 *   枠が本文の中に移ったので、掲載NGの判定も出し分けも
 *   `plugins/rehype-section-ads.ts` が持っている。
 *
 *   ここにあったもの（戻すときの手がかり）:
 *     unextSubject … U-NEXT を扱う記事にだけ U-NEXT の枠を出す（ガイドライン【6】関連性）
 *     primeSlot    … Prime Video の「まだ観られる」記事だけ無料体験の専用リンクに替える
 *                    （`lib/prime-ad.ts`。**普通の Amazon リンクでは成果にならない**）
 *     adPageText   … 掲載NGの判定に渡す文字列（タイトル・説明文・本文）
 *
 *   🔴 **2か所に書かないこと。** 同じ判断がページ側とプラグイン側に散ると、
 *     片方だけ直して掲載NGの面に広告が出る事故になる。
 */
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={published}
  updatedAt={modified}
  ogImagePath={`/cards/${post.id}.jpg`}
>
  <article>
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a> ›
      <a href={`/category/${hub.slug}`}>{hub.label}</a>
    </nav>

    {/*
      ★ 見出しの直上のヘッダー画像は**出していない**（2026-08-25 に非表示）。

      表の全作品にサムネイル付きのリンクが並ぶようになり、
      冒頭にもう1枚ポスターを置く意味が無くなった。
      **記事の本題（表）に届くまでのスクロールを削るほうが効く。**

      frontmatter の `heroImage` は残してある。**一覧カードの左サムネイル**
      （PostCard.astro → Thumb.astro）と、右の枠の「最新記事」「シリーズから探す」
      （FollowRail.astro / SeriesRail.astro）がこれを読んでいるので、
      トップページ・カテゴリ一覧・右の枠には今までどおりポスターが出る。
      生成（scripts/make-sections.mjs）も変えていない。

      また出したくなったら、LeadImage を import して
      `<LeadImage src={post.data.heroImage} alt="" />` をここに戻すだけでよい。
      （常設ページ側の LeadImage は今も使っている。消さないこと）
    */}

    <h1>{post.data.title}</h1>

    <div class="meta">
      {/* 記事単体で開かれたときも、色で種別が分かるようにする。 */}
      <span class="badge" data-category={cat.slug}>{cat.label}</span>
      {/* 何を観る話かが、本文を読む前に分かるようにする */}
      {genres.map((label) => <span class="badge genre">{label}</span>)}
      <time datetime={isoDate(published)}>公開 {formatDate(published)}</time>
      {
        wasModified && (
          <time datetime={isoDate(modified)}>
            更新 {formatDate(modified)}
          </time>
        )
      }
    </div>

    {/*
      広告（PR）表記。景品表示法（ステマ規制）上の義務なので、
      本文を読み進めた先ではなく**冒頭**に置く。
      アフィリエイトが未設定のときは何も描画されない。
    */}
    <AffiliateNotice />

    {/* 配信状況は変わるため、基準日を必ず明示する */}
    <p class="notice">
      配信情報は <strong>{formatDate(post.data.dataAsOf)}時点</strong>のものです。
      各サービスの都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
    </p>

    {/*
      ★ **本文中の広告はビルドが入れる**（2026-09-19 のテンプレ改修）。
        `plugins/rehype-section-ads.ts` が**小段落1と小段落2の直下**に1枠ずつ差し込み、
        小段落2の表の直下に配信カレンダーへの導線を置く。

      ■ なぜページ側から外したのか
      それまでは「本文のすぐ上に afb 1枠」＋「記事末尾に Amazon 1枠」だった。
      **枠の数は変えていない。位置だけを小段落の直下へ移した。**

        2026-09-14 まで 本文の下に afb  … 枠別のクリック実測は `cta` 0回
                                          （スクロール90%到達は22%。docs/FUNNEL.md 5-3）
        2026-09-19 まで 本文の上に afb  … 表を1画面目から押し下げていた
        いま            小段落の直下    … 読者が解説を読み終えた位置

      ★ **広告（PR）表記は本文より上にある**（AffiliateNotice）。
        順番を入れ替えないこと — 広告が表記より先に出てはいけない。
      ★ 出し分け（Hulu → 出せない面は Amazon）と掲載NGの判定は
        プラグイン側にある。**このファイルに条件を書き戻さないこと。**
      ★ afb のリンクコードが未設定なら1バイトも出ない。
    */}
    <div class="prose">
      <Content />
    </div>

    {/*
      ★ **記事末尾の Amazon 枠は 2026-09-19 に廃止した**（運用者の指定）。
        行き先は小段落の直下の枠に移っている（`plugins/rehype-section-ads.ts`）。

      🔴 **`PrimeCta` を戻すときは、ここではなくプラグイン側に置くこと。**
        Prime Video の「まだ観られる」記事だけ無料体験の専用リンクに置き換わる
        仕組みだった（docs/AFFILIATE.md 3-0）。**普通の Amazon リンクでは
        無料体験の成果にならない**ので、同じ出し分けが要る。
        いまは枠が本文の中にしか無いため、判断もそちらに寄せる。
    */}

    <AdSlot />

    <section class="sources">
      <h2>出典</h2>
      <ul>
        {
          post.data.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((t) => {
            /*
             * サービスのタグは**サイト内のサービス別ページへ送る**（2026-09-15）。
             * タグの文字列は config.ts の SERVICE_HUBS の tag と完全一致させてあるので、
             * ここで引き当てられる。対応するページが無いタグ（#シリーズ など）は
             * これまでどおり文字のまま — 行き先の無いリンクを作らない。
             */
            const hub = SERVICE_HUBS.find((h) => h.tag === t)
            return <li>{hub ? <a href={`/service/${hub.slug}`}>#{t}</a> : <>#{t}</>}</li>
          })}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    /* バッジと日付が並ぶので、縦位置を揃える */
    align-items: center;
    gap: 0.7rem 1rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  .sources h2 {
    font-size: 1rem;
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
