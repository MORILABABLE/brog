---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdSlot from '../../components/AdSlot.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import PrimeCta from '../../components/PrimeCta.astro'
import AfbCta from '../../components/AfbCta.astro'
import { CATEGORIES, GENRES, hubFor } from '../../config'
import { primeAd } from '../../lib/prime-ad'
import { formatDate, isoDate } from '../../utils/date'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const cat = CATEGORIES[post.data.category]
/*
 * ジャンル（アニメ／洋画／邦画）。**ジャンル軸の記事だけが持つ**ので、
 * 無ければバッジを出さない。詳細は config.ts の GENRES。
 */
const genre = post.data.genre ? GENRES[post.data.genre] : undefined
/*
 * パンくずの行き先は**カテゴリではなくハブ**。
 * 「配信終了済み」の記事は /category/ended ではなく /category/leaving に載っている
 * （ページを1つにまとめたため。config.ts の CATEGORY_HUBS）。
 * ここを cat.slug のままにすると、生成されないURLへのリンクになる。
 */
const hub = hubFor(post.data.category)
/*
 * U-NEXT（afb）の導線を出すか。**U-NEXT を扱っている記事にだけ出す。**
 *
 * ★ 全記事に出さない理由は2つ。
 *   1. ガイドライン【6】「関連性が薄いサイト」。Netflix だけの記事に
 *      U-NEXT の広告を貼るのは、ページの中身と広告が噛み合っていない
 *   2. 噛み合っていない枠は押されない。**枠を増やすほど成果は薄まる**
 *
 * ★ 判定はタグ。サービス軸のページ（config.ts の SERVICE_HUBS）が使うのと
 *   同じ文字列で、記事側は theme-packs の `tags()` が書く。
 */
const unextSubject = post.data.tags.includes('U-NEXT')

/*
 * 本文のCTA。**Prime Video を主題にした「まだ観られる」記事だけ行き先が変わる。**
 * 判断は lib/prime-ad.ts の1か所（サービス軸であること・カテゴリが
 * arrivals か leaving であることの両方を見ている）。
 * 配信終了済みの記事には出ない — 観られない作品のページで
 * 会員登録を勧めることになるため。
 */
const primeSlot = primeAd({ tags: post.data.tags, category: post.data.category })
/*
 * 掲載NGの判定に渡す文字列。**タイトル・説明文・本文をすべて渡す。**
 * 表の作品名も解説文も本文の中にあるので、これで足りる
 * （U-NEXT は src/lib/unext-ng.ts、Hulu は src/lib/hulu-ng.ts が読む）。
 */
const adPageText = [post.data.title, post.data.description, post.body ?? ''].join('\n')
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  ogImagePath={`/cards/${post.id}.jpg`}
>
  <article>
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a> ›
      <a href={`/category/${hub.slug}`}>{hub.label}</a>
    </nav>

    {/*
      ★ 見出しの直上のヘッダー画像は**出していない**（2026-08-25 に非表示）。

      表の全作品にサムネイル付きのリンクが並ぶようになり、
      冒頭にもう1枚ポスターを置く意味が無くなった。
      **記事の本題（表）に届くまでのスクロールを削るほうが効く。**

      frontmatter の `heroImage` は残してある。**一覧カードの左サムネイル**
      （PostCard.astro → Thumb.astro）と、右の枠の「最新記事」「シリーズから探す」
      （FollowRail.astro / SeriesRail.astro）がこれを読んでいるので、
      トップページ・カテゴリ一覧・右の枠には今までどおりポスターが出る。
      生成（scripts/make-sections.mjs）も変えていない。

      また出したくなったら、LeadImage を import して
      `<LeadImage src={post.data.heroImage} alt="" />` をここに戻すだけでよい。
      （常設ページ側の LeadImage は今も使っている。消さないこと）
    */}

    <h1>{post.data.title}</h1>

    <div class="meta">
      {/* 記事単体で開かれたときも、色で種別が分かるようにする。 */}
      <span class="badge" data-category={cat.slug}>{cat.label}</span>
      {/* ジャンル軸の記事だけ。何を観る話かが、本文を読む前に分かるようにする */}
      {genre && <span class="badge genre">{genre.label}</span>}
      <time datetime={isoDate(post.data.pubDate)}>公開 {formatDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <time datetime={isoDate(post.data.updatedDate)}>
            更新 {formatDate(post.data.updatedDate)}
          </time>
        )
      }
    </div>

    {/*
      広告（PR）表記。景品表示法（ステマ規制）上の義務なので、
      本文を読み進めた先ではなく**冒頭**に置く。
      アフィリエイトが未設定のときは何も描画されない。
    */}
    <AffiliateNotice />

    {/* 配信状況は変わるため、基準日を必ず明示する */}
    <p class="notice">
      配信情報は <strong>{formatDate(post.data.dataAsOf)}時点</strong>のものです。
      各サービスの都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
    </p>

    {/*
      afb（U-NEXT / Hulu）への導線。**本文のすぐ上**（2026-09-14 に移動）。

      ■ なぜ上なのか — **記事の最後尾まで読者は到達しない**
      スクロール90%到達は実測22%（docs/FUNNEL.md 5-3）。それまでこの枠は
      本文の下にあり、枠別のクリック実測は **`cta` 0回**だった
      （`data-slot`・2026-09-11 まで。踏まれていたのは work 4 / table 3 /
      bar 2 / poster 1）。**8割の読者に見られていない場所**に、
      単価がいちばん高い枠を置いていたことになる。

      記事で踏まれているのは表の作品名（`table`）で、表は本文の最初の1画面に入る。
      その直前がこの位置。

      ★ **押し下げる代償は承知の上。** 表を最初の1画面に置くのは
        docs/FUNNEL.md 5-3 の設計で、ここに1枚入れるとスマホで約46px
        （728x90 が画面幅に合わせて縮む）、PCで90px 下がる。
        **効かなければ戻すこと。** 判断材料は `hulu-cta` 枠のクリック数。
      ★ 広告（PR）表記は**この枠より上**にある（AffiliateNotice）。
        順番を入れ替えないこと — 広告が表記より先に出てはいけない。
      ★ **1ページに afb の枠は1つだけ。** U-NEXT を優先し、出せない面に
        Hulu を落とす（判断は AfbCta.astro）。2社は掲載NGの範囲が
        噛み合っていないので、これは「空白を埋める」動きになる。
      ★ `unextSubject` が false でもこの枠は消えない — U-NEXT が出ないだけで、
        Hulu の条件を満たせば Hulu が出る。**記事31本中21本が該当する。**
      ★ afb のリンクコードが未設定なら1バイトも出ない。
      ★ 掲載NGの作品・権利元が本文にあるページでは、この枠ごと消える。
    */}
    <AfbCta
      spot="cta"
      category={post.data.category}
      genre={post.data.genre}
      pageText={adPageText}
      asOf={post.data.dataAsOf}
      services={post.data.tags}
      unextSubject={unextSubject}
    />

    <div class="prose">
      <Content />
    </div>

    {/*
      Amazon への導線。**afb の枠の下**（2026-09-14 に入れ替え。上の★）。
      リンクの文字は記事カテゴリで変わる
      （配信終了記事に「見放題で探す」と出すのは誤誘導になるため）。
      トラッキングID未設定なら描画されない。

      ★ **Prime Video の「まだ観られる」記事だけ、枠ごと置き換わる**
        （プライムの無料体験は専用リンクでないと成果にならない。
        docs/AFFILIATE.md 3-0）。**並べずに置き換えること。**
    */}
    {
      primeSlot ? (
        <PrimeCta tags={post.data.tags} category={post.data.category} />
      ) : (
        <AmazonCta category={post.data.category} />
      )
    }

    <AdSlot />

    <section class="sources">
      <h2>出典</h2>
      <ul>
        {
          post.data.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    /* バッジと日付が並ぶので、縦位置を揃える */
    align-items: center;
    gap: 0.7rem 1rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  .sources h2 {
    font-size: 1rem;
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
