---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import EvergreenCard from '../../components/EvergreenCard.astro'
import { SERVICE_HUBS, SERVICE_MENU_HUBS, SITE } from '../../config'
import { serviceHasContent, serviceSection } from '../../lib/service-pages'

/**
 * サービス別のまとめページ。
 *
 * ■ カテゴリのハブ（/category/…）と役割が違う
 *   カテゴリ … 「何が起きたか」（終了まわり／新着）で束ねる
 *   ここ     … 「契約しているサービス」で束ねる
 * 同じ記事が両方から辿れるが、読者の探し方が違うので競合しない。
 *
 * ■ 記事はタグで拾う
 * 記事の frontmatter `tags` にサービス名が入っている
 * （各記事タイプの `tags()` が出している）。
 * 記事タイプが増えても、タグさえ付いていればこのページに自動で並ぶ。
 *
 * ★ タグの文字列は src/config.ts の SERVICE_HUBS と完全一致が要る。
 *   1文字でも違うと0件のページができあがる。
 *
 * ■ 常設ページも一緒に出す
 * そのサービスの `/leaving/…` `/arrivals/…` があれば先頭に置く。
 * 中身が `collect` のたびに入れ替わるので、月次記事より鮮度が高い。
 * U-NEXT には常設ページが無い（データの取り方が違う）。**無くても崩れない。**
 *
 * ★ **中身が0件のサービスのページは作らない。**
 *   ヘッダーのメニューが指しているのはカテゴリ×サービスのページ
 *   （/category/<ハブ>/<サービス>）で、ここではない。
 *   メニューの行き先ではないので、空のページを増やす理由がない。
 *   リンクしている側（category/[category]/[service].astro）も
 *   同じ判定でリンクごと出し分けているので、404にはならない。
 *
 * ★ 記事の絞り込みは lib/service-pages.ts に寄せてある。
 *   カテゴリ×サービスのページと同じ関数を使うので、拾い方がずれない。
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)

  return SERVICE_HUBS.filter((hub) => serviceHasContent(serviceSection(posts, hub))).map((hub) => ({
    params: { service: hub.slug },
    props: { hub, posts },
  }))
}

const { hub, posts } = Astro.props

/* カテゴリを問わず、このサービスの記事と常設ページを全部拾う */
const section = serviceSection(posts, hub)

const title = `${hub.label}の配信情報まとめ`
const description =
  `${hub.label}で見放題配信が始まった作品と終了する作品の記事をまとめています。` +
  `${SITE.name}が追いかけている${hub.label}の情報はこのページから辿れます。`
---

<BaseLayout title={title} description={description}>
  {/* 上位のカテゴリを持たないページなので、区切りの「›」は付けない */}
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a>
  </nav>

  <h1>{hub.label}</h1>
  <p class="lead">
    {hub.label}の配信終了と新着をまとめています。
    {section.evergreen.length > 0 && '常に最新の一覧は上の2枚から見られます。'}
  </p>

  {/*
    カテゴリで絞った一覧への導線。ヘッダーのメニューと同じ行き先で、
    こちらは「サービス → カテゴリ」の順に辿ってきた読者向け。
  */}
  <nav class="hubs" aria-label="カテゴリで絞り込む">
    {
      SERVICE_MENU_HUBS.map((h) => (
        <a class="hub" href={`/category/${h.slug}/${hub.slug}`}>
          {hub.label}の{h.label}
        </a>
      ))
    }
  </nav>

  {
    section.evergreen.map((e) => (
      <EvergreenCard page={e.page} count={e.count} dataAsOf={e.dataAsOf} />
    ))
  }

  {section.posts.map((post) => <PostCard post={post} />)}
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  /* カテゴリの絞り込み。カテゴリ×サービスのページのサービス切り替えと同じ形 */
  .hubs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.4rem;
  }
  .hub {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--text);
    text-decoration: none;
  }
  .hub:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
