---
import BaseLayout from '../layouts/BaseLayout.astro'

/**
 * ブックマーク（2026-09-22 まで「ウォッチリスト」）。
 * **作品ページで「☆ 気になる」を押した作品を、終了日の近い順に並べる。**
 *
 * ★ **URL は `/watchlist` のまま**（改名前に保存した読者の入口と、保存の鍵を変えないため）。
 *   入口はフッターの「ブックマーク」と、全ページのヘッダーの💭（Header.astro・1件以上で件数が付く）。
 *   ★ 💭 は0件の読者にも出ているので、**0件の案内（`data-when="empty"`）が機能の紹介を兼ねる。**
 *
 * ■ 配信再開のお知らせ（2026-09-22）
 * 作品ページは、終了が近い作品と「終わっていて観られる先が無い」作品に
 * 「※配信再開時はブックマーク一覧でお知らせします」と約束している（components/WatchStar.astro）。
 * **その約束を守るのがこのページ。** 索引（`/watchlist.json`）の5番目の要素に
 * 再開の根拠が入っている作品は、**いちばん上に「配信再開」として出す。**
 * 判定は `lib/works.ts` の `resumedOn()`。ここで作り直さないこと。
 *
 * ■ なぜこのページを作ったか
 * 実測（docs/FUNNEL.md 9-4）で、**ブックマーク経由の再訪は28日で0件**。
 * 戻ってきた読者26人も全員が**もう一度検索して**辿り着いていた。
 * 「消える前に、気づける。」を機能として成立させる面がこれ（docs/GROWTH.md 3-6）。
 *
 * ■ 中身はサーバから来ない
 * 保存は読者の `localStorage` にしか無い。**このHTMLは空の器**で、
 * 中身はブラウザ側で組み立てる。日付は `/watchlist.json`（索引）の
 * **新しい方で必ず上書きする** — 終了予定日は後から動くため。
 *
 * ★ **noindex。** 読者ごとに中身が違う（＝検索エンジンには常に空に見える）ので、
 *   出すと「中身の無いページ」として評価される。サイトマップからは
 *   `plugins/prune-sitemap.ts` が自動で落とす（手で除外リストを書かないこと）。
 *
 * ★ **JS はこのページと `components/WatchStar.astro` に閉じ込める。**
 *   一覧ページと記事ページにスクリプトを増やさないこと（docs/GROWTH.md 3-6）。
 */
const title = 'ブックマーク'
const description =
  '作品ページで「☆ 気になる」を押した作品の見放題終了日を、近い順にまとめて確認できます。配信が再開した作品もここでお知らせします。保存はお使いのブラウザの中だけで行われます。'
---

{/*
  ★ `title` には**ページ名だけ**を渡す。サイト名は BaseLayout が付ける。
    以前は `${title}｜${SITE.name}` を渡していて、<title> にサイト名が2回並んでいた
    （下のスクリプトが見出しを上書きしていたので、JSが動く環境では気づけなかった）。
*/}
<BaseLayout title={title} description={description} noindex>
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a> ›
  </nav>

  <h1>{title}</h1>

  {/*
    ★ **このページに戻ってきてもらうのが目的。**
      入れても戻る手段が無ければ、実測（9-4）の「Direct の再訪0件」は動かない。
    ★ 文言は運用者の指定（2026-09-22）。それまで置いていた説明文
      （並び順・赤の意味・💭 の場所）は外した。並びと色は一覧そのものが見せている。
  */}
  <p class="bookmark">見放題再開時に一覧が随時更新されます。ブックマークをしてご活用ください</p>

  {/*
    器だけ置く。**3つの状態を最初からHTMLに持たせ、JSは出し分けるだけ**にしてある。
    文言をスクリプトの文字列で組み立てると、直すときに探せなくなる。
  */}
  <div id="watchlist" data-state="loading">
    <p class="note" data-when="loading">読み込み中…</p>

    <p class="note" data-when="empty">
      まだ1本も入っていません。作品ページを開いて<strong>「☆ 気になる」</strong>を押すと、ここに並びます。
      <br />
      <a href="/leaving/netflix">Netflixで終了予定の作品を見る</a> ／
      <a href="/leaving/prime-video">Amazon Prime Videoで終了予定の作品を見る</a>
    </p>

    {/*
      ★ **「保存できない」と「1本も無い」を必ず分ける。**
        プライベートウィンドウでは「☆ 気になる」そのものが出ないので、
        ここで「空です」と言うと読者は自分が消したのだと思う。
    */}
    <p class="note" data-when="blocked">
      このブラウザではブックマークを保存できません。
      プライベートウィンドウや、サイトデータを保存しない設定になっていないかご確認ください。
    </p>

    {/*
      配信再開のお知らせ（2026-09-22）。**1件以上あるときだけ**スクリプトが出す。
      ★ `data-when` を付けないこと。付けると下の出し分けの `display: block` が
        `hidden` に勝ち、0件でも出る。
      ★ ヘッダーの💭の数字が赤いときに読者が探すのがこれ。一覧の先頭の緑の行と対になる。
    */}
    <p class="resumed-banner" hidden>
      <span class="banner-tag">配信再開</span>
      お知らせが<strong><span data-resumed-count></span>件</strong>あります。いちばん上に並べています。
    </p>

    <ul class="items" data-when="ready"></ul>

    <p class="asof" data-when="ready"></p>
  </div>
</BaseLayout>

<script>
  /**
   * ブックマークの読み出しと描画。
   *
   * ★ 鍵と保存の形は `components/WatchStar.astro` と**同じもの**。
   *   片方だけ変えると保存済みの作品が読めなくなる。必ず一緒に直すこと。
   */
  const KEY = 'mhr-watchlist-v1'
  /** 保存を変えたら投げる。ヘッダーの💭がこれを聞いて件数を塗り直す */
  const CHANGED = 'mhr-watchlist-change'

  /** 保存の形。`[題名, サービス名, 日付, 状態, 追加日時]` */
  type Item = [string, string, string, string, number]
  /** 配信再開の根拠（索引の5番目）。`[サービス名, 日付, 'log' | 'stock']` */
  type Resumed = [string, string, string]
  /** 索引の形（`pages/watchlist.json.ts`）。`[題名, サービス名, 日付, 状態, 配信再開?]` */
  type IndexRow = [string, string, string, string, Resumed?]

  const root = document.getElementById('watchlist')!
  const list = root.querySelector<HTMLUListElement>('.items')!
  const asOfLine = root.querySelector<HTMLElement>('.asof')!
  const banner = root.querySelector<HTMLElement>('.resumed-banner')!

  function read(): Record<string, Item> | null {
    try {
      const raw = localStorage.getItem(KEY)
      if (!raw) return {}
      const parsed = JSON.parse(raw) as unknown
      return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
        ? (parsed as Record<string, Item>)
        : {}
    } catch {
      return null
    }
  }

  function remove(id: string) {
    try {
      const cur = read()
      if (!cur) return
      delete cur[id]
      localStorage.setItem(KEY, JSON.stringify(cur))
      window.dispatchEvent(new Event(CHANGED))
    } catch {
      // 消せなくても描画側はもう消している。次の読み込みで戻るだけ
    }
  }

  /** JST の「きょう」。`YYYY-MM-DD` の比較で済ませる（時刻は持っていない）。 */
  function todayJst(): string {
    return new Date(Date.now() + 9 * 60 * 60_000).toISOString().slice(0, 10)
  }

  /** `YYYY-MM-DD` どうしの日数差。負なら過去。 */
  function daysUntil(date: string, today: string): number {
    const a = Date.parse(`${date}T00:00:00Z`)
    const b = Date.parse(`${today}T00:00:00Z`)
    if (Number.isNaN(a) || Number.isNaN(b)) return Number.NaN
    return Math.round((a - b) / 86_400_000)
  }

  function formatDate(date: string): string {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date)
    return m ? `${m[1]}年${Number(m[2])}月${Number(m[3])}日` : date
  }

  /**
   * 状態ごとの言い回し。
   *
   * ★ **`lib/works.ts` の `WorkState` と対応させること。** 状態が増えたらここにも足す。
   * ★ **「配信中」と書かない。** 当サイトが持っているのは変化の観測であって
   *   現在の在庫ではない（作品ページと同じ線引き）。
   */
  function phrase(state: string, date: string, days: number): { text: string; level: string } {
    if (state === 'leaving') {
      if (Number.isNaN(days)) return { text: `${formatDate(date)}に終了予定`, level: '' }
      if (days < 0) return { text: `${formatDate(date)}の終了予定日を過ぎました`, level: 'past' }
      if (days === 0) return { text: '今日が終了予定日', level: 'soon' }
      if (days <= 7) return { text: `あと${days}日（${formatDate(date)}に終了予定）`, level: 'soon' }
      return { text: `${formatDate(date)}に終了予定`, level: '' }
    }
    if (state === 'passed') return { text: `${formatDate(date)}の終了予定日を過ぎました`, level: 'past' }
    if (state === 'ended') return { text: `${formatDate(date)}に終了しました`, level: 'past' }
    if (state === 'started') return { text: `${formatDate(date)}に配信開始`, level: '' }
    return { text: formatDate(date), level: '' }
  }

  /**
   * 配信再開の言い回し。**根拠で言い分ける**（`lib/works.ts` の `Resumed`）。
   * ★ どちらも「配信中」と言い切らない。変化ログは「開始を確認」まで、
   *   在庫台帳は「◯日時点で対象でした」まで（作品ページと同じ線引き）。
   */
  function resumedPhrase([service, date, via]: Resumed): string {
    return via === 'stock'
      ? `${formatDate(date)}時点で${service}の見放題の対象でした`
      : `${formatDate(date)}に${service}で見放題配信の開始を確認`
  }

  function show(state: 'loading' | 'empty' | 'blocked' | 'ready') {
    root.dataset['state'] = state
  }

  async function render() {
    const store = read()
    if (!store) return show('blocked')

    const ids = Object.keys(store)
    if (ids.length === 0) return show('empty')

    /*
     * 索引で日付を上書きする。**取れなくても描く。**
     * 通信が失敗したときに真っ白になるより、
     * 付けた時点の写しで出して「情報が古いかもしれない」ほうがよい。
     */
    let index: Record<string, IndexRow> = {}
    let asOf = ''
    try {
      const res = await fetch('/watchlist.json')
      if (res.ok) {
        const json = (await res.json()) as { asOf?: string; works?: Record<string, IndexRow> }
        index = json.works ?? {}
        asOf = json.asOf ?? ''
      }
    } catch {
      // 圏外・ブロッカー。写しで描く
    }

    const today = todayJst()
    const rows = ids
      .map((id) => {
        const saved = store[id]!
        const fresh = index[id]
        // ★ 索引にあれば**必ず索引を採る**。終了予定日は後から動く
        const [title, service, date, state] = fresh ?? saved
        // ★ 再開の根拠は索引にしか無い（保存した写しには持たせていない）
        const resumed = fresh?.[4]
        return { id, title, service, date, state, resumed, days: daysUntil(date, today) }
      })
      /*
       * 並び。**「まだ間に合うもの」が先、「もう終わったもの」が後。**
       *
       * ★ 日数の昇順だけで並べないこと。終了済み（days が負）が
       *   いちばん上に来て、**急ぎの作品が下に埋まる**（2026-09-18 に実際にそうなった）。
       *   読者がこの面に来る用は「次に何が消えるか」なので、
       *   過ぎたものは下に送る。
       *
       *   ⓪ 配信再開 … **いちばん上**（作品ページで約束した「お知らせ」がこれ。2026-09-22）
       *   ① これから終了するもの … 近い順（あと1日 → あと5日 → …）
       *   ② 過ぎた・終了した・配信開始 … 新しい順（最近のできごとが上）
       * ★ 日付が読めない行は最後（索引にも写しにも無い壊れた値）。
       */
      .sort((a, b) => {
        if (Boolean(a.resumed) !== Boolean(b.resumed)) return a.resumed ? -1 : 1
        if (a.resumed && b.resumed) {
          // 再開どうしは新しい知らせが上
          return b.resumed[1].localeCompare(a.resumed[1]) || a.title.localeCompare(b.title, 'ja')
        }
        const rank = (d: number) => (Number.isNaN(d) ? 2 : d >= 0 ? 0 : 1)
        const ra = rank(a.days)
        const rb = rank(b.days)
        if (ra !== rb) return ra - rb
        if (ra === 2) return a.title.localeCompare(b.title, 'ja')
        // ①は昇順（近い順）、②は降順（新しい順）
        return (ra === 0 ? a.days - b.days : b.days - a.days) || a.title.localeCompare(b.title, 'ja')
      })

    list.replaceChildren(
      ...rows.map((r) => {
        const { text, level } = phrase(r.state, r.date, r.days)
        const li = document.createElement('li')
        li.className = 'item'
        // ★ 再開した行は赤（終了間近）にしない。急がせる知らせではない
        if (r.resumed) li.dataset['level'] = 'resumed'
        else if (level) li.dataset['level'] = level

        /*
         * ポスターはIDから組み立てる（索引に入れると全体が数倍になる）。
         * ★ 無い作品があるので、読み込みに失敗したら枠ごと消す。
         */
        const img = document.createElement('img')
        img.className = 'poster'
        img.src = `/posters/${r.id}.webp`
        img.alt = ''
        img.loading = 'lazy'
        img.width = 46
        img.height = 69
        img.addEventListener('error', () => img.remove())

        const body = document.createElement('div')
        body.className = 'body'

        const a = document.createElement('a')
        a.className = 'title'
        a.href = `/works/${r.id}`
        a.textContent = r.title

        const meta = document.createElement('p')
        meta.className = 'meta'
        meta.textContent = `${r.service}｜${text}`

        /*
         * ★ 再開の知らせは**元の行の上に別の1行で**出す。元の「◯日に終了しました」は消さない
         *   （どのサービスで終わって、どこで戻ったのかを両方読めるように）。
         *   「配信再開」の札は文字で書く（色だけで伝えない）。
         */
        if (r.resumed) {
          const news = document.createElement('p')
          news.className = 'news'
          const tag = document.createElement('span')
          tag.className = 'tag'
          tag.textContent = '配信再開'
          news.append(tag, resumedPhrase(r.resumed))
          body.append(a, news, meta)
        } else {
          body.append(a, meta)
        }

        const del = document.createElement('button')
        del.className = 'remove'
        del.type = 'button'
        del.textContent = '外す'
        del.setAttribute('aria-label', `${r.title} をブックマークから外す`)
        del.addEventListener('click', () => {
          remove(r.id)
          li.remove()
          /*
           * ★ 残りは `live` で持つ。`rows.filter(x => x.id !== r.id)` だと、
           *   2本目を外したときに1本目が数に戻ってくる（見出しと知らせの件数がずれる）。
           */
          live = live.filter((x) => x.id !== r.id)
          if (live.length === 0) show('empty')
          summarize(live)
        })

        li.append(img, body, del)
        return li
      }),
    )

    asOfLine.textContent = asOf
      ? `配信情報は ${formatDate(asOf)} 時点のものです。終了予定日は変更されることがあります。`
      : '配信情報を取得できませんでした。「気になる」を押した時点の内容を表示しています。'

    show('ready')
    live = rows
    summarize(rows)
  }

  /** いま画面に残っている行（「外す」で減る）。見出しと知らせの件数はこれから数える */
  let live: { id: string; days: number; state: string; resumed?: Resumed }[] = []

  /**
   * ★ **タブの見出しに「配信再開◯件」「あと何件が今週終了」を出す**（2026-09-18・再開は 09-22）。
   *
   * このサイトが読者に通知を送る手段はこれしかない（メールもプッシュも持たない）。
   * ブラウザのブックマークから開いたとき・タブを開いたままのときに、
   * **一覧を読まなくても知らせがあるか分かる**のが狙い。
   *
   * ★ 件数が0なら素の見出しに戻すこと。「0件」と出し続けると
   *   読者はこの数字を見なくなる。
   * ★ 素の見出しはページが持っている `<title>` を使う（サイト名をここに書き写さない）。
   * ★ 一覧の上の「配信再開のお知らせ」の件数もここで合わせる（同じ数を2か所で数えない）。
   */
  const baseTitle = document.title
  function summarize(rows: { days: number; state: string; resumed?: Resumed }[]) {
    const resumed = rows.filter((r) => r.resumed).length
    banner.querySelector('[data-resumed-count]')!.textContent = String(resumed)
    banner.hidden = resumed === 0
    const soon = rows.filter(
      (r) =>
        !r.resumed && r.state === 'leaving' && !Number.isNaN(r.days) && r.days >= 0 && r.days <= 7,
    ).length
    const marks = [resumed > 0 ? `配信再開${resumed}件` : '', soon > 0 ? `あと${soon}件` : '']
      .filter(Boolean)
      .join('・')
    document.title = marks ? `【${marks}】${baseTitle}` : baseTitle
  }

  void render()
</script>

<style>
  .bookmark {
    margin: 0.4rem 0 1.4rem;
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-subtle);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  /*
   * 出し分け。**HTMLには3つとも書いてあり、状態で1つだけ見せる。**
   * ★ 既定では全部隠す。`data-state` が付いていない（JSが動かない）環境では
   *   「読み込み中…」だけが残る作りにしない — 何も出ないほうが正しい。
   */
  #watchlist > [data-when] {
    display: none;
  }
  #watchlist[data-state='loading'] [data-when='loading'],
  #watchlist[data-state='empty'] [data-when='empty'],
  #watchlist[data-state='blocked'] [data-when='blocked'],
  #watchlist[data-state='ready'] [data-when='ready'] {
    display: block;
  }
  .note {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-subtle);
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--text-muted);
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  /*
   * ★★ **ここから下は必ず `.items :global(...)` で書くこと。**（2026-09-18）
   *
   * 行は**スクリプトが `document.createElement` で作っている。**
   * Astro のスコープ付きCSSは、**ビルド時にテンプレートへ `data-astro-cid-…` を
   * 付ける**ことで効かせる仕組みなので、実行時に作った要素にはその印が付かない。
   * `.item { display: flex }` と素で書くと**1行も当たらず**、
   * ポスター・題名・「外す」が縦に積み上がる（初版で実際にそうなった）。
   *
   * 親の `.items` はテンプレートにあるので印が付く。
   * そこから `:global()` で降りれば、**このページの中だけ**に閉じたまま当たる。
   * ★ `is:global` でスタイルブロックごと開けないこと。`.title` `.body` `.meta` は
   *   ありふれた名前で、サイト全体に漏らすと他の面を壊す。
   */
  .items :global(.item) {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0.9rem;
    background: var(--bg);
  }
  .items :global(.item + .item) {
    border-top: 1px solid var(--border);
  }

  .items :global(.poster) {
    flex: none;
    width: 46px;
    height: 69px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--bg-subtle);
  }
  .items :global(.body) {
    flex: 1;
    min-width: 0;
  }
  .items :global(.title) {
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    text-decoration: none;
  }
  .items :global(.title:hover) {
    color: var(--accent);
    text-decoration: underline;
  }
  .items :global(.meta) {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /*
   * ★ **終了7日前を赤く**（docs/GROWTH.md 3-6）。
   *   色だけで伝えないこと — 文面が「あと3日（…に終了予定）」と
   *   日数を先に言う形になっているので、モノクロでも順序と急ぎが読める。
   */
