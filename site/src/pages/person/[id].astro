---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AffiliateNotice from '../../components/AffiliateNotice.astro'
import AmazonCta from '../../components/AmazonCta.astro'
import { ATTRIBUTION } from '../../config'
import { personPage, publishablePeople } from '../../lib/people'
import type { Person } from '../../lib/people'
import { STATE_CATEGORY, STATE_LABEL } from '../../lib/works'
import { formatDate, isoDate } from '../../utils/date'

/**
 * 人物ページ `/person/<id>`。
 *
 * ■ 何のためにあるか（docs/GROWTH.md 3-3 ／ docs/STOCK.md S-3）
 * **劣化しないストック。** 作品ページは終了日が過ぎるたびに「終了済み」へ倒れるが、
 * 「誰が撮ったか・誰が出ているか」は変わらない。
 * 作品ページを人物で束ね直すだけで、内部リンクの受け皿がもう1層できる。
 *
 * ■ LLMを使わない
 * 作品ページと同じ。出すのは名前・作品・日付・状態だけで、
 * **文言はすべてデータから組み立てる。** 人物の紹介文は書かない
 * （書けるだけの材料を持っていないし、書けばビルドのたびに古くなる）。
 *
 * ■ 絶対に守ること
 * **「配信中」と書かない。** 状態の言い回しは lib/works.ts の `WorkState` の表に従う。
 * ここで新しい言い方を作らない。
 */
export function getStaticPaths() {
  return publishablePeople().map((p) => ({ params: { id: p.id }, props: { person: p } }))
}

interface Props {
  person: Person
}

const { person } = Astro.props as Props
const p = person ?? personPage(Astro.params.id!)!

/*
 * h1。**名前だけにしない。**
 * 名前だけの見出しは Wikipedia・各サービスの俳優ページと同じ的を撃つ。
 * 当サイトが答えられるのは「その人の作品がいつまで観られるか」なので、
 * 終了予定を持っているかどうかで見出しを変える（作品ページと同じ考え方）。
 */
const title =
  p.leavingCount > 0
    ? `${p.name}の作品はいつまで見られる？`
    : `${p.name}の作品の見放題配信`

/*
 * 冒頭の1文に出す「何の作品か」。**役割を名前のすぐ後ろに置く。**
 * 「トム・クルーズ出演作品」「小津安二郎監督作品」のように、
 * 読者が探している言い方（〇〇 出演作品／〇〇 監督作品）に合わせる。
 *
 * ★ 兼ねている人だけ「の」を挟む（「〇〇の監督・出演作品」）。
 *   挟まないと「〇〇監督・出演作品」となり、監督作品だけのように読める。
 */
const worksPhrase =
  p.directedCount > 0 && p.castCount > 0
    ? `${p.name}の監督・出演作品`
    : p.directedCount > 0
      ? `${p.name}監督作品`
      : `${p.name}出演作品`

/**
 * 兼ねている人だけ内訳を出す。片方だけの人には同じ数字を2回書かない。
 *
 * ★ 頭に「うち」を付ける。**同じ作品で監督と出演を兼ねることがある**ので、
 *   内訳の合計は総数を超えうる（例: 3本の全部で監督・うち2本に出演 →
 *   「3本です（うち監督3本・出演2本）」）。「うち」が無いと数え違いに見える。
 */
const roleBreakdown =
  p.directedCount > 0 && p.castCount > 0
    ? `うち監督${p.directedCount}本・出演${p.castCount}本`
    : ''

const description = p.nextLeaving
  ? `${worksPhrase}${p.works.length}本の見放題配信をまとめています。${p.leavingCount}本に終了予定があり、最も近いのは${formatDate(p.nextLeaving.at)}の「${p.nextLeaving.title}」（${p.nextLeaving.serviceLabel}）です。`
  : `${worksPhrase}${p.works.length}本について、当サイトが観測した見放題配信の開始・終了をまとめています。`

/** 関わり方の表示。両方あるときは「監督・出演」 */
function roleLabel(roles: readonly ('director' | 'cast')[]): string {
  return roles
    .slice()
    .sort()
    .map((r) => (r === 'director' ? '監督' : '出演'))
    .reverse()
    .join('・')
}

/*
 * ページ全体の状態。**いちばん行動が要る作品に合わせる。**
 * Amazon への導線の文面がこれで変わる（終了済みの人に「見放題で探す」と出さない）。
 */
const headState = p.works[0]!.work.state

// --- 構造化データ --------------------------------------------------------------

/*
 * ★ 名前しか出さない。生年・出身地・別名は**持っていない**。
 *   画面に出していないものを構造化データにだけ入れないこと（作品ページと同じ規律）。
 *   Wikidata の QID を収集するようになったら `sameAs` を足せる。
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a> ›
    <a href="/person">監督・出演者</a>
  </nav>

  <h1>{title}</h1>

  <AffiliateNotice />

  {/*
    冒頭。**1文で本数を言い切り、細かい数字は箇条書きに落とす**（2026-08-30）。
    1つの文に本数・内訳・終了予定・最も近い日付を全部入れると、
    いちばん大事な「あと何本、いつまで」が文の中に埋もれる。
  */}
  <p class="lead">
    当サイトが配信状況を把握している{worksPhrase}は<strong>{p.works.length}本</strong>です
    {roleBreakdown && <>（{roleBreakdown}）</>}。
  </p>

  <ul class="summary">
    <li>
      見放題の終了予定：
      {p.leavingCount > 0 ? <strong>{p.leavingCount}本</strong> : <>現在ありません</>}
    </li>
    {
      p.nextLeaving && (
        <li>
          最も近い終了作品：
          <time datetime={isoDate(p.nextLeaving.at)}>{formatDate(p.nextLeaving.at)}</time>
          「{p.nextLeaving.title}」（{p.nextLeaving.serviceLabel}）
        </li>
      )
    }
  </ul>

  <section class="works">
    <h2>作品の配信状況</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">作品</th>
            <th scope="col">公開年</th>
            <th scope="col">関わり</th>
            <th scope="col">配信状況</th>
          </tr>
        </thead>
        <tbody>
          {
            p.works.map((x) => {
              const s = x.work.services[0]!
              return (
                <tr>
                  <th scope="row">
                    {/* 内部リンク。rel も target も付けない */}
                    <a href={`/works/${x.work.id}`}>{x.work.title}</a>
                  </th>
                  <td>{x.work.year ? `${x.work.year}年` : '—'}</td>
                  <td>{roleLabel(x.roles)}</td>
                  <td class="state">
                    <span class="badge" data-category={STATE_CATEGORY[x.work.state]}>
                      {STATE_LABEL[x.work.state]}
                    </span>
                    <span class="when">
                      {s.label}・<time datetime={isoDate(s.at)}>{formatDate(s.at)}</time>
                    </span>
                  </td>
                </tr>
              )
            })
          }
        </tbody>
      </table>
    </div>
    <p class="note">
      配信状況は変わります。各作品のページに、当サイトが観測した記録と各サービスの確認先があります。
    </p>
  </section>

  <AmazonCta category={STATE_CATEGORY[headState]} query={p.name} />

  <p class="related">
    <a href="/person">監督・出演者の一覧</a>
  </p>

  <section class="sources">
    <h2>出典</h2>
    <ul>
      <li>
        <a href={ATTRIBUTION.url} rel="noopener noreferrer" target="_blank">{ATTRIBUTION.text}</a>
      </li>
      <li>
        <a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank">
          監督・出演・作品タイトル（Wikidata・CC0）
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    margin: 1.4rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .lead {
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  /*
   * 冒頭の数字。**本文より少し小さく、行間を詰める。**
   * 読者がここで見るのは「あと何本・いつまで」の2点だけなので、
   * 表に入る前に目で拾えるようにする。
   */
  .summary {
    margin: 0 0 1.4rem;
    padding-left: 1.2rem;
    font-size: 0.92rem;
    line-height: 1.9;
  }
  .works h2,
  .sources h2 {
    font-size: 1rem;
  }
  /* 表は横に伸びる。はみ出したら表ごと横スクロール（WorkTable.astro と同じ扱い） */
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  th,
  td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }
  thead th {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  tbody th {
    font-weight: 600;
    /* 余った幅は全部作品名に渡す。他の列は中身の幅しか要らない */
    width: 100%;
    white-space: normal;
  }
  /* バッジと日付は縦に積む。横に並べると狭い画面で表が伸びる */
  .state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }
  .when {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .note {
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
  .sources ul {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
</style>
