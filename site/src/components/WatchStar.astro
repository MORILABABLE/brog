---
import { isoDate } from '../utils/date'
import { promisesResume } from '../lib/works'
import type { WorkPage } from '../lib/works'

/**
 * 作品ページの「☆ 気になる」。**ブックマーク一覧（`/watchlist`）に入れる唯一の入口。**
 *
 * ■ 何のための機能か
 * 実測（docs/FUNNEL.md 9-4）で、**ブックマーク経由の再訪は28日で0件**だった。
 * 再訪26件は全部が再検索で、**URLを覚えて戻ってきた読者は1人もいない。**
 * サイトのタグライン「消える前に、気づける。」に対して、
 * **気づかせる仕掛けがこれまで1つも無かった。**
 *
 * ■ 2026-09-22 から全作品で押せる（運用者の指定）
 * 9-21 に一度止めた。そのときの約束は「終了日が近づいたときに気づける」の1つだけで、
 * 終了日がこれから来る作品は678件中84件しか無かったため。
 * 戻すにあたって**約束を2つに分けた。**
 *   - 押すこと自体 … どの作品でも「気になる作品を手元に控える」ためにできる
 *   - 「※配信再開時はブックマーク一覧でお知らせします」… **約束できる作品にだけ**添える
 *     （終了日がこれから来る／終わっていて、把握している社のどこにも見放題が無い）。
 *     判定は `lib/works.ts` の `promisesResume()`、守る側は同じファイルの `resumedOn()`。
 * 押したあとは、どの作品でも「トップページの「ブックマーク」タブで一覧を確認できます」に変わる
 * （文言は運用者の指定。フッターの「ブックマーク」とヘッダーの💭が一覧への入口）。
 *
 * ■ 読者の情報をこちら側に持たない
 * 保存先は `localStorage` だけ。サーバも cookie も使わない（docs/GROWTH.md 3-6）。
 * ★ **GA4 に送るのは「押した／外した」の回数だけ**（`watch_add` / `watch_remove`・2026-09-26 追加）。
 *   作品IDも一覧の中身も送らない（どのページで押されたかは GA4 が全イベントに付けるページのURLで分かる）。
 *   GA4 はプライバシーポリシーの「アクセス解析ツールについて」に書いてあり、項目を足す必要はない。
 *   入れた理由: Web Push（終了前の通知）を作る前に、**何人が押しているか**を知るため。
 *   保存が localStorage だけなので、それまで押した人数を知る手段が1つも無かった。
 *
 * ★ **保存するのは作品IDと、付けた時点の写し。**
 *   写しは `/watchlist.json` に無かったとき（掲載を外れた作品）の保険で、
 *   **日付は必ず索引の新しい方で上書きされる**（終了予定日は後から動くため）。
 *
 * ★ **`localStorage` は読めないことがある**（プライベートウィンドウ、
 *   サイトデータの拒否、iOS の設定）。**必ず try/catch で包み、
 *   読めなければボタンも案内も出さない**（押しても保存されないボタンと、
 *   守れない「お知らせします」のほうが害が大きい）。
 *
 * ■ JS をここと `/watchlist` に閉じ込める
 * サイトは基本 JS ゼロで作られている（docs/GROWTH.md 3-6）。
 * **一覧ページと記事ページにスクリプトを増やさないこと。**
 * この部品は作品ページからしか呼ばない。
 *
 * ★ **止めるフラグはこの部品の中に置かないこと**（`pages/works/[id].astro` の `SHOW_STAR`）。
 *   ここで `{ false && ... }` にしても**下の `<script>` は678ページに残る** — 実測した。
 *   Astro はテンプレートの `<script>` を**描画の条件と無関係に**そのページへ入れるので、
 *   JS まで消すには**呼び出しごと止める**しかない。
 */
interface Props {
  work: WorkPage
}

const { work: w } = Astro.props
const head = w.services[0]

/*
 * ★ 状態の分からない作品には出さない。
 *   ブックマーク一覧は「いつ消えるか」を並べる面なので、
 *   日付を持たない行を入れると並び順が決まらない。
 */
const snapshot = head
  ? JSON.stringify([w.title, head.label, isoDate(head.at), head.state])
  : null

const promise = snapshot ? promisesResume(w) : false
---

{
  snapshot && (
    /*
      ★ `hidden` を付けたまま出す。**JSが動いて保存できる環境でだけ見せる。**
        押しても何も起きないボタンが残るより、出ないほうがよい
        （FollowBar.astro と同じ判断）。「お知らせします」も同じ枠に入れてあるので一緒に隠れる。
    */
    <div class="watch" data-work-id={w.id} data-snapshot={snapshot} hidden>
      <button class="star" type="button" aria-pressed="false">
        <span class="mark" aria-hidden="true">☆</span>
        <span class="label">気になる</span>
      </button>
      {/*
        押す前と押したあとで入れ替わる1行。**両方をHTMLに書いておき、JSは出し分けるだけ。**
        ★ 押す前の行は約束できる作品にだけある（上の `promise`）。無い作品では押す前は何も出ない。
      */}
      {promise && <p class="note" data-when="off">※配信再開時はブックマーク一覧でお知らせします</p>}
      <p class="note" data-when="on" hidden>
        トップページの「<a href="/watchlist">ブックマーク</a>」タブで一覧を確認できます
      </p>
    </div>
  )
}

<script>
  /**
   * 保存と解除。**このファイルと `/watchlist` 以外に同じ読み書きを書かないこと。**
   * 鍵と形を変えるときは両方を必ず一緒に直す（片方だけだと保存済みの作品が消える）。
   * ヘッダーは件数を数えるだけ（components/Header.astro）。
   */
  const KEY = 'mhr-watchlist-v1'
  /** 保存を変えたら投げる。ヘッダーの💭がこれを聞いて件数を塗り直す */
  const CHANGED = 'mhr-watchlist-change'

  /** 保存の形。`{ "<作品ID>": [題名, サービス名, 日付, 状態, 追加日時] }` */
  type Item = [string, string, string, string, number]
  type Store = Record<string, Item>

  /**
   * ★ **読めないことがある。** 読めなければ「空」ではなく **null** を返す。
   *   空と区別できないと、読めない環境で押したときに
   *   「保存できたように見えて消える」状態になる。
   */
  function read(): Store | null {
    try {
      const raw = localStorage.getItem(KEY)
      if (!raw) return {}
      const parsed = JSON.parse(raw) as unknown
      // 壊れた値が入っていても落ちないようにする（手で触られることがある）
      return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
        ? (parsed as Store)
        : {}
    } catch {
      return null
    }
  }

  function write(store: Store): boolean {
    try {
      localStorage.setItem(KEY, JSON.stringify(store))
      return true
    } catch {
      // 容量超過・書き込み拒否。**押した見た目だけ変えて実際は保存されない、を避ける**
      return false
    }
  }

  const box = document.querySelector<HTMLElement>('.watch')
  const store = read()

  // 読めない環境では枠ごと出さない（hidden のまま）
  if (box && store) {
    const id = box.dataset['workId']!
    const snapshot = JSON.parse(box.dataset['snapshot']!) as [string, string, string, string]
    const button = box.querySelector<HTMLButtonElement>('.star')!
    const mark = button.querySelector<HTMLElement>('.mark')!
    const notes = Array.from(box.querySelectorAll<HTMLElement>('.note'))

    /*
     * ★ 押したかどうかは**☆/★の字形と塗りの両方**で見せる（色だけに頼らない）。
     *   文言（気になる）は変えない — 押した読者に「何を押したか」が分からなくなるため。
     * ★ 案内の行は状態に合わせて入れ替える。外したら押す前の行に戻す
     *   （押したあとの「一覧を確認できます」を、外した読者に出し続けない）。
     */
    const paint = (on: boolean) => {
      button.setAttribute('aria-pressed', String(on))
      mark.textContent = on ? '★' : '☆'
      for (const n of notes) n.hidden = n.dataset['when'] !== (on ? 'on' : 'off')
    }

    paint(id in store)
    box.hidden = false

    button.addEventListener('click', () => {
      const current = read()
      if (!current) return
      const on = id in current
      if (on) {
        delete current[id]
      } else {
        current[id] = [...snapshot, Date.now()]
      }
      if (!write(current)) return
      paint(!on)
      window.dispatchEvent(new Event(CHANGED))
      /*
       * ★ **保存できたときだけ送る**（上の `return` のあと）。送ってから失敗すると、押した数が水増しされる。
       * ★ イベント名に `-` を使わない（GA4 は英数字と `_` だけ。BaseLayout の `aff_` と同じ）。
       * ★ `gtag` は BaseLayout がグローバルに置く。開発環境では送信を止めてあるだけで関数はある。
       */
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag
      gtag?.('event', on ? 'watch_remove' : 'watch_add')
    })
  }
</script>

<style>
  /*
   * ボタンと案内を1行に並べ、入らなければ案内が下へ折り返す
   * （広い画面では横並び、スマホでは2行）。
   */
  .watch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.8rem;
    margin: 0.9rem 0 0;
  }
  .watch[hidden] {
    display: none;
  }

  .star {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
  }
  .star:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /*
   * 押された状態。**色だけで区別しない** — ☆→★ の字形も変わる
   * （色覚特性と、モノクロ表示の両方への配慮）。
   */
  .star[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }
  .mark {
    font-size: 1rem;
    color: var(--accent);
  }
  .star[aria-pressed='true'] .mark {
    color: #fff;
  }

  .note {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .note[hidden] {
    display: none;
  }
</style>
