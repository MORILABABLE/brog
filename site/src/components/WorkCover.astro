---
/**
 * 作品ページの小さいポスター（64px）。`pages/works/[id].astro` の2か所から使う。
 *
 *   リンクあり … Prime Video の状態行の枠の中、バッジの左
 *   リンクなし … 状態行の枠の外、左（Prime Video の行が無い作品はすべてこちら）
 *
 * 置き場所とリンクの判定はページ側（`lib/works.ts` の `coverLink()`）。ここは描くだけ。
 *
 * ★ リンクのときだけ「Prime Video」の小さな文字を添える。絵だけだと、
 *   押すと Amazon に着くことが押す前に分からない。
 * ★ 枠は `cover`。**`data-slot` とトラッキングIDを必ず揃えること**（ページ側で tag= を付けて渡す）。
 */
interface Props {
  src: string
  link?: { url: string; rel: string; name: string }
}

const { src, link } = Astro.props
---

{
  link ? (
    <a
      class="cover"
      href={link.url}
      rel={link.rel}
      target="_blank"
      data-slot="cover"
      aria-label={link.name}
    >
      <img src={src} alt="" width="64" height="96" decoding="async" />
      <span class="cover-caption">Prime Video</span>
    </a>
  ) : (
    <span class="cover">
      <img src={src} alt="" width="64" height="96" decoding="async" />
    </span>
  )
}

<style>
  /* ★ スマホ（本文幅 約340px）で隣の文を細らせすぎないよう、64px に抑える */
  .cover {
    flex: none;
    display: block;
    width: 64px;
    text-decoration: none;
  }
  .cover img {
    display: block;
    width: 64px;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .cover-caption {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
    color: var(--text-muted);
  }
  a.cover:hover img {
    opacity: 0.9;
  }
</style>
