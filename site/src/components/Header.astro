---
import { getCollection } from 'astro:content'
import { ARCHIVE, SITE, CATEGORY_HUBS, SERVICE_HUBS } from '../config'
import { archiveMonths } from '../lib/archive'
import PostSearch from './PostSearch.astro'
import BookmarkIcon from './BookmarkIcon.astro'
import { hubServiceHref } from '../lib/evergreen'
import { resumedWorkIds } from '../lib/works'

/**
 * ★ メニューは CATEGORIES ではなく **CATEGORY_HUBS** から作る。
 *   カテゴリは4つあるが、読者に見せる入口は3つ（2026-08-26）。
 *   「配信終了予定」と「終了済み」を1つの入口にまとめてある。理由は config.ts。
 *
 * ■ 2段のメニュー（2026-08-27）
 * `serviceMenu: true` のハブ（配信終了済み・予定／新着配信）は、
 * **押すとサービス名が開く**。選ぶと `/category/<ハブ>/<サービス>` へ飛ぶ。
 * ★ **行き先は5社とも記事の一覧**（2026-09-18・運用者の指定）。この2つのハブは
 *   過去記事の一覧の入口で、カレンダーの入口ではない（カレンダーは左の枠とトップのカードが持つ）。
 *   2026-09-17 の1日だけ、カレンダーのある社を `/leaving/<サービス>` へ直接飛ばしていた。
 *   行き先の決め方は lib/evergreen.ts の `hubServiceHref`。
 * 読者は「終了まわりを見たい」の次に必ず「どのサービスか」を選ぶので、
 * その2手目をメニューの中で済ませる。
 * 開いた先の一番上に「すべて見る」を置いてあるので、
 * **ハブ全体の一覧（従来の行き先）にもメニューから入れる。**
 *
 * ★ `<details>` で作ってある。JavaScript が無くても開閉できる。
 *   下のスクリプトが足しているのは「他のメニューを閉じる」「外を押したら閉じる」
 *   「Escで閉じる」だけで、**無くてもメニューとして成立する。**
 *
 * ■ 「月別まとめ」は**別枠**（2026-09-05。それまでは「監督・出演者」だった）
 * カテゴリ×サービスの2段メニューとは軸が違う（何が起きたか／いつの話か）ので、
 * ハブの並びに混ぜず、右端に独立した枠として置く。
 * 開くと**新しい月から順に並ぶ**ので、押した先が「9月の配信まとめ」になる。
 *
 * ★ **「監督・出演者」をここから外した。** 記事はほぼすべてが月次なのに
 *   月で辿る道が1本も無く、枠1つぶんの価値はこちらのほうが高いと判断した
 *   （理由は config.ts の ARCHIVE）。人物ページへの入口は
 *   **フッター（Footer.astro）が持つ。** 左の枠（LeftRail.astro）にもあったが、
 *   2026-09-17 に出すのをやめた（`SHOW_PEOPLE`）。**フッターの行を消さないこと**
 *   （消すと作品ページの人名リンク以外から人物ページへ入れなくなる）。
 *
 * ■ 並びは**すべて左詰めの1行**（2026-08-30 に変更）
 * サイト名 → メニュー → 検索窓 の順に左から詰める。
 *
 * ★ **1行に収まる幅で作ること。** 以前はサイト名を左、メニューと検索窓を右に
 *   離していたが、4つ目のメニューを足した時点で合計幅が行を超え、
 *   **検索窓だけが2行目に落ちた**（1行に収まる保証が無い作りだった）。
 *
 *   ヘッダーの中身に使える幅は 46rem − 左右padding = **約699px**。内訳の実測見積り:
 *     サイト名（1.1rem・7文字）        約123px
 *     メニュー4つ＋印＋間隔（0.7rem）  約400px
 *     3つの間隔（1rem × 2）             32px
 *     → 検索窓に残るのは約144px
 *   検索窓の幅（PostSearch.astro の flex-basis）は **7.5rem = 120px**。
 *   合計 683px で、**約16pxの余裕**がある（ブラウザで実測・2026-08-30）。
 *   **メニューを1つ増やすときは、この計算をやり直すこと。**
 *   確かめ方は 780px 以上でヘッダーを見て、検索窓が2行目に落ちていないこと。
 *
 *   ★ 4つ目を「監督・出演者」（6文字）から「月別まとめ」（5文字）に替えたので、
 *     この見積りより**狭くなっている**。余裕は増える方向。
 *
 *   ★ **行の右端にブックマークの💭（幅34px）が常に出る**（2026-09-22）。
 *     実測（2026-09-22）ではメニューは3つ（312px）で、検索窓の右に約110pxの空きがあった。
 *     💭 を足しても1行に収まる。**メニューを足すときは💭のぶんも数えること。**
 *     スマホ（47rem 未満）は1行目がサイト名・検索窓・💭 で、360px 未満だけ間隔を詰めてある（末尾の @media）。

/**
 * **記事が1本も無いハブはメニューに出さない**（2026-08-31）。
 *
 * ランキングは器だけ先に作ってあり、記事は0本のままだった。
 * その状態で全706ページのヘッダーからリンクしていたので、
 * 押した読者は必ず「この分類の記事はまだありません。」に着いていた。
 * サイト内で唯一の空ページで、しかも**全ページから貼られている**という
 * いちばん目立つ形になっていた（ASP・AdSense の審査でも真っ先に踏まれる）。
 *
 * ★ 記事を1本入れれば自動でメニューに戻る。config.ts の CATEGORY_HUBS は
 *   触らない。「記事が出ないものは並べない」は SERVICE_HUBS と同じ方針
 *   （config.ts の Hulu を外した件）。
 *
 * ★ ページ自体は生成し続ける（`/category/<ハブ>` を 404 にしない）。
 *   空のあいだは pages/category/[category].astro が noindex にする。
 */
const posts = await getCollection('posts', ({ data }) => !data.draft)

const hubs = CATEGORY_HUBS.filter((h) =>
  posts.some((p) => (h.includes as readonly string[]).includes(p.data.category)),
)

/**
 * メニューに出す月。**新しい順**。全部への経路は「すべて見る」が持つ。
 *
 * ★ 月を名乗らない記事（シリーズ）は数に入らない（lib/archive.ts の `monthOf`）。
 * ★ 月が1つも無ければ枠ごと出さない。**押した先が空のページになる形を作らない**
 *   （記事が0本のハブをメニューから外したのと同じ方針・2026-08-31）。
 */
const months = archiveMonths(posts)
const menuMonths = months.slice(0, ARCHIVE.menuMonths)

/**
 * 配信再開の作品ID（空白区切り）。**💭 の数字を赤くするかどうか**をブラウザ側で決めるのに使う。
 *
 * ★ 読者のブックマークはブラウザにしか無いので、ビルドでは決められない。
 *   そこで「再開した作品の一覧」だけを全ページに持たせ、突き合わせはスクリプトがする。
 *   索引（`/watchlist.json`・約42KB）を全ページで読みに行かないための形（追加の通信なし）。
 * ★ 集合は一覧の「配信再開」と同じ関数（`lib/works.ts` の `resumedWorkIds()`）。
 */
const resumedIds = resumedWorkIds().join(' ')
---

<header>
  <div class="wrap inner">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="カテゴリ">
      {
        hubs.map((h) =>
          h.serviceMenu ? (
            <details class="menu" data-menu>
              <summary>{h.label}</summary>
              <div class="panel">
                {/* ハブ全体の一覧。サービスを選ばない読者の行き先を残す */}
                <a class="panel-all" href={`/category/${h.slug}`}>
                  {h.label}をすべて見る
                </a>
                <ul>
                  {SERVICE_HUBS.map((s) => (
                    <li>
                      <a href={hubServiceHref(h.slug, s.slug)}>{s.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ) : (
            <a class="plain" href={`/category/${h.slug}`}>
              {h.label}
            </a>
          ),
        )
      }
      {/*
        ★ カテゴリのハブとは**別枠**。軸が「いつの話か」なのでサービスでは割らない
          （サービスで絞るのは月を選んだ次の手・pages/archive/[month].astro）。
          全部への経路は「すべて見る」が持つ。
      */}
      {
        menuMonths.length > 0 && (
          <details class="menu" data-menu>
            <summary>{ARCHIVE.label}</summary>
            <div class="panel">
              <a class="panel-all" href={ARCHIVE.base}>
                {ARCHIVE.label}をすべて見る（{months.length}か月）
              </a>
              <ul>
                {menuMonths.map((m) => (
                  <li>
                    <a href={`${ARCHIVE.base}/${m.month}`}>{m.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )
      }
    </nav>
    {/* JavaScript が動かない環境では、この枠ごと出ない */}
    <PostSearch />
    {/*
      ★ **ブックマーク（💭＋件数）。💭 は全員に常に出し、数字は1件以上のときだけ付ける**
        （2026-09-22・運用者の指定）。それまではメニューの末尾に「ウォッチリスト 3」と文字で、
        入れた読者にだけ出していた。

      ■ なぜヘッダーの右端なのか
      「スマホでもPCでも常に見える」が要件。ヘッダーは sticky なので、ここに置けば
      スクロールしても画面上端に残る。**画面下は置かない** — 将来 AdSense のアンカー広告と
      追従枠（FollowBar.astro）が使う場所で、重なる。
      `margin-left: auto` で行の右端に寄せる。スマホではサイト名・検索窓と同じ1行目の右端になる。

      ■ なぜ0件でも出すのか
      **機能を見つけてもらう入口**を兼ねる。押した先の一覧は、0件のときは
      「作品ページを開いて「☆ 気になる」を押すと、ここに並びます」と使い方を案内する（pages/watchlist.astro）。
      ★ 数字（`.count`）だけを出し分ける。**0件で「0」を出さないこと** — 通知の丸が常に付いていると、
        読者は数字を見なくなる（一覧のタブ見出しで「0件」を出さないのと同じ理由）。
      ★ `hidden` は数字の側に付けてある。JSが動かない環境でも💭 は出て、数字だけが出ない。

      ■ 数字の色（2026-09-22・運用者の指定。通販サイトのカートの数字と同じ考え方）
        通常 … 青（`--header-link`）
        入れた作品に**配信再開**が1本でもある … **赤**
      ★ 赤は「一覧を開けば知らせがある」の合図。一覧の側では再開の行を緑で先頭に出す
        （赤は一覧では「終了7日前」の色なので、同じ赤を再開の行に使わない）。
      ★ 色だけで伝えないこと。赤のときは読み上げ名に「配信再開◯件」を足す。

      ★ docs/GROWTH.md 3-6 の「一覧ページと記事ページにスクリプトを増やさない」の
        例外にあたる。**新しい script タグは足していない** — 下のメニュー開閉の
        スクリプトに数行足しただけで、追加の通信も描画待ちも無い。
        **ここを独立した <script> に切り出さないこと。**
      ★ 読み上げ名（aria-label）はスクリプトが件数込みで入れる。絵と数字だけでは意味が伝わらない。
    */}
    <a
      class="bookmark-link"
      href="/watchlist"
      title="ブックマーク"
      aria-label="ブックマーク"
      data-resumed={resumedIds}
    >
      <BookmarkIcon size={24} />
      <span class="count" hidden></span>
    </a>
  </div>
</header>

<script>
  /**
   * メニューの開閉の補助。**開閉そのものは <details> が担う。**
   * ここが無くても壊れないこと（JSが動かない環境でもメニューは使える）。
   */
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-menu]'))

  for (const menu of menus) {
    // 同時に開くのは1つだけ。2つ開くと下の記事が見えなくなる。
    menu.addEventListener('toggle', () => {
      if (!menu.open) return
      for (const other of menus) if (other !== menu) other.open = false
    })
  }

  /**
   * ブックマークの入口の件数。**💭 は常に出ていて、ここは数字だけを出し分ける**（1件以上のとき）。
   *
   * ★ 鍵は components/WatchStar.astro / pages/watchlist.astro と同じもの。
   *   ここでは**件数を数えるだけ**で、書き込みは一切しない。
   * ★ 読めない環境（プライベートウィンドウ等）では0件として扱う（数字が出ないだけ）。
   *   try/catch を外さないこと — ここで例外が出るとメニュー開閉ごと巻き添えになる。
   * ★ **押した瞬間に数を合わせる。** 作品ページの「☆ 気になる」と一覧の「外す」が
   *   `mhr-watchlist-change` を投げる。別のタブでの変更は `storage` で届く。
   * ★ **入れた作品に配信再開があれば数字を赤くする。** 再開した作品のIDは
   *   ビルド時に `data-resumed` に入れてある（上の注記）。
   */
  const WATCH_KEY = 'mhr-watchlist-v1'
  const bookmark = document.querySelector<HTMLElement>('.bookmark-link')
  const resumedSet = new Set((bookmark?.dataset['resumed'] ?? '').split(' ').filter(Boolean))

  function paintBookmark() {
    if (!bookmark) return
    let ids: string[] = []
    try {
      const raw = localStorage.getItem(WATCH_KEY)
      const store = raw ? (JSON.parse(raw) as unknown) : null
      ids = store && typeof store === 'object' && !Array.isArray(store) ? Object.keys(store) : []
    } catch {
      // 数字を出さないだけ。一覧側が「このブラウザでは保存できません」と案内する
    }
    const count = ids.length
    const resumed = ids.filter((id) => resumedSet.has(id)).length
    const badge = bookmark.querySelector<HTMLElement>('.count')!
    // ★ 丸の中に入るのは2桁まで。3桁は「99+」に丸める（丸が横に伸びて検索窓を押し出さないように）
    badge.textContent = count > 99 ? '99+' : String(count)
    badge.hidden = count === 0
    badge.dataset['tone'] = resumed > 0 ? 'resumed' : 'normal'
    bookmark.setAttribute(
      'aria-label',
      count === 0
        ? 'ブックマーク'
        : resumed > 0
          ? `ブックマーク（${count}件・配信再開${resumed}件）`
          : `ブックマーク（${count}件）`,
    )
  }

  paintBookmark()
  window.addEventListener('mhr-watchlist-change', paintBookmark)
  window.addEventListener('storage', (ev) => {
    if (ev.key === null || ev.key === WATCH_KEY) paintBookmark()
  })

  // 外を押したら閉じる。開いたままだと本文が読めない。
  document.addEventListener('click', (ev) => {
    for (const menu of menus) {
      if (!menu.contains(ev.target as Node)) menu.open = false
    }
  })

  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return
    for (const menu of menus) menu.open = false
  })
</script>

<style>
  /*
   * ★ 紺。**背景の地と同じ色**で、フッターの紺と上下で挟む形にしてある
   *   （2026-09-05 に白から変更。色は global.css の :root の --header-*）。
   *
   *   ここを白に戻すなら、**下の文字色4か所も一緒に戻すこと**
   *   （.brand / nav a / summary / PostSearch の focus）。
   *   背景だけ白にすると、明るい文字が白地に載って読めなくなる。
   *
   * ★ 境目の線は --border（薄いグレー）では紺の上でほぼ見えない。
   *   フッターと同じ半透明の白（--header-border）にしてある。
   */
  header {
    border-bottom: 1px solid var(--header-border);
    background: var(--header-bg);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  /*
   * サイト名 → メニュー → 検索窓 の順に**すべて左詰め**（2026-08-30）。
   *
   * ★ `flex-wrap: wrap` は**残してある**。溢れたときに横スクロールを出すより、
   *   折り返すほうが害が小さいため（`nowrap` にすると body の
   *   `overflow-x: hidden` で右端が切れて読めなくなる）。
   *   **折り返さないのは幅の設計で担保する**（冒頭の内訳を参照）。
   */
  .inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem 1rem;
    flex-wrap: wrap;
    padding-block: 0.7rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    /* 紺の上なので白。メニュー（--header-text）より一段強く出す */
    color: var(--header-title);
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    /*
     * メニューを開いたときの位置の基準。
     * 狭い画面では、開いた枠を**メニューの行いっぱい**に広げるのに使う（下の @media）。
     */
    position: relative;
    display: flex;
    /* カテゴリが増えても折り返して収まるようにする */
    flex-wrap: wrap;
    justify-content: flex-start;
    /*
     * 項目の間隔。**0.9rem から詰めた**（2026-08-30）。
     * メニューが4つになり、0.9rem のままだと検索窓のぶんが足りない。
     */
    gap: 0.5rem 0.7rem;
    font-size: 0.88rem;
  }
  nav a {
    color: var(--header-text);
    text-decoration: none;
  }
  nav a:hover {
    /* --accent（#1f6feb）は紺の上でほとんど沈む。明るい青を使う */
    color: var(--header-link);
  }

  /*
   * ブックマークの入口（💭 は常時。件数の丸は1件以上のときだけ・上のスクリプト）。
   * ★ **行の右端**（`margin-left: auto`）。広い画面では本文カードの右端と揃い、
   *   スマホでは1行目（サイト名・検索窓）の右端に来る。メニューは 47rem 未満で2行目へ回る（下の @media）。
   */
  .bookmark-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    /*
     * 指で押す範囲。絵は24pxだが、押せる枠は上下に余白を取る。
     * ★ 右の余白は件数の丸を載せる場所。左を詰めて、絵を丸に隠されにくくする。
     */
    padding: 0.25rem 0.5rem 0.25rem 0.15rem;
    border-radius: 8px;
    color: var(--header-text);
    text-decoration: none;
  }
  .bookmark-link:hover {
    color: var(--header-link);
  }
  .bookmark-link:focus-visible {
    outline: 2px solid var(--header-link);
    outline-offset: 1px;
  }
  /* 絵は子の部品（BookmarkIcon.astro）が描くので :global で降りる */
  .bookmark-link :global(svg) {
    display: block;
  }
  /*
   * 件数。**絵の右肩に重ねる丸**（通知の数字と同じ置き方）。
   * 文字色だけだと絵の一部に見えるので、明るい丸に紺の数字で抜く。
   */
  .count {
    position: absolute;
    top: -0.1rem;
    right: -0.25rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.22rem;
    border: 1.5px solid var(--header-bg);
    border-radius: 999px;
    background: var(--header-link);
    color: #0b1220;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: calc(1.05rem - 3px);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  /*
   * ★ 0件で数字を消す行。**上の `.count` に `display` を足すなら、この行を消さないこと。**
   *   素で `display: ...` を書くと既定の `[hidden] { display: none }` に打ち勝ち、
   *   0件でも「0」の丸が出る（FollowBar.astro で同じ穴を踏んでいる）。この2つはセット。
   */
  .count[hidden] {
    display: none;
  }
  /*
   * 配信再開がある読者の数字（上のスクリプトの `data-tone`）。**通販サイトのカートの赤。**
   * ★ ヘッダーは明暗どちらの表示でも紺なので、色は固定値でよい（白文字とのコントラスト比 4.6:1）。
   */
  .count[data-tone='resumed'] {
    background: #d93025;
    color: #fff;
  }

  /* --- 押すと開くメニュー --- */
  .menu {
    position: relative;
  }
  summary {
    /* 既定の三角は消して、下の ::after で自前の印を出す */
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    color: var(--header-text);
    white-space: nowrap;
