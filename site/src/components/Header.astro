---
import { SITE, CATEGORIES } from '../config'
---

<header>
  <div class="wrap inner">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="カテゴリ">
      {
        Object.values(CATEGORIES).map((c) => (
          <a href={`/category/${c.slug}`}>{c.label}</a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.7rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    /* カテゴリが増えても折り返して収まるようにする */
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    font-size: 0.88rem;
  }
  nav a {
    color: var(--text-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent);
  }
</style>
