---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** src/assets 由来（最適化される）。常設ページのサービス画像 */
  image?: ImageMetadata
  /** public/ 由来のパス（最適化されない）。記事の heroImage */
  src?: string
  alt?: string
}

const { image, src, alt = '' } = Astro.props

/**
 * 見出し（h1）の**直上**に置く画像。
 *
 * ★ **そのページ固有**の絵。本文カードの中、パンくずと h1 の間に入る。
 *   （全ページ共通のヘッダーバナーは 2026-08-24 に廃止した。）
 *
 * ★ **いまの使い手は常設ページだけ**（`leaving/[service]` `arrivals/[service]`）。
 *   個別記事の冒頭では 2026-08-25 に出すのをやめた
 *   （表の全作品にサムネイル付きリンクが並び、冒頭の1枚が要らなくなったため）。
 *   理由と戻し方は `src/pages/posts/[...slug].astro` の h1 の直前に書いてある。
 *   **このファイル自体は消さないこと。**
 *
 * ★ 画像が無いときは**何も描かない**。
 *   カードの左サムネイル（Thumb.astro）と違い、
 *   ここは大きな面なので、空の枠を出すと見た目が破綻する。
 */
---

{
  (image || src) && (
    <figure class="lead">
      {image ? (
        <Image
          class="service"
          src={image}
          alt={alt}
          widths={[480, 736]}
          sizes="(max-width: 47rem) 100vw, 640px"
        />
      ) : (
        /* public/ 配下は astro:assets を通せないので素の img */
        <img class="poster" src={src} alt={alt} loading="eager" decoding="async" />
      )}
    </figure>
  )
}

<style>
  .lead {
    margin: 0 0 1rem;
  }
  .lead :global(img) {
    display: block;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  /*
   * ■ 常設ページのサービス画像（`image`）… **本文幅いっぱいに敷いて 16:7 で切り抜く**
   *
   * 人が `src/assets/services/` に置く、そのサービスを表す横長の絵。
   * 高さの上限（320px）だけで抑えると、16:9 の絵は 567px で頭打ちになり、
   * 本文幅 673px の中で**右に106px の空きが出て、置き忘れのように見えた**
   * （2026-08-28 に実測して直した）。
   *
   * 幅を100%にして比率で高さを決めれば、どの画面幅でも本文と左右がそろう。
   * 16:7 なら 1200px 時点で約294pxに収まり、上限に当たらないまま
   * 本題（表）までのスクロールも増えない。狭い画面では比率どおり縮む
   * （375px なら約164px）ので、スマホで画面を占領することもない。
   *
   * ★ 切り抜いてよいのは、**この絵が「中央に主題を置く」約束だから**
   *   （src/assets/services/README.md）。上下が落ちても主題は残る。
   */
  .lead :global(img.service) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    max-height: 320px;
    object-fit: cover;
  }

  /*
   * ■ 記事のヘッダー画像（`src`）… **切り抜かない。高さで抑える。**
   *
   * こちらは作品のポスター（2:3）が入る。切り抜くと顔も題字も消えて
   * 何の作品か分からない帯になるので、**比率には触れない**。
   * 押し下げは高さの上限だけで防ぐ。
   */
  .lead :global(img.poster) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 320px;
  }
</style>
