---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** src/assets 由来（最適化される）。常設ページのサービス画像 */
  image?: ImageMetadata
  /** public/ 由来のパス（最適化されない）。記事の heroImage */
  src?: string
  alt?: string
}

const { image, src, alt = '' } = Astro.props

/**
 * 見出し（h1）の**直上**に置く画像。
 *
 * ★ **そのページ固有**の絵。本文カードの中、パンくずと h1 の間に入る。
 *   （全ページ共通のヘッダーバナーは 2026-08-24 に廃止した。）
 *
 * ★ **いまの使い手は常設ページだけ**（`leaving/[service]` `arrivals/[service]`）。
 *   個別記事の冒頭では 2026-08-25 に出すのをやめた
 *   （表の全作品にサムネイル付きリンクが並び、冒頭の1枚が要らなくなったため）。
 *   理由と戻し方は `src/pages/posts/[...slug].astro` の h1 の直前に書いてある。
 *   **このファイル自体は消さないこと。**
 *
 * ★ 画像が無いときは**何も描かない**。
 *   カードの左サムネイル（Thumb.astro）と違い、
 *   ここは大きな面なので、空の枠を出すと見た目が破綻する。
 */
---

{
  (image || src) && (
    <figure class="lead">
      {image ? (
        <Image src={image} alt={alt} widths={[480, 736]} sizes="(max-width: 47rem) 100vw, 640px" />
      ) : (
        /* public/ 配下は astro:assets を通せないので素の img */
        <img src={src} alt={alt} loading="eager" decoding="async" />
      )}
    </figure>
  )
}

<style>
  .lead {
    margin: 0 0 1rem;
  }
  .lead :global(img) {
    display: block;
    /*
     * **切り抜かない。高さで抑える。**
     *
     * 以前は 16:7 で切り抜いていた。縦長の絵がそのまま入ると本文が押し下げられ、
     * 記事の本題（表）に届くまでのスクロールが増えるため。
     * ところが記事のヘッダー画像は作品のポスター（2:3）になったので、
     * 切り抜くと顔も題字も消えて何の作品か分からない帯になる。
     *
     * 高さの上限だけを決めれば、押し下げの問題は同じように防げる。
     * 横長の画像を人が指定した場合も、そのまま自然な形で出る。
     */
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 320px;
    border-radius: 12px;
    border: 1px solid var(--border);
  }
</style>
