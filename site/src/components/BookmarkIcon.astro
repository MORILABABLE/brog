---
/**
 * ブックマークの印（💭 の形）。ヘッダーの入口（Header.astro）と、
 * 一覧（pages/watchlist.astro）の説明文の2か所で**同じ絵**を使う。
 *
 * ★ 絵文字の 💭 は端末ごとに色も形も変わる（Windows は灰色の線画、iOS は白い吹き出し）。
 *   紺のヘッダーの上で読める形にするため、塗りを `currentColor` で自前で持つ。
 * ★ 読み上げはしない（`aria-hidden`）。意味は置いた側が文字か aria-label で持つこと。
 */
interface Props {
  size?: number
  class?: string
}

const { size = 24, class: className } = Astro.props
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
  <circle cx="8.5" cy="10.5" r="4.6" />
  <circle cx="13.6" cy="7.6" r="5.2" />
  <circle cx="18.4" cy="11" r="4.2" />
  <ellipse cx="13.2" cy="12.6" rx="8.2" ry="3.9" />
  <circle cx="5.6" cy="19" r="1.9" />
  <circle cx="2.9" cy="22" r="1.2" />
</svg>
