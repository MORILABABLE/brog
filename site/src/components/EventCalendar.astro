---
import type { CalendarKind, CalendarMonth } from '../lib/calendar'

interface Props {
  months: CalendarMonth[]
  /** ビルド時点の今月（`lib/calendar.ts` の `buildMonth`）。スクリプトが動かないときの最初の月 */
  buildMonth: string
  /**
   * このページに出す種類と、升目を押したときの行き先の頭（`#leaving-` など）。
   * 後ろに `2026-09-30`（`isoDate()` の形）が付く。
   *
   * ★ 行き先の頭は、下の表（WorkTable）の `idPrefix` と**必ず同じ文字列**にすること。
   *   片方だけ変えると升目を押しても何も起きない。
   * ★ 渡す順は問わない。凡例と印は下の `ORDER`（過去 → これから）で並べ直す。
   */
  kinds: { kind: CalendarKind; prefix: string }[]
}

const { months, buildMonth, kinds } = Astro.props

/**
 * 種類ごとの印と言葉。**ここ1か所に置く。**
 *
 * ■ 1文字の印（`chip`）と色（2026-09-17 に色を4つに分けた・運用者の指定）
 *   済 … 見放題が終了した（過去）          グレー（--cal-ended）
 *   終 … 見放題が終了する予定（これから）  赤    （--cal-leaving）
 *   新 … 見放題に入った（過去）            緑    （--cal-new）
 *   予 … 見放題が始まる予定（これから）    青    （--cal-arrivals）
 *
 * ★ それまでは「赤／青の2系統で、これからは薄い塗り・過去は枠線だけ」だった。
 *   **小さい升目の中では見分けが付かない**と運用者から指摘があり、4つとも別の色で塗りつぶした。
 *   1ページに出るのは「済と終」か「新と予」の2つだけなので、赤と緑が並ぶことはない。
 * ★ 色だけに意味を持たせない（styles/global.css の :root と同じ決まり）。
 *   升目には必ず**1文字の印と本数**を出す。色は速く読むための補助。
 */
const KIND: Record<
  CalendarKind,
  { chip: string; legend: string; sum: string; spoken: string; cls: string }
> = {
  ended: { chip: '済', legend: '見放題が終了した日', sum: '終了', spoken: '見放題終了', cls: 'ed' },
  leaving: { chip: '終', legend: '見放題が終了する日', sum: '終了予定', spoken: '見放題終了予定', cls: 'lv' },
  arrivals: { chip: '新', legend: '見放題に入った日', sum: '新着', spoken: '見放題開始', cls: 'ar' },
  upcoming: { chip: '予', legend: '見放題が始まる予定の日', sum: '配信予定', spoken: '見放題開始予定', cls: 'up' },
}

/**
 * 凡例・月の合計・1日に2種類ある日の印を並べる順。**過去が左（上）、これからが右（下）。**
 * 暦と同じ向き（左から右へ時間が進む）にそろえる（2026-09-17・運用者の指定）。
 */
const ORDER: CalendarKind[] = ['ended', 'leaving', 'arrivals', 'upcoming']
const byOrder = (a: { kind: CalendarKind }, b: { kind: CalendarKind }) =>
  ORDER.indexOf(a.kind) - ORDER.indexOf(b.kind)

const ordered = [...kinds].sort(byOrder)

/*
 * 凡例に出すのは**実際に点いている種類だけ**。
 * 1つも無い印の説明を並べると、読者はその印をどこかで探すことになる。
 */
const shown = ordered.filter((k) => months.some((m) => (m.sums[k.kind] ?? 0) > 0))
const prefixOf = new Map(kinds.map((k) => [k.kind, k.prefix]))

/**
 * 月の升目。常設ページ（`/leaving/<サービス>` `/arrivals/<サービス>`）の先頭に置く。
 *
 * ■ 何のためにあるか
 * 一覧は上から読ませる作りなので、「今月の終わりに何本消えるのか」を
 * 知りたい読者は**スクロールしないと分からない**。
 * 升目にすると、点いている日が一目で分かり、そこから本文へ直接飛べる。
 *
 * ■ 押せる日には**作品の絵を敷く**（2026-09-17・運用者の指定）
 * それまでは凡例の横に「日にちを押すと作品の一覧へ移動します」と書いていた。
 * **文字で説明するより、升目に作品が見えているほうが「押せば作品に行ける」と伝わる。**
 * その日でいちばん評価の高い作品のポスターを敷き、日付と印を上に重ねる（lib/calendar.ts の `thumb`）。
 * ポスターの無い日は、印の色の帯を付けた押せるタイルにする。
 *
 * ■ 1か月ずつ切り替える
 * 前月・今月・翌月（イベントがあればその先も）を持ち、**見せるのは1か月だけ**。
 * ★ **スクリプトが動かない環境では全部の月が並ぶ。** 隠すのはスクリプトの仕事で、
 *   HTML の時点では何も隠していない（升目が1つも見えない事故を起こさない）。
 * ★ 隠れている月の絵は読み込まれない（`loading="lazy"` と `hidden`）。
 *
 * ■ 「きょう」の印は読者の画面で付ける
 * ビルドは週2回なので、ビルド時の日付で印を付けると数日ずれる。
 * JST のきょうをスクリプトで求めて、`data-date` が一致する升目の日付を丸で囲む。
 *
 * ■ 押せるのは点いている日だけ
 * 何も無い日をリンクにすると、押しても何も起きないマスが大半になる。
 *
 * ■ 升目そのものは JavaScript を使わない
 * 升目はただのページ内リンク。素の `<a href="#...">` で足りる。
 * ★ スクリプトが担うのは「月の切り替え」と「きょうの印」だけ。
 * ★ 飛んだ先が固定ヘッダーに隠れないよう、見出し側に `scroll-margin-top` が要る
 *   （components/WorkTable.astro の `.day-title`）。**片方だけ直さないこと。**
 */

/** 曜日の見出し。日曜始まり（日本の暦の並び）。 */
const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'] as const

/** `2026-09-30` → `9月30日`。読み上げ用の文言に使う。 */
function spoken(iso: string): string {
  return `${Number(iso.slice(5, 7))}月${Number(iso.slice(8, 10))}日`
}

/** 升目の行き先（`#leaving-2026-09-30`）。`prefix` は `#` 込みで渡ってくる。 */
const hrefOf = (kind: CalendarKind, iso: string) => `${prefixOf.get(kind) ?? ''}${iso}`
/**
 * 行き先の**見出しの id**（`leaving-2026-09-30`）。`#` を外しただけ。
 *
 * ★ 絞り込み（components/CalendarFilter.astro）が印に焼き込んだこれを読んで、
 *   その日の見えている行を引く。**印が2つある日でも1つの日でも同じ道**になるよう、
 *   リンクの href ではなく**印そのもの**に持たせている。
 */
const targetOf = (kind: CalendarKind, iso: string) => hrefOf(kind, iso).replace(/^#/, '')
---

<section class="calendar" aria-label="配信カレンダー">
  {/*
    ★ ここにあった h2「配信カレンダー」と、その右の検索窓は**外した**（2026-09-19・運用者の指定）。
      ページの h1 が `Netflix 見放題・配信終了カレンダー` と名乗るようになり、
      その直下でもう一度「配信カレンダー」と言うことになったため。
      **枠の名前は section の aria-label が持っている**ので、読み上げからは消えていない。
    ★ h2 を外したら検索窓が1つだけの行に残り、**切り替え（サービス／表示）と2段**になった。
      いまは検索窓も切り替えと同じ行で、まとめて下の `controls` から差し込まれる
      （components/ServiceCalendarPage.astro の `.controls`）。**この部品は検索窓を持たない。**

    ★ 升目の上に差し込む部品（2026-09-17）。配信カレンダーのページでは
      サービス／表示の切り替え（CalendarPicker）＋作品検索（WorkSearch）と、
      種類・ジャンルの絞り込み（CalendarFilter）が入る。
  */}
  <slot name="controls" />

  <div class="pager" data-cal data-build-month={buildMonth}>
    {/*
      操作の行。**月の切り替えと凡例を同じ行に並べる**（2026-09-17・運用者の指定）。
      幅が足りなければ凡例が下の行へ落ちる（スマホ）。
    */}
    <div class="toolbar">
      {/*
        月の切り替え。**スクリプトが動いたときだけ出す**（`hidden` を外すのはスクリプト）。
        動かない環境では全部の月が並ぶので、ボタンは要らない。
      */}
      <div class="nav" data-cal-nav hidden>
        <button type="button" class="nav-btn" data-cal-step="-1">‹ 前の月</button>
        <button type="button" class="nav-btn" data-cal-home>今月</button>
        <button type="button" class="nav-btn" data-cal-step="1">次の月 ›</button>
      </div>
      {/*
        凡例。**升目に出る印と同じ形・同じ色で並べる。**
        ★ 色の説明ではなく、升目に出る文字の説明として書く。
        ★ 「日にちを押すと作品の一覧へ移動します」は**撤去した**（2026-09-17）。
          押せることは升目の絵とタイルの見た目で伝える（上の「押せる日には作品の絵を敷く」）。
      */}
      <p class="legend">
        {
          shown.map((k) => (
            <span class:list={['key', KIND[k.kind].cls]}>
              <span class="chip">{KIND[k.kind].chip}</span>
              {KIND[k.kind].legend}
            </span>
          ))
        }
      </p>
    </div>
    <div class="months">
      {
        months.map((m) => (
          <table class="month" data-month={m.key}>
            <caption>
              <span class="month-name">{m.label}</span>
              <span class="month-sum">
                {shown
                  .filter((k) => (m.sums[k.kind] ?? 0) > 0)
                  .map((k) => (
                    <span class:list={['sum', KIND[k.kind].cls]} data-sum-kind={k.kind}>
                      {KIND[k.kind].sum}
                      <span class="n">{m.sums[k.kind]}</span>本
                    </span>
                  ))}
                {/* 絞り込みで全部0本になったときもスクリプトがこれを出す */}
                <span class="sum none" data-sum-none hidden={Object.keys(m.sums).length > 0}>
                  なし
                </span>
              </span>
            </caption>
            <thead>
              <tr>
                {WEEKDAYS.map((w) => (
                  <th scope="col">{w}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {m.weeks.map((week) => (
                <tr>
                  {week.map((d) => {
                    /* 前後の月の埋め草。日付を持たないので中身も入れない */
                    if (!d) return <td class="pad" />

                    const hits = ordered.filter((k) => (d.counts[k.kind] ?? 0) > 0)

                    /* 何も無い日。**押せない見た目にする。** */
                    if (hits.length === 0) {
                      return (
                        <td>
                          <span class="cell is-empty" data-date={d.iso}>
                            <span class="num">{d.day}</span>
                          </span>
                        </td>
                      )
                    }

                    /*
                     * その日の作品の絵。**飾りなので alt は空**（読み上げは下の aria-label が担う）。
                     * ★ 幅と高さを書く。書かないと絵が届くまで升目の中身がずれる。
                     */
                    const img = d.thumb && (
                      <img class="cell-img" src={d.thumb} alt="" width="48" height="72" loading="lazy" decoding="async" />
                    )
                    const cls = ['cell', 'is-hit', d.thumb ? 'has-img' : 'no-img']

                    /*
                     * 点いている日。**種類が1つでも2つでも、升目まるごとが1本のリンク。**
                     * 指で押す的が升目いっぱい（実測 60×80px）になる。
                     *
                     * ★ 🔴 **2種類ある日を `<span>` に戻さないこと**（2026-09-20 に直した不具合）。
                     *   それまでは「行き先が2つあるので升目そのものはリンクにしない」として
                     *   `<span>` で描き、**印の小さな丸2つ（実測 24×16px）だけ**をリンクにしていた。
                     *   読者は升目（日付の数字・ポスター）を押すので、**押しても何も起きない日**になる。
                     *   実測（2026-09-20・/arrivals/netflix）では、点いている24日のうち**11日がこれ**だった
                     *   （/arrivals/prime-video も7日）。「日にちを押しても展開されない」の正体。
                     * ★ **行き先を1つに絞ってよい理由。** 日付めくり（DayPager.astro）は
                     *   `[data-day]` を丸ごと出すので、どちらの見出しへ飛んでも
                     *   **その日の表は2つとも画面に出る**。違うのは着地の高さだけ。
                     *   だから ORDER で先に来るほう（＝その日の先頭の表）へ送れば足りる。
                     * ★ 印（`.mark`）は**リンクをやめて、ただの丸に戻した**。
                     *   リンクの中にリンクは置けないため。本数と色はそのまま残る。
                     */
                    const lead = hits[0]!.kind
                    return (
                      <td>
                        <a
                          class:list={[...cls, hits.length > 1 && 'is-multi', KIND[lead].cls]}
                          data-date={d.iso}
                          href={hrefOf(lead, d.iso)}
                          aria-label={`${spoken(d.iso)} ${hits
                            .map(({ kind: k }) => `${KIND[k].spoken}${d.counts[k]}本`)
                            .join('・')}の一覧へ移動`}
                        >
                          {img}
                          <span class="num">{d.day}</span>
                          {/* 読み上げは上の aria-label が担うので、印は絵として扱う */}
                          <span class="marks" aria-hidden="true">
                            {hits.map(({ kind: k }) => (
                              <span
                                class:list={['mark', KIND[k].cls]}
                                data-kind={k}
                                data-target={targetOf(k, d.iso)}
                              >
                                <span class="chip">{KIND[k].chip}</span>
                                <span class="n">{d.counts[k]}</span>
                              </span>
                            ))}
                          </span>
                        </a>
                      </td>
                    )
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        ))
      }
    </div>
  </div>
</section>

<script>
  /**
   * 月の切り替えと「きょう」の印。**升目の中身には触らない。**
   *
   * ★ きょうは **JST** で決める。読者の端末が海外の時刻でも、
   *   升目の日付（JST で切ってある・lib/calendar.ts）と揃えるため。
   * ★ 最初に見せる月は「読者のきょうの月」。描いた範囲に無ければビルド時の今月、
   *   それも無ければ先頭の月。
   */
  const JST_MS = 9 * 60 * 60 * 1000
  const today = new Date(Date.now() + JST_MS).toISOString().slice(0, 10)

  for (const root of document.querySelectorAll<HTMLElement>('[data-cal]')) {
    const tables = Array.from(root.querySelectorAll<HTMLTableElement>('table[data-month]'))
    if (tables.length === 0) continue

    for (const cell of root.querySelectorAll<HTMLElement>(`[data-date="${today}"]`)) {
      cell.classList.add('is-today')
      const note = document.createElement('span')
      note.className = 'visually-hidden'
      note.textContent = 'きょう'
      cell.append(note)
    }

    const keys = tables.map((t) => t.dataset.month ?? '')
    const home = [today.slice(0, 7), root.dataset.buildMonth ?? ''].find((k) => keys.includes(k)) ?? keys[0]!
    let index = keys.indexOf(home)

    const nav = root.querySelector<HTMLElement>('[data-cal-nav]')
    const prev = root.querySelector<HTMLButtonElement>('[data-cal-step="-1"]')
    const next = root.querySelector<HTMLButtonElement>('[data-cal-step="1"]')
    const homeBtn = root.querySelector<HTMLButtonElement>('[data-cal-home]')

    const show = () => {
      tables.forEach((t, i) => (t.hidden = i !== index))
      if (prev) prev.disabled = index === 0
      if (next) next.disabled = index === tables.length - 1
      if (homeBtn) homeBtn.disabled = keys[index] === home
    }

    root.classList.add('is-paged')
    if (nav) nav.hidden = false
    prev?.addEventListener('click', () => {
      index = Math.max(0, index - 1)
      show()
    })
    next?.addEventListener('click', () => {
      index = Math.min(tables.length - 1, index + 1)
      show()
    })
    homeBtn?.addEventListener('click', () => {
      index = keys.indexOf(home)
      show()
    })
    show()
  }
</script>

<style>
  .calendar {
    margin: 1.4rem 0 0;
  }
  /*
   * 種類ごとの色。**この変数1つで、凡例・印・月の合計・タイルの帯が揃う。**
   * 値の意味とコントラスト比は styles/global.css の --cal-*。
   */
  .ed {
    --kind: var(--cal-ended);
  }
  .lv {
    --kind: var(--cal-leaving);
  }
  .ar {
    --kind: var(--cal-new);
  }
  .up {
    --kind: var(--cal-arrivals);
  }

  /* --- 凡例（1行） --- */
  /*
   * 月の切り替えと凡例の行。**ボタンのすぐ右に凡例を続ける。**
   * ★ 左右に振り分けない（`space-between` にしない）。升目は幅を抑えてあるので、
   *   凡例だけが本文の右端へ離れて、カレンダーから浮いて見えた（2026-09-17 の実測）。
   * ★ 狭い画面（スマホ）では1行に収まらず、凡例が下の行へ落ちる（`flex-wrap`）。
   */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem 1.4rem;
    margin: 0 0 0.6rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /*
   * 1文字の印。**升目の中と凡例で同じ形にする。**
   * 凡例では印だけの丸、升目では本数と一緒に丸の中に入る（`.mark`）。
   */
  .key .chip {
    display: inline-block;
    min-width: 1.5em;
    padding: 0 0.3em;
    border-radius: 999px;
    background: var(--kind);
    color: var(--cal-on);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
  }

  /* --- 月の並び --- */
  /*
   * ★ `auto-fill`。`auto-fit` にすると、最後の月が1つだけ残った行で
   *   本文幅いっぱいに伸び、**月ごとに升目の大きさが変わる。**
   * ★ スクリプトが動いたら（`.pager.is-paged`）1か月ずつ見せるので、格子をやめて1列にする。
   */
  .months {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
  }
  .is-paged .months {
    display: block;
  }
  /* 月の切り替えのボタン */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .nav[hidden] {
    display: none;
  }
  .nav-btn {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .nav-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nav-btn:disabled {
    cursor: default;
    color: var(--text-muted);
    opacity: 0.6;
  }
  .nav-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .month {
    width: 100%;
    border-collapse: collapse;
    /* 7列を必ず等幅にする。中身の文字数で列幅が動くと暦に見えない */
    table-layout: fixed;
  }
  /*
   * 1か月ずつ見せるときは、升目が本文幅いっぱいに伸びすぎないように抑える。
   * ★ 絵を敷くようになったので、升目1つが縦長（3:4）になる。幅を広げると縦にも伸びるので、ここで止める。
   */
  .is-paged .month {
    max-width: 28rem;
  }
  caption {
    /* 表の外に出る見出し。左寄せにして本文の流れに合わせる */
    text-align: left;
    padding: 0 0 0.25rem;
  }
  .month-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
  }
  .month-sum {
    margin-left: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .sum + .sum {
    margin-left: 0.4rem;
  }
  .sum {
    color: var(--kind);
  }
  .sum.none {
    font-weight: 400;
    color: var(--text-muted);
  }

  /*
   * 曜日の見出し。**日曜を赤・土曜を青にしない。**
   * このカレンダーでは色を印の種類に割り当てている。
   */
  thead th {
    padding: 0.1rem 0;
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  td {
    padding: 2px;
    text-align: center;
    vertical-align: top;
  }

  /*
   * 升目。**縦長（3:4）にそろえる**（2026-09-17）。
   * ポスター（2:3）を敷いたときに絵として読める最小の形。空の日も同じ形にして暦の格子を保つ。
   */
  .cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    padding: 0.18rem;
    border: 1px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-muted);
  }
  .num {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    min-width: 1.45em;
    padding: 0 0.15em;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
  }

  /*
   * 押せる日。**押せるものに見える形にする**（影と、押したときの沈み）。
   * 何も無い日（`.is-empty`）は地のまま・影なしで、差が一目で分かる。
   */
  .cell.is-hit {
    background: var(--bg-subtle);
    border-color: var(--border);
    color: var(--text);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .cell.is-hit .num {
    font-weight: 700;
  }
  /*
   * ★ 点いている升目は**すべて `a.cell`**（2026-09-20）。2種類ある日だけ `<span>` だった
   *   ころの `.is-multi:hover` / `.mark:focus-visible` は要らなくなった。
   *   `.is-multi` は「印が2つ縦に積まれる日」の印として残してある（見た目の指定は持たない）。
   */
  a.cell:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.28);
  }
  a.cell:active {
    transform: translateY(0);
  }
  a.cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  /* 絵の無い日は、下辺に印の色の帯を付けて「中身のある日」だと分からせる */
  .cell.no-img {
    border-bottom: 3px solid var(--kind);
  }

  /*
   * 作品の絵。升目いっぱいに敷き、上下を暗くして日付と印を読めるようにする。
   * ★ 暗くする膜は `::after`。絵（先に並ぶ）の上、日付と印（z-index: 1）の下に来る。
   */
  .cell-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .cell.has-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.55),
      rgb(0 0 0 / 0) 38%,
      rgb(0 0 0 / 0) 50%,
      rgb(0 0 0 / 0.65)
    );
    pointer-events: none;
  }
  .cell.has-img .num {
    color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.8);
  }

  /* 升目の中の印。「終14」を1つの丸に入れて、種類の色で塗る */
  .marks {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.05rem;
    padding: 0 0.3em;
    border-radius: 999px;
    background: var(--kind);
    color: var(--cal-on);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.5;
    /* 「終」「1」「4」で折り返させない */
    white-space: nowrap;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.35);
  }

  /* 絞り込み（CalendarFilter.astro）で0本になった印。.mark の display 指定に負けないよう明示する */
  .mark[hidden] {
    display: none;
  }

  /*
   * 絞り込み（CalendarFilter.astro）で、その日の作品が**1本も残らなかった**升目。
   * ★ 升目ごと消さない。暦の形が崩れて日付が読めなくなる。
   * ★ **何も無い日（`.is-empty`）と同じ見た目にして、押せなくする。**
   *   最初は薄いタイルで残したが、絞り込むと灰色のタイルが升目いっぱいに並んで見づらかった（2026-09-17）。
   */
  .cell.is-filtered {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    color: var(--text-muted);
    pointer-events: none;
  }
  .cell.is-filtered .num {
    font-weight: 400;
  }
  .cell.is-filtered .cell-img,
  .cell.is-filtered .marks {
    display: none;
  }
  .cell.is-filtered::after {
    content: none;
  }

  /*
   * きょう。**日付の数字を丸で囲む**（絵を敷いた升目でも見えるように、枠線ではなく数字側に付ける）。
   * ★ クラスは**スクリプトが付ける**（ビルド時の日付は読者のきょうと数日ずれるため）。
   * ★ 色は種類に使っていないアクセント色。
   */
  .cell.is-today .num {
    background: var(--accent);
    /* ダークではアクセントが明るくなるので、文字は地の色に倒す（--cal-on と同じ切り替え） */
    color: var(--cal-on);
    font-weight: 700;
    text-shadow: none;
  }

  /*
   * 幅の狭い画面。**升目は詰めるが、印の文字は小さくしない。**
   * ここを縮めると「終14」が読めなくなり、カレンダーの用が消える。
   */
  @media (max-width: 24rem) {
    td {
      padding: 1px;
    }
    .cell {
      padding: 0.12rem;
    }
    .num {
      font-size: 0.7rem;
    }
  }
</style>
