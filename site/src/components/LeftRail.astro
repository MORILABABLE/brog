---
import Thumb from './Thumb.astro'
import { CATEGORIES } from '../config'
import { EVERGREEN_PAGES, evergreenStamp, evergreenSummary } from '../lib/evergreen'
import { serviceImage } from '../lib/images'
import { publishablePeople, topPeople } from '../lib/people'

/**
 * 本文の**左**の余白に置く枠。上から順に3つ。
 *   1. 当サイトの運営方針および活用について（1枚だけ。行き先は pages/guide.astro）
 *   2. 新着配信・終了一覧（常設ページの一覧。2026-08-27 に
 *      「最新の配信終了・配信開始一覧」から改称）
 *   3. 監督・出演者から探す（人物ページへの導線。2026-08-30 追加）
 * **この順を入れ替えないこと。** 1 は「画像が汎用画像のことがある理由」と
 * 「2 に検索欄があること」を先に伝えるための枠で、読む順がそのまま並び順（2026-08-29）。
 *
 * ■ なぜ左に分けたか（2026-08-24）
 * 以前は右の追従枠（FollowRail.astro）の1ブロック目に入れていたが、
 * サービスが増えるほど枠が縦に伸び、その下の「新着記事」とPR枠が
 * 画面外へ押し出されていた。**常設ページ一覧は左、記事とPRは右**に分けて、
 * どちらも画面の上のほうから始まるようにしている。
 *
 * ■ 追従させない
 * 追従するのは右のPR枠だけ（理由は FollowRail.astro の説明）。
 * ここは本文と一緒に流す。
 *
 * ■ 並びは全ページで固定（重要）
 * 「いま見ているページのカードを消す」実装に戻さないこと。
 * ページを移動するたびに一覧の中身と順番が変わり、読者が混乱する
 * （2026-08-23 の判断）。常に同じ順で全件出し、現在地のカードだけ
 * リンクを外して `aria-current="page"` を付けている。
 *
 * ■ 出す条件
 * 画面幅 75rem(1200px) 以上（styles/global.css の `.layout`）。
 * **狭い画面では枠ごと消える**ので、常設ページへの導線は
 * カテゴリ×サービスのページ（/category/<ハブ>/<サービス>）にも置いてある。
 * そちらが狭い画面での入口で、ヘッダーのメニューから2手で辿り着く
 * （2026-08-27。それまではカテゴリのハブに常設カードを並べていた）。
 */

/** 現在地の判定にだけ使う。**項目の出し分けには使わない。** */
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '')

/**
 * 一覧の**上**に置く固定ページ（2026-08-29 追加）。行き先は pages/guide.astro。
 *
 * 常設ページ（EVERGREEN_PAGES）と違って中身が入れ替わらないので、
 * lib/evergreen.ts には入れていない。**カードの体裁だけをそろえてある。**
 */
const GUIDE = {
  href: '/guide',
  /** カードの小さい行。この1枚だけカテゴリを持たないので、バッジの代わりに置く */
  lead: '【はじめての方へ】',
  /** カードの太い行。枠の見出しと同じ文言を繰り返さない長さにする */
  name: '運営方針と活用法',
} as const

const guideIsCurrent = GUIDE.href === current
/*
 * 現在地はリンクだけ外す（下の一覧と同じ扱い）。カードが1枚しかないので、
 * **外側のタグだけを差し替えて中身は1つに保つ。**
 * 分岐でカードごと書き分けると、片方だけ直したときに見た目がずれる。
 */
const GuideTag = guideIsCurrent ? 'span' : 'a'

/**
 * 3つ目の枠に出す人物の数（2026-08-30 追加）。
 *
 * ★ **枠を縦に伸ばしすぎないこと。** 上に常設ページのカードが5枚あり、
 *   ここを長くすると左の列だけが本文より下まで伸びる。
 *   全員への経路は `/person`（一覧）が持つので、ここは入口の見本でよい。
 *
 * ★ 顔ぶれと並びは**全ページで固定**（作品の多い順）。
 *   見ているページに合わせて入れ替えると、移動のたびに枠の中身が変わる
 *   （この枠の「並びは全ページで固定」と同じ理由）。
 */
const RAIL_PEOPLE = 6

const railPeople = topPeople(RAIL_PEOPLE)
const peopleTotal = publishablePeople().length
---

<aside class="left-rail">
  {/*
    ★ 「新着配信・終了一覧」より**上**に置く枠（2026-08-29 追加）。中身は1枚だけ。

    ■ なぜ一覧より上なのか
      1. 作品の画像が汎用画像になることがある理由（権利者が許可しない画像は載せない）
      2. 下の一覧に**作品を探す入力欄がある**こと
      この2つは、読者が一覧を触る前に知っているほうが役に立つ。読む順がそのまま並び順。

    ■ 画像は後から差し替わる
      いまは仮の汎用画像（public/guide-thumb.svg）。
      **src/assets/services/guide.png などを置けば、そちらが自動で優先される**
      （Thumb は image → src の順に見る）。コードは直さなくてよい。

    ■ 狭い画面では枠ごと消える
      1200px 未満ではこの枠も出ないので、**フッターにも同じリンクを置いてある**
      （components/Footer.astro）。片方だけ消さないこと。
  */}
  <nav class="block" aria-label="当サイトの運営方針および活用について">
    <p class="block-title">当サイトの運営方針および活用について</p>
    <ul class="cards">
      <li>
        <GuideTag
          class:list={['rail-card', guideIsCurrent && 'is-current']}
          href={guideIsCurrent ? undefined : GUIDE.href}
          aria-current={guideIsCurrent ? 'page' : undefined}
        >
          {/* サムネイルの扱いは下の一覧と同じ。48px・角丸8で並びをそろえる */}
          <Thumb image={serviceImage('guide')} src="/guide-thumb.svg" size={48} radius={8} />
          <span class="body">
            <span class="stamp">{GUIDE.lead}</span>
            <span class="name">{GUIDE.name}</span>
          </span>
        </GuideTag>
      </li>
    </ul>
  </nav>

  <nav class="block" aria-label="新着配信・終了一覧">
    <p class="block-title">新着配信・終了一覧</p>
    {/*
      検索窓（WorkSearch.astro）があることを知らせて、使ってもらうための一文。
      ★ 検索できるのは各カードの**リンク先**であって、この枠ではない。
        文面を変えるときも「この枠で検索できる」と読める書き方にしないこと。
    */}
    <p class="block-note">更新タイトルを検索できます</p>
    <ul class="cards">
      {
        EVERGREEN_PAGES.map((p) => {
          const isCurrent = p.href === current
          /*
           * ★ いつ更新された一覧なのかを名前の頭に出す（2026-08-25）。
           *   ここは「最新の一覧」を名乗る枠なので、日付が無いと
           *   読者にはいつの情報か分からない。
           *   日付は `evergreenStamp()` が組む（ページ側の「時点」と対になる）。
           */
          const stamp = evergreenStamp(evergreenSummary(p).dataAsOf)
          const Inner = (
            <>
              {/*
                ★ サムネイルは **Thumb.astro に任せる**（2026-08-28）。
                  以前はここで自前に <Image width={48} height={48}> を書いていたが、
                  等倍の48pxしか出さないので高精細画面でぼやけていた
                  （画像が無く頭文字だったころは誰も気づけなかった）。
                  Thumb は表示サイズの2倍を書き出す。記事カード・追従枠と同じ部品。
                  画像が無いときのタイルもカテゴリ色にそろう（それが Thumb の設計）。
              */}
              <Thumb
                image={serviceImage(p.thumbKey)}
                category={p.category}
                size={48}
                radius={8}
                initial={p.label.charAt(0)}
              />
              <span class="body">
                <span class="badge" data-category={p.category}>
                  {CATEGORIES[p.category].label}
                </span>
                {stamp && <span class="stamp">{stamp}</span>}
                <span class="name">{p.shortLabel}</span>
              </span>
            </>
          )
          return (
            <li>
              {/* 現在地は消さずに、リンクだけ外す。並びを崩さないため */}
              {isCurrent ? (
                <span class="rail-card is-current" aria-current="page">
                  {Inner}
                </span>
              ) : (
                <a class="rail-card" href={p.href}>
                  {Inner}
                </a>
              )}
            </li>
          )
        })
      }
    </ul>
  </nav>

  {/*
    ★ 3つ目の枠（2026-08-30 追加）。人物ページ（pages/person/[id].astro）への導線。
      docs/STOCK.md の S-3。

    ■ なぜ一覧の**下**なのか
      このサイトの用は「いつ観られなくなるか」で、それを担うのは上の2枠。
      人物から探すのは**その次に来る探し方**なので、順番でそう示す。

    ■ カードにしていない理由
      人物には絵が無い（Wikidata から取っているのは名前だけ）。
      48pxのタイルに頭文字だけを6つ並べても手掛かりにならず、
      枠が縦に伸びるだけになる。**名前と本数の行にする。**
  */}
  {
    railPeople.length > 0 && (
      <nav class="block" aria-label="監督・出演者から探す">
        <p class="block-title">監督・出演者から探す</p>
        <p class="block-note">作品の多い順</p>
        <ul class="people">
          {railPeople.map((p) => {
            const href = `/person/${p.id}`
            const isCurrent = href === current
            return (
              <li>
                {/* 現在地はリンクを外す。並びは崩さない（上の一覧と同じ扱い） */}
                {isCurrent ? (
                  <span class="person is-current" aria-current="page">
                    <span class="person-name">{p.name}</span>
                    <span class="person-count">{p.works.length}本</span>
                  </span>
                ) : (
                  <a class="person" href={href}>
                    <span class="person-name">{p.name}</span>
                    <span class="person-count">{p.works.length}本</span>
                  </a>
                )}
              </li>
            )
          })}
        </ul>
        <p class="block-more">
          <a href="/person">すべての監督・出演者（{peopleTotal}人）</a>
        </p>
      </nav>
    )
  }
</aside>

<style>
  /* 表示・非表示と配置は styles/global.css の .layout 側。ここは中身の見た目だけ。 */
  .block {
    max-width: 17rem;
    /*
     * 幅の広い画面では左の列が本文よりずっと広くなる。
     * 左端に置くと本文から離れて孤立するので、本文側（右）に寄せる。
     */
    margin-left: auto;
  }
  /* 枠が2つ縦に並ぶ。カード同士（0.4rem）よりはっきり離して、別の枠だと分かるようにする */
  .block + .block {
    margin-top: 1.4rem;
  }
  /*
   * ★ この見出しはカードの外＝**背景の紺の上に直接載る**。
   *   --text-muted（本文用の暗いグレー）だと紺に沈んで読めない。
   *   地の上に置く文字用の明るい色を使う（フッターと同じ考え方）。
   *   docs/APPEARANCE.md「文字は白いカードの中にしか置かないこと」の例外なので、
   *   色を変えるときはコントラストを必ず確認する。
   */
  .block-title {
    margin: 0 0 0.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    /*
     * 枠の内側は約203pxしかなく、長い見出し（「当サイトの運営方針および活用について」）は
     * 2行になる。既定の行間だと2行目が詰まって読みにくいので明示する。
     */
    line-height: 1.45;
    color: var(--footer-text);
  }
  /* 見出しの補足。見出しと同じく地の上に載るので色は同系のまま、太さと大きさで差をつける */
  .block-note {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--footer-text);
  }

  /*
   * 人物の行。カード（.rail-card）より薄く作る。
   * 絵が無いぶん高さを詰めて、6行でも枠が伸びすぎないようにする。
   */
  .people {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .person {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
  }
  a.person:hover {
    border-color: var(--accent);
  }
  .person.is-current {
    background: var(--bg-subtle);
    border-color: var(--accent);
  }
  .person-name {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
  }
  a.person:hover .person-name {
    color: var(--accent);
  }
  /* 本数は補足。折り返させない（「3」「本」で割れる） */
  .person-count {
    flex: none;
    font-size: 0.68rem;
    white-space: nowrap;
    color: var(--text-muted);
  }
  /*
   * 「すべての監督・出演者」。**上の人物の行と同じ枠に入れる**（2026-08-30）。
   * 地の紺の上に文字だけで置くと、枠の外にこぼれた注記のように見えて
   * 押せることが伝わらない。**人物と同じ体裁にして、並びの続きに見せる。**
   */
  .block-more {
    margin: 0.3rem 0 0;
  }
  .block-more a {
    display: block;
    padding: 0.35rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    /* 枠の中＝白いカードの上なので、地の上用の色（--footer-link）は使わない */
    color: var(--text-muted);
  }
  .block-more a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rail-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    /*
     * サムネイル 48px ＋ 上下padding で 64px。
     * 文字が2行になってもこの高さを下回らせないことで、
     * カードの高さが揃い、縦の並びが乱れない。
     */
    min-height: 64px;
    padding: 0.45rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
  }
  a.rail-card:hover {
    border-color: var(--accent);
  }
  /* 現在地。押せないことが分かる見た目にする（項目自体は消さない） */
  .rail-card.is-current {
    background: var(--bg-subtle);
    border-color: var(--accent);
  }
  /* サムネイルの見た目は Thumb.astro が持つ。ここで上書きしないこと。 */
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
  }
  .badge {
    font-size: 0.68rem;
    padding: 0.05rem 0.45rem;
  }
  /*
   * ★ サービス名だけ左に 0.4rem 寄せる。**見た目を揃えるための補正。**
   *
   * 3行はどれも同じ x から始まっているのに、文字が出てくる位置だけずれる。
   *   バッジ … 背景の内側に padding(0.45rem) があるので、文字は 7.2px 内側から
   *   更新日 … `【` は字面が右半分に寄っている全角なので、インクは 6px 内側から
   *   サービス名 … 補正が無いので 0px（＝この行だけ左に飛び出して見える）
   * 実測値（Edge・1280px）で確認したうえで、上2行の中間に合わせてある。
   */
  .name {
    padding-left: 0.4rem;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
  }
  /*
   * 更新日。**サービス名より小さく、バッジと同じ大きさにする。**
   * ここの主役はサービス名なので、同じ大きさで並べると日付のほうが
   * 文字数が多いぶん目立ってしまい、カードの主従が崩れる。
   * バッジ（0.68rem）に揃えることで、日付とカテゴリが同じ「補足」の段に見える。
   *
   * **日付の途中では折り返させない。** 日本語は原則どこでも折り返せるので、
   * 指定しないと「【2026年8月25」／「日更新】Netflix」のように割れる。
   * この大きさなら枠幅（1200px時点で約158px）に1行で収まる。
   */
  .stamp {
    display: block;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.3;
    /*
     * 補足の色だが、鮮度を伝える文字なので **muted のままだと薄すぎる。**
     * 本文色へ 45% 寄せて、サービス名より弱く・バッジより読めるくらいにする。
     * 明暗どちらのテーマでも同じ比率で寄るので、片方だけ沈むことがない。
     */
    color: var(--text-muted);
    color: color-mix(in srgb, var(--text-muted) 55%, var(--text));
  }
  a.rail-card:hover .name {
    color: var(--accent);
  }
</style>
