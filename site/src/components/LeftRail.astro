---
import Thumb from './Thumb.astro'
import { CATEGORIES, EVERGREEN_BADGE } from '../config'
import { EVERGREEN_PAGES } from '../lib/evergreen'
import { serviceImage } from '../lib/images'
import { publishablePeople, topPeople } from '../lib/people'

/**
 * 本文の**左**の余白に置く枠。上から順に3つ。
 *   1. 新着配信・終了一覧（常設ページの一覧。2026-08-27 に
 *      「最新の配信終了・配信開始一覧」から改称）
 *   2. 監督・出演者から探す（人物ページへの導線。2026-08-30 追加）
 *   3. 当サイトの運営方針および活用について（1枚だけ。行き先は pages/guide.astro）
 * ★ **3 は最下段へ移した**（2026-09-10）。それまでは最上段に置いて
 *   「画像が汎用画像のことがある理由」と「一覧に検索欄があること」を
 *   先に伝えていたが、探すための枠（1・2）を上に寄せる並びに変えた。
 *
 * ■ なぜ左に分けたか（2026-08-24）
 * 以前は右の追従枠（FollowRail.astro）の1ブロック目に入れていたが、
 * サービスが増えるほど枠が縦に伸び、その下の「新着記事」とPR枠が
 * 画面外へ押し出されていた。**常設ページ一覧は左、記事とPRは右**に分けて、
 * どちらも画面の上のほうから始まるようにしている。
 *
 * ■ 追従させない
 * 追従するのは右のPR枠だけ（理由は FollowRail.astro の説明）。
 * ここは本文と一緒に流す。
 *
 * ■ 並びは全ページで固定（重要）
 * 「いま見ているページのカードを消す」実装に戻さないこと。
 * ページを移動するたびに一覧の中身と順番が変わり、読者が混乱する
 * （2026-08-23 の判断）。常に同じ順で全件出し、現在地のカードだけ
 * リンクを外して `aria-current="page"` を付けている。
 *
 * ■ 出す条件
 * 画面幅 75rem(1200px) 以上（styles/global.css の `.layout`）。
 * **狭い画面では枠ごと消える**ので、常設ページへの導線は
 * カテゴリ×サービスのページ（/category/<ハブ>/<サービス>）にも置いてある。
 * そちらが狭い画面での入口で、ヘッダーのメニューから2手で辿り着く
 * （2026-08-27。それまではカテゴリのハブに常設カードを並べていた）。
 */

/** 現在地の判定にだけ使う。**項目の出し分けには使わない。** */
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '')

/**
 * 一覧の**下**に置く固定ページ（2026-08-29 追加。2026-09-10 に最下段へ移動）。
 *   1. pages/guide.astro    … 【はじめての方へ】
 *   2. pages/citation.astro … 【引用・取材の方へ】（2026-09-16 追加。docs/PARTNERSHIPS.md の P-2）
 *
 * 常設ページ（EVERGREEN_PAGES）と違って中身が入れ替わらないので、
 * lib/evergreen.ts には入れていない。**カードの体裁だけをそろえてある。**
 *
 * ★ **文字数に上限がある。** 枠の内側でサムネイルの右に使える幅は約130px
 *   （下の `.tags` の計算）。
 *   `lead` は折り返さない（`.stamp` が nowrap）ので **0.68rem で11字まで**、
 *   `name` は左の補正0.4remを引いて **0.86rem で8字まで**が1行に入る。
 *   超えると `lead` ははみ出し、`name` は2行になってカードが伸びる。
 */
const FIXED_PAGES = [
  {
    href: '/guide',
    /** カードの小さい行。カテゴリを持たないので、バッジの代わりに置く */
    lead: '【はじめての方へ】',
    /** カードの太い行。枠の見出しと同じ文言を繰り返さない長さにする */
    name: '運営方針と活用法',
    thumb: { key: 'guide', src: '/guide-thumb.svg' },
  },
  {
    href: '/citation',
    lead: '【引用・取材の方へ】',
    name: '出典の書き方',
    thumb: { key: 'citation', src: '/citation-thumb.svg' },
  },
] as const

/**
 * 3つ目の枠に出す人物の数（2026-08-30 追加）。
 *
 * ★ **枠を縦に伸ばしすぎないこと。** 上に常設ページのカードが5枚あり、
 *   ここを長くすると左の列だけが本文より下まで伸びる。
 *   全員への経路は `/person`（一覧）が持つので、ここは入口の見本でよい。
 *
 * ★ 顔ぶれと並びは**全ページで固定**（作品の多い順）。
 *   見ているページに合わせて入れ替えると、移動のたびに枠の中身が変わる
 *   （この枠の「並びは全ページで固定」と同じ理由）。
 */
const RAIL_PEOPLE = 6

/*
 * ■ 一度3枚（サービス1社1枚の配信カレンダー）に畳んで、**5枚に戻した**（2026-09-07）
 *
 * 畳んだ形では、カードの外に「終了予定／新着」の小さいリンクを付け足す必要があった
 * （リンクの中にリンクは置けないため）。**カードの下に文字がぶら下がる見た目が悪い。**
 *
 * 戻したうえで、**升目そのものは5ページの中に入れた**
 * （pages/leaving/[service].astro と pages/arrivals/[service].astro の EventCalendar）。
 * 読者が得たかったもの（日付から入る）は各ページが持っているので、
 * この枠は従来どおり「どの一覧へ行くか」だけを担えばよい。
 *
 * ★ `/calendar/<サービス>`（終了と新着を1枚にまとめたページ）は**残してあるが、
 *   この枠からは外した。** 行き先は各常設ページの末尾の関連リンクだけ。
 */

const railPeople = topPeople(RAIL_PEOPLE)
const peopleTotal = publishablePeople().length
---

<aside class="left-rail">
  <nav class="block" aria-label="新着配信・終了一覧">
    <p class="block-title">新着配信・終了一覧</p>
    {/*
      枠の中身ではなく、**リンク先で何ができるか**を伝える一文。
      ★ 升目（EventCalendar.astro）も検索窓（WorkSearch.astro）も、
        あるのは各カードの**リンク先**であって、この枠ではない。
        文面を変えるときも「この枠で探せる」と読める書き方にしないこと。
    */}
    <p class="block-note">カレンダーと検索で探せます</p>
    <ul class="cards">
      {
        EVERGREEN_PAGES.map((p) => {
          const isCurrent = p.href === current
          /*
           * ★ **更新日（`【2026年9月14日更新】`）は外した**（2026-09-15）。
           *   2026-08-25 に「いつ時点の一覧か」を伝えるために入れたものだが、
           *   その役目は隣に立てた「随時更新」のバッジが引き取った。
           *   日付そのものはリンク先の見出し（`evergreenTitle()`）が必ず出しており、
           *   カード3行のうち1行を使って枠の外で先に言う必要が無い。
           *   **書き戻さないこと。**戻すならバッジとどちらかにする。
           */
          const Inner = (
            <>
              {/*
                ★ サムネイルは **Thumb.astro に任せる**（2026-08-28）。
                  以前はここで自前に <Image width={48} height={48}> を書いていたが、
                  等倍の48pxしか出さないので高精細画面でぼやけていた
                  （画像が無く頭文字だったころは誰も気づけなかった）。
                  Thumb は表示サイズの2倍を書き出す。記事カード・追従枠と同じ部品。
                  画像が無いときのタイルもカテゴリ色にそろう（それが Thumb の設計）。
              */}
              <Thumb
                image={serviceImage(p.thumbKey)}
                category={p.category}
                size={48}
                radius={8}
                initial={p.label.charAt(0)}
              />
              <span class="body">
                {/*
                  ★ **カテゴリと「随時更新」を1行に並べる**（2026-09-15 追加）。
                    この枠に並んでいるのは常設ページだけなのに、カードには
                    カテゴリバッジしか無く、記事カード（PostCard）と同じ見た目だった。
                    一覧の中の常設カード（EvergreenCard）には最初から付いているので、
                    **同じものへの入口なのに枠と一覧で名乗りが違う**状態になっていた。
                    文言と理由は config.ts の EVERGREEN_BADGE、色は
                    styles/global.css の .badge.evergreen。
                */}
                <span class="tags">
                  <span class="badge" data-category={p.category}>
                    {CATEGORIES[p.category].label}
                  </span>
                  <span class="badge evergreen">{EVERGREEN_BADGE.label}</span>
                </span>
                <span class="name">{p.shortLabel}</span>
              </span>
            </>
          )
          return (
            <li>
              {/* 現在地は消さずに、リンクだけ外す。並びを崩さないため */}
              {isCurrent ? (
                <span class="rail-card is-current" aria-current="page">
                  {Inner}
                </span>
              ) : (
                <a class="rail-card" href={p.href}>
                  {Inner}
                </a>
              )}
            </li>
          )
        })
      }
    </ul>
  </nav>

  {/*
    ★ 3つ目の枠（2026-08-30 追加）。人物ページ（pages/person/[id].astro）への導線。
      docs/STOCK.md の S-3。

    ■ なぜ一覧の**下**なのか
      このサイトの用は「いつ観られなくなるか」で、それを担うのは上の2枠。
      人物から探すのは**その次に来る探し方**なので、順番でそう示す。

    ■ カードにしていない理由
      人物には絵が無い（Wikidata から取っているのは名前だけ）。
      48pxのタイルに頭文字だけを6つ並べても手掛かりにならず、
      枠が縦に伸びるだけになる。**名前と本数の行にする。**
  */}
  {
    railPeople.length > 0 && (
      <nav class="block" aria-label="監督・出演者から探す">
        <p class="block-title">監督・出演者から探す</p>
        <p class="block-note">作品の多い順</p>
        <ul class="people">
          {railPeople.map((p) => {
            const href = `/person/${p.id}`
            const isCurrent = href === current
            return (
              <li>
                {/* 現在地はリンクを外す。並びは崩さない（上の一覧と同じ扱い） */}
                {isCurrent ? (
                  <span class="person is-current" aria-current="page">
                    <span class="person-name">{p.name}</span>
                    <span class="person-count">{p.works.length}本</span>
                  </span>
                ) : (
                  <a class="person" href={href}>
                    <span class="person-name">{p.name}</span>
                    <span class="person-count">{p.works.length}本</span>
                  </a>
                )}
              </li>
            )
          })}
        </ul>
        <p class="block-more">
          <a href="/person">すべての監督・出演者（{peopleTotal}人）</a>
        </p>
      </nav>
    )
  }

  {/*
    ★ 左の列の**最下段**に置く枠（2026-08-29 追加。2026-09-10 に最上段からここへ移動）。
      中身は2枚（2026-09-16 に「引用・取材の方へ」を足した）。

    ■ なぜ最下段なのか
      この枠が伝えるのは
        1. 作品の画像が汎用画像になることがある理由（権利者が許可しない画像は載せない）
        2. 上の一覧に**作品を探す入力欄がある**こと
      の2つ。**探すための枠（一覧・人物）を先に見せる**並びにしたので、
      補足にあたるこの枠は上の2枠のあとに置く。

    ■ 画像は後から差し替わる
      いまは仮の汎用画像（public/guide-thumb.svg）。
      **src/assets/services/guide.png などを置けば、そちらが自動で優先される**
      （Thumb は image → src の順に見る）。コードは直さなくてよい。

    ■ 狭い画面では枠ごと消える
      1200px 未満ではこの枠も出ないので、**フッターにも同じリンクを置いてある**
      （components/Footer.astro）。片方だけ消さないこと。**2枚とも。**
  */}
  {/*
    ★ 見出し（.block-title）は**わざと出していない**（2026-08-31）。
      カードの太い行「運営方針と活用法」と同じことを二度言うだけで、
      枠の内側203pxでは2行に折り返して枠を無駄に伸ばしていた。
      **aria-label は残す。** 見出しが無いので、この枠の名前はこれだけになる。
      2枚目を足したので、名前は2枚をまとめて呼べるものに変えた（2026-09-16）。
  */}
  <nav class="block" aria-label="当サイトについて">
    <ul class="cards">
      {
        FIXED_PAGES.map((p) => {
          const isCurrent = p.href === current
          /*
           * 現在地はリンクだけ外す（上の一覧と同じ扱い）。
           * **外側のタグだけを差し替えて中身は1つに保つ。**
           * 分岐でカードごと書き分けると、片方だけ直したときに見た目がずれる。
           */
          const Tag = isCurrent ? 'span' : 'a'
          return (
            <li>
              <Tag
                class:list={['rail-card', isCurrent && 'is-current']}
                href={isCurrent ? undefined : p.href}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {/* サムネイルの扱いは上の一覧と同じ。48px・角丸8で並びをそろえる */}
                <Thumb image={serviceImage(p.thumb.key)} src={p.thumb.src} size={48} radius={8} />
                <span class="body">
                  <span class="stamp">{p.lead}</span>
                  <span class="name">{p.name}</span>
                </span>
              </Tag>
            </li>
          )
        })
      }
    </ul>
  </nav>
</aside>

<style>
  /* 表示・非表示と配置は styles/global.css の .layout 側。ここは中身の見た目だけ。 */
  .block {
    max-width: 17rem;
    /*
     * 幅の広い画面では左の列が本文よりずっと広くなる。
     * 左端に置くと本文から離れて孤立するので、本文側（右）に寄せる。
     */
    margin-left: auto;
  }
  /* 枠が2つ縦に並ぶ。カード同士（0.4rem）よりはっきり離して、別の枠だと分かるようにする */
  .block + .block {
    margin-top: 1.4rem;
  }
  /*
   * ★ この見出しはカードの外＝**背景の紺の上に直接載る**。
   *   --text-muted（本文用の暗いグレー）だと紺に沈んで読めない。
   *   地の上に置く文字用の明るい色を使う（フッターと同じ考え方）。
   *   docs/APPEARANCE.md「文字は白いカードの中にしか置かないこと」の例外なので、
   *   色を変えるときはコントラストを必ず確認する。
   */
  .block-title {
    margin: 0 0 0.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    /*
     * 枠の内側は約203pxしかなく、長い見出し（「当サイトの運営方針および活用について」）は
     * 2行になる。既定の行間だと2行目が詰まって読みにくいので明示する。
     */
    line-height: 1.45;
    color: var(--footer-text);
  }
  /* 見出しの補足。見出しと同じく地の上に載るので色は同系のまま、太さと大きさで差をつける */
  .block-note {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--footer-text);
  }

  /*
   * 人物の行。カード（.rail-card）より薄く作る。
   * 絵が無いぶん高さを詰めて、6行でも枠が伸びすぎないようにする。
   */
  .people {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .person {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
  }
  a.person:hover {
    border-color: var(--accent);
  }
  .person.is-current {
    background: var(--bg-subtle);
    border-color: var(--accent);
  }
  .person-name {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
  }
  a.person:hover .person-name {
    color: var(--accent);
  }
  /* 本数は補足。折り返させない（「3」「本」で割れる） */
  .person-count {
    flex: none;
    font-size: 0.68rem;
    white-space: nowrap;
    color: var(--text-muted);
  }
  /*
   * 「すべての監督・出演者」。**上の人物の行と同じ枠に入れる**（2026-08-30）。
   * 地の紺の上に文字だけで置くと、枠の外にこぼれた注記のように見えて
   * 押せることが伝わらない。**人物と同じ体裁にして、並びの続きに見せる。**
   */
  .block-more {
    margin: 0.3rem 0 0;
  }
  .block-more a {
    display: block;
    padding: 0.35rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    /* 枠の中＝白いカードの上なので、地の上用の色（--footer-link）は使わない */
    color: var(--text-muted);
  }
  .block-more a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rail-card {
    display: flex;
    align-items: center;
    /* サムネイルと文字のすきま。ここも 0.1rem 詰めて文字の幅に回している（上の★） */
    gap: 0.5rem;
    /*
     * カード1枚の高さ。**79px は右の枠（シリーズ配信）の78pxに合わせた値**
     * （2026-09-15。実測で左79.5px / 右78.0px）。
     *
     * ★ もともとは「サムネイル48px ＋ 上下padding」で 64px と書いてあったが、
     *   実際の高さを決めていたのは**文字の3行**（バッジ・更新日・サービス名）で、
     *   カードは常に79.5pxあった。更新日の行を外した（上の `Inner` の★）ときに
     *   64pxまで縮み、**左の枠だけカードが小さくなって左右の並びが崩れた。**
     *   高さの根拠を文字の行数からこの値に移して、明示的に揃える。
     *
     * ★ **右の枠を変えたらここも見ること。** 左右で高さが違うと、
     *   本文を挟んだ2列の横の線がそろわない。
     * ★ サムネイルは48pxのまま。60px（右の枠と同じ）にすると横幅を12px食い、
     *   下の `.tags` のバッジ2枚が1行に収まらなくなる。
     */
    min-height: 79px;
    /*
     * ★ 横の余白は 0.45rem（2026-09-15 に 0.6rem から詰めた）。
     *   バッジ2枚を1行に収めるために、文字が使える幅を左右で 4.8px 稼いでいる。
     *   下の `.tags` の計算はこの値を前提にしている。戻すなら一緒に見直すこと。
     */
    padding: 0.45rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
  }
  a.rail-card:hover {
    border-color: var(--accent);
  }
  /* 現在地。押せないことが分かる見た目にする（項目自体は消さない） */
  .rail-card.is-current {
    background: var(--bg-subtle);
    border-color: var(--accent);
  }
  /* サムネイルの見た目は Thumb.astro が持つ。ここで上書きしないこと。 */
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
  }
  /*
   * バッジ2枚を**1行に収めるための寸法**（2026-09-15）。
   *
   * ■ 使える幅（枠がいちばん狭い1200px。それ未満では枠ごと消える）
   *   列232px − 枠の横padding 28.8 ＝ カード203.2px
   *   − 枠線2 − カードの横padding 14.4 − サムネ48 − すきま8 ＝ **約130px**
   *
   * ■ 要る幅
   *   「配信終了予定」6字 ＋ 「随時更新」4字 ＝ 10字。日本語は1字＝1em なので
   *   0.62rem（9.92px）で約99px。バッジの横padding（0.26rem×2×2枚）と
   *   すきま3.2px を足して**約119px**。**余りは約11px（9%）。**
   *
   * ★ **既定の0.76remでも0.68remでも入らない**（それぞれ約143px／約133px要る）。
