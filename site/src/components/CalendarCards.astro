---
import Thumb from './Thumb.astro'
import { EVERGREEN_BADGE } from '../config'
import { CALENDAR_CARDS, calendarThumb } from '../lib/evergreen'
import { serviceImage } from '../lib/images'

interface Props {
  /**
   * いま開いているページのパス（`.html` と末尾の `/` を落としたもの）。
   * 一致したカードだけリンクを外して `aria-current` を付ける。**並びは変えない。**
   */
  current?: string
}

const { current = '' } = Astro.props

/**
 * 配信カレンダーのカード（サービス1社1枚）。**左の枠の中段。1200px 以上でだけ出る。**
 * 使っているのは LeftRail.astro だけ。狭い画面では枠ごと消え、
 * 代わりにトップの横スクロールの棚（TopCalendar.astro）が同じ行き先を出す
 * （**あちらは別の形**＝132pxの横カード。中身の定義 `CALENDAR_CARDS` だけ共有している）。
 *
 * ■ 2026-09-19 に右の枠「シリーズ配信」と同じ形にそろえた（運用者の指定）
 * 絵を 48px → **60px**（右の枠と同じ）にし、枠・余白・文字も SeriesRail.astro に合わせた。
 * 題名は**行き先の h1 そのまま**で、長ければ2行で切る。
 *
 * ★ 寸法を触るときは**3か所まとめて**見ること。ずれると左の枠の中や、
 *   本文を挟んだ左右の枠で横の線がそろわない。
 *     components/SeriesRail.astro（右の枠・**ここが基準**）
 *     components/LeftRail.astro の FIXED_PAGES（左の枠の下段）
 *     このファイル（左の枠の中段）
 */
---

<ul class="cards">
  {
    CALENDAR_CARDS.map((p) => {
      const isCurrent = p.href === current
      /*
       * ★ **カードの絵は、そのカレンダーの今月の作品のポスター**（2026-09-17・運用者の指定）。
       *   選び方は lib/evergreen.ts の `calendarThumb`（今月の早い日付のアニメ → 無ければ全ジャンル）。
       *   ポスターが1枚も無い月だけ、従来の汎用画像（src/assets/services/<キー>）に戻る。
       */
      const poster = calendarThumb(p.category, p.thumbKey)
      /*
       * ★ **更新日（`【2026年9月14日更新】`）は外した**（2026-09-15）。
       *   2026-08-25 に「いつ時点の一覧か」を伝えるために入れたものだが、
       *   その役目は隣に立てた「随時更新」のバッジが引き取った。
       *   日付そのものはリンク先の見出し（`evergreenTitle()`）が必ず出しており、
       *   カード3行のうち1行を使って枠の外で先に言う必要が無い。
       *   **書き戻さないこと。**戻すならバッジとどちらかにする。
       */
      const Inner = (
        <>
          {/*
            ★ サムネイルは **Thumb.astro に任せる**（2026-08-28）。
              以前はここで自前に <Image width={48} height={48}> を書いていたが、
              等倍の48pxしか出さないので高精細画面でぼやけていた
              （画像が無く頭文字だったころは誰も気づけなかった）。
              Thumb は表示サイズの2倍を書き出す。記事カード・追従枠と同じ部品。
              画像が無いときのタイルもカテゴリ色にそろう（それが Thumb の設計）。
          */}
          <Thumb
            image={poster ? undefined : serviceImage(p.thumbKey)}
            src={poster}
            category={p.category}
            size={60}
            initial={p.label.charAt(0)}
          />
          <span class="body">
            {/*
              ★ **カテゴリと「随時更新」を1行に並べる**（2026-09-15 追加）。
                この枠に並んでいるのは常設ページだけなのに、カードには
                カテゴリバッジしか無く、記事カード（PostCard）と同じ見た目だった。
                一覧の中の常設カード（EvergreenCard）には最初から付いているので、
                **同じものへの入口なのに枠と一覧で名乗りが違う**状態になっていた。
                文言と理由は config.ts の EVERGREEN_BADGE、色は
                styles/global.css の .badge.evergreen。
            */}
            <span class="tags">
              {/*
                ★ 「カレンダー」のバッジは**外した**（2026-09-19・運用者の指定）。
                  2026-09-17 からカードはサービス1社1枚で、カテゴリ（「配信終了予定」など）を
                  名乗れないので「カレンダー」と出していたが、行き先の見出しが
                  「Netflix 見放題・配信終了カレンダー」と名乗るようになり、重複した。
                  **書き戻さないこと。**（TopCalendar.astro も同時に外してある）
              */}
              <span class="badge evergreen">{EVERGREEN_BADGE.label}</span>
            </span>
            {/*
              ★ **行き先の h1 をそのまま名乗る**（2026-09-19・運用者の指定。トップの棚と同じ）。
                それまではサービス名の短い名前（`shortLabel`）で、**押した先の見出しと
                カードの名前が別物**だった。名前は lib/evergreen.ts の `titleBase` の1か所から来る。
              ★ **【9月18日更新】は付けない。** その役目は隣の「随時更新」のバッジが引き取っている
                （上の★。2026-09-15 の判断）。戻すならバッジとどちらかにすること。
            */}
            <span class="name">{p.titleBase}</span>
          </span>
        </>
      )
      return (
        <li>
          {/* 現在地は消さずに、リンクだけ外す。並びを崩さないため */}
          {isCurrent ? (
            <span class="rail-card is-current" aria-current="page" title={p.titleBase}>
              {Inner}
            </span>
          ) : (
            /* ★ `title` は**2行で切られた題名の全文**（右の枠の `fullTitle` と同じ扱い） */
            <a class="rail-card" href={p.href} title={p.titleBase}>
              {Inner}
            </a>
          )}
        </li>
      )
    })
  }
</ul>

<style>
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  /*
   * カード1枚。**値は右の枠「シリーズ配信」（SeriesRail.astro の `.item`）と同じ。**
   * 2026-09-19 にそちらへ寄せた（運用者の指定。絵の大きさを含めて）。
   * ★ 左の枠の下段の固定ページのカード（LeftRail.astro の FIXED_PAGES）とも同じ値。
   *   **3か所そろえること**（片方だけ変えると左の枠の中や、本文を挟んだ左右で段差が出る）。
   * ★ 高さ 78px は**指定していない。** 絵60 ＋ 上下padding 8×2 ＋ 枠線1×2 で自然にそうなる。
   */
  .rail-card {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
  }
  a.rail-card:hover {
    border-color: var(--accent);
  }
  /* 現在地。押せないことが分かる見た目にする（項目自体は消さない） */
  .rail-card.is-current {
    background: var(--bg-subtle);
    border-color: var(--accent);
  }
  /*
   * サムネイルの見た目は Thumb.astro が持つ。ここで上書きしないこと。
   * ★ `min-width: 0` が要る。無いと長い題名の最小幅で文字ブロックが広がり、枠から溢れる。
   */
  .body {
    min-width: 0;
    font-size: 0.68rem;
    line-height: 1.4;
  }
  /*
   * バッジ（「随時更新」）。**右の枠のカテゴリバッジと同じ大きさ。**
   * ★ 2026-09-15 に 0.62rem まで詰めてあったのは「カレンダー」との2枚を
   *   1行に収めるためで、その1枚は 2026-09-19 に外した。既定の大きさへ戻してある。
   */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem;
  }
  .badge {
    font-size: 0.68rem;
    padding: 0.05rem 0.45rem;
  }
  /* 枠線の1pxぶん padding を引く。引かないと隣のバッジより2px高くなる */
  .badge.evergreen {
    padding: calc(0.05rem - 1px) calc(0.45rem - 1px);
  }
  /*
   * 題名（行き先の h1）。**2行で切る**（右の枠と同じ）。切らないとカードが縦に伸びる。
   * ★ 切れた全文は `title` 属性が持っている（上の `Inner`）。
   */
  .name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
  }
  a.rail-card:hover .name {
    color: var(--accent);
  }
</style>
