---
import { amazonTagFor } from '../config'
import { amazonVideoSearchUrl, withAmazonTag } from '../lib/affiliate'
import { ctaQueryFor } from '../lib/page-intent'
import type { CategorySlug } from '../config'

interface Props {
  /**
   * 記事カテゴリ。文面を変えるために使う。
   * 未指定ならトップページ等の汎用文面になる。
   */
  category?: CategorySlug
  /**
   * 検索語。
   *
   * ★ **省略してよい。** 省略した場合は、そのページに来ている検索語か
   *   シリーズ記事の主題から自動で決まる（src/lib/page-intent.ts）。
   *   どちらも決まらなければ、従来どおり Prime Video の売り場トップへ送る。
   *   作品ページと人物ページのように**呼び出し側が主題を知っている**ときだけ
   *   明示的に渡すこと。渡された値が最優先される。
   */
  query?: string
}

const { category, query } = Astro.props
const tag = amazonTagFor('cta')

/**
 * この枠が送る先の検索語。
 *
 * ★ 検索エンジンは検索語をリファラに渡さないので、**訪問者ごとには決められない。**
 *   決まるのはページ単位で、しかもビルド時。全員に同じHTMLが出る
 *   （リファラでサーバ側の出し分けをするとクローキングになる）。
 */
const subject = query ?? (await ctaQueryFor(Astro.url.pathname))

/**
 * Amazon への導線。
 *
 * ■ なぜ Amazon だけ別扱いなのか
 * 対象4社のうち、2026-08 時点でアフィリエイト提携できるのは Amazon だけ。
 * Netflix は公式プログラムが存在せず、Disney+ と Apple TV+ は招待制。
 * つまり「自分がデータを持っている作品」で唯一収益化できる導線がここ。
 *
 * ■ 文面が category で変わる理由
 * 配信終了記事の読者は**もう見放題では観られない**。
 * そこに「見放題で探す」と出すのは誤誘導になる。
 * 一方でレンタル・購入なら観られることが多く、これは事実として言える。
 * 記事タイプごとに、言えることだけを言う。
 *
 * ■ 収益の実体はクッキー
 * 見放題作品を観るだけでは紹介料は発生しない。
 * Amazon は**クリックから24時間**、その訪問者のあらゆる購入が成果になる。
 * だからリンク先が売り場トップでも意味がある。
 *
 * ★ トラッキングIDが未設定なら描画しない。
 *   タグの無い Amazon リンクを置いても1円にもならず、
 *   広告表記（PR）だけが出てしまうため。
 *
 * ■ 検索語が決まっているときは、それを文言にも出す（2026-09-03）
 * 「Prime Videoで作品を探す」とだけ書いてある枠は、押した先が何なのか分からない。
 * 主題が決まっているなら**押す前に分かる形**にする。
 * 決まっていないページでは今までどおりの汎用文面に落ちる。
 */
/*
 * ★ **説明文（lead）は 2026-09-14 に撤去した。** この枠はリンク1本だけになり、
 *   カテゴリごとの言い分けは**この action の1行が全部背負っている。**
 *   「配信終了の記事に『見放題で探す』と出すのは誤誘導」という線
 *   （上の「文面が category で変わる理由」）を守っているのはここだけ。
 */
const COPY: Record<string, { action: string }> = {
  leaving: { action: 'Prime Videoでレンタル・購入を探す' },
  ended: { action: 'Prime Videoでレンタル・購入を探す' },
  arrivals: { action: 'Prime Videoで作品を探す' },
  ranking: { action: 'Prime Videoで作品を探す' },
}

const fallback = { action: 'Prime Videoで作品を探す' }

const base = (category && COPY[category]) || fallback

/**
 * 主題が決まっているときの行動文。
 *
 * ★ 「観られる」と断定しないこと。当サイトは Amazon の在庫を持っていない。
 *   言ってよいのは「探せる」まで。**注記も説明文も無くなったので、
 *   この線を守っているのはこの文字列だけ。**
 */
const copy = subject ? { action: `「${subject}」をPrime Videoで探す` } : base

// 検索語があれば動画カテゴリ内検索、無ければ売り場トップ。
// どちらも tag= が付くのでクッキーは同じように効く。
const href = subject
  ? amazonVideoSearchUrl(subject, tag)
  : withAmazonTag('https://www.amazon.co.jp/gp/video/storefront', tag)
---

{
  tag && (
    <aside class="amazon-cta">
      {/*
        **リンク1本だけ**（2026-09-14・運用者の指定で説明文と注記を撤去）。

        撤去してよい理由:
          - Amazonアソシエイトの**必須の固定文は Footer にある**
            （「Amazonのアソシエイトとして、…は適格販売により収入を得ています」）。
            この枠は義務の文言を1つも持っていない
          - 広告（PR）表記は**ページ冒頭の `AffiliateNotice`**が出している
          - 「配信中と断定しない」線は**リンクの文字そのもの**が守っている
            （下の COPY。どれも「探す」で止めてあり、「観られる」と書かない）

        ★ だから **COPY の動詞を強めないこと。** 説明文と注記が無くなったぶん、
          誤誘導を防いでいるのは COPY の1行だけになった。
      */}
      <a
        class="action"
        href={href}
        rel="sponsored noopener"
        target="_blank"
        data-affiliate="true"
        data-slot="cta"
      >
        {copy.action}
      </a>
    </aside>
  )
}

<style>
  /*
   * 枠も背景も付けない（2026-09-14）。中身がリンク1本になったので、
   * カードの体裁だけ残すと**中身の無い箱**に見える。
   */
  .amazon-cta {
    margin: 2rem 0;
  }
  .action {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }
  .action:hover {
    opacity: 0.9;
  }
</style>
