---
import { CALENDAR_SERVICES } from '../lib/events-data'
import { shortOf, type CalendarDirection } from '../lib/evergreen'

interface Props {
  service: string
  direction: CalendarDirection
}

const { service, direction } = Astro.props

/**
 * 配信カレンダーの切り替え。**サービスと表示（終了／新着）を、開いて選ぶ。**
 *
 *   ［Netflix ▾］［配信終了 ▾］
 *
 * ■ 2026-09-17 にタブから作り替えた（運用者の指定）
 * 最初はサービス3つ・表示2つのタブを全部並べていた。**押せる丸が5つ並ぶだけで、
 * いま自分がどのサービスを見ているのかが分かりにくい**（現在地の塗りが埋もれる）。
 * ヘッダーのメニューと同じ「閉じているときは今の選択だけを見せ、押すと候補が開く」形にした。
 *
 * ★ **中身はただのリンク。** JavaScript で表を差し替えない。
 *   それぞれが検索から直接来られるページなので、URL が変わるのが正しい。
 * ★ サービスを替えても**表示は保つ**（Netflix の終了 → Prime Video の終了）。表示を替えてもサービスは保つ。
 * ★ 並びはサービスの定義順（events-data.ts の CALENDAR_SERVICES）。紹介料で並べ替えない。
 *
 * ■ 開閉は `<details>`。**補助のスクリプトはヘッダーのものが効いている**
 * `data-menu` を付けてあるので、components/Header.astro のスクリプトが
 * 「同時に開くのは1つだけ」「外を押したら閉じる」「Escで閉じる」を担う（全ページで読み込まれる）。
 * ★ **Header.astro の `[data-menu]` を変えたら、ここも見ること。**
 *   スクリプトが効かなくなっても `<details>` なので開閉はでき、壊れはしない。
 */
const SERVICES = CALENDAR_SERVICES.map((s) => ({
  key: s.key,
  label: shortOf(s.label),
  href: `/${direction}/${s.key}`,
}))

const DIRECTIONS: { key: CalendarDirection; label: string; href: string }[] = [
  { key: 'leaving', label: '配信終了', href: `/leaving/${service}` },
  { key: 'arrivals', label: '新着・配信予定', href: `/arrivals/${service}` },
]

const currentService = SERVICES.find((s) => s.key === service)!
const currentDirection = DIRECTIONS.find((d) => d.key === direction)!

const PICKS = [
  { key: 'service', name: 'サービス', current: currentService, options: SERVICES },
  { key: 'direction', name: '表示', current: currentDirection, options: DIRECTIONS },
]
---

<nav class="picker" aria-label="配信カレンダーの切り替え">
  {
    PICKS.map((p) => (
      <details class="pick" data-menu data-pick={p.key}>
        {/*
          ★ **押せる部品に見せる**（2026-09-17・運用者の指定）。
            枠・下の影・右端の丸い矢印の3つで「ここを押すと選べる」を伝える。
          ★ 「サービス」「表示」の名前は**画面に出さない**（運用者の指定）。読み上げにだけ残す。
            値（「Netflix」「配信終了」）だけで何を選ぶ部品か分かる。
        */}
        <summary>
          <span class="pick-text">
            <span class="visually-hidden">{p.name}：</span>
            <span class="pick-value" data-direction={p.key === 'direction' ? direction : undefined}>
              {p.current.label}
            </span>
          </span>
          <span class="pick-arrow" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="10" height="10">
              <path d="M2.5 4.5 6 8l3.5-3.5" />
            </svg>
          </span>
        </summary>
        <ul class="panel">
          {p.options.map((o) =>
            o.key === p.current.key ? (
              <li>
                <span class="option is-current" aria-current="page">
                  {o.label}
                </span>
              </li>
            ) : (
              <li>
                <a class="option" href={o.href}>
                  {o.label}
                </a>
              </li>
            ),
          )}
        </ul>
      </details>
    ))
  }
</nav>

<style>
  /*
   * 2つを**同じ幅で横に並べる**。「サービス」と「表示」が1組の操作盤に見えるように。
   * ★ 幅の上限を置く。本文幅いっぱいに伸ばすと、ボタンではなく帯に見える。
   * ★ 配信カレンダーの見出しの直下に入る（EventCalendar.astro の `picker` の差し込み口）。
   */
  .picker {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    max-width: 26rem;
    /* 下の絞り込みのボタンと詰まって見えないよう、影のぶん（2px）を足して空ける */
    margin: 0.2rem 0 0.85rem;
  }
  .pick {
    position: relative;
  }
  summary {
    /* 既定の三角は消す（右端の丸い矢印が代わり） */
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    /*
     * ★ 2026-09-17 に一回り小さくした（運用者の指定）。3rem・枠2px・影3px では
     *   下の絞り込みのボタンに食い込んで見えた。
     */
    min-height: 2.4rem;
    padding: 0.2rem 0.3rem 0.2rem 0.75rem;
    border: 1.5px solid var(--accent);
    border-radius: 10px;
    background: var(--bg);
    /* 下にだけ影を落として「押せる台」に見せる。押している間は沈める（:active） */
    box-shadow: 0 2px 0 color-mix(in srgb, var(--accent) 30%, transparent);
    cursor: pointer;
    transition:
      background-color 0.12s ease,
      transform 0.08s ease,
      box-shadow 0.08s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--accent-soft);
  }
  summary:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .pick[open] > summary {
    background: var(--accent-soft);
  }
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .pick-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }
  /*
   * いま選んでいる値。**ここがこの部品の主役**（何を見ているかを1目で分からせる）。
   * 表示の値だけ、升目の印と同じ系統の色にする（赤＝終わる側・青＝始まる側）。
   * ★ 色だけに頼らない。文字（「配信終了」「新着・配信予定」）が意味を持っている。
   * ★ 長い値（「新着・配信予定」）が狭い画面で2行にならないよう、はみ出しは省略記号にする。
   */
  .pick-value {
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pick-value[data-direction='leaving'] {
    color: var(--cal-leaving);
  }
  .pick-value[data-direction='arrivals'] {
    color: var(--cal-arrivals);
  }
  /* 右端の丸い矢印。**押すと開く**ことを示す。開いている間は上向きに返す */
  .pick-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--cal-on);
    transition: transform 0.15s ease;
  }
  .pick-arrow svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pick[open] .pick-arrow {
    transform: rotate(180deg);
  }

  /* 開いた枠。本文の上に**浮かせる**（通常フローに置くと升目が押し下げられる） */
  .panel {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    min-width: 100%;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
    z-index: 4;
  }
  .option {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  a.option:hover {
    background: var(--bg-subtle);
    color: var(--accent);
  }
  /* いま見ているもの。押せない。印を付けて「ここにいる」を示す */
  .option.is-current {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .option.is-current::before {
    content: '✓ ';
  }

  /*
   * 狭い画面では、開いた枠を**切り替えの行いっぱい**に広げる。
   * 右側の「表示」の真下に出すと、枠が画面の右端からはみ出す（Header.astro のメニューと同じ理由）。
   */
  @media (max-width: 30rem) {
    .pick {
      position: static;
    }
    .panel {
      left: 0;
      right: 0;
      min-width: 0;
    }
  }
</style>
