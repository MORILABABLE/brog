---
import { ADSENSE_CLIENT } from '../config'

interface Props {
  /** AdSense の広告ユニットID */
  slot?: string
}
const { slot } = Astro.props

/**
 * 広告枠（＝**広告ユニット**）。
 *
 * ★ PUBLIC_ADSENSE_CLIENT と `slot` の**両方**が要る。片方でも欠ければ何も描画しない。
 *   `slot` は広告ユニットIDで、**審査に通ってからでないと作れない。**
 *
 * ★ **審査に必要なコードはここではない。** それは全ページの <head> にある
 *   （layouts/BaseLayout.astro）。この2つは役割が違う。
 *     <head> のコード … サイトの認識と審査、自動広告。**全ページ必須**
 *     この枠         … 位置を指定して出す広告ユニット。**審査後に足す**
 *   以前はローダーの <script> をここでも読んでいたが、<head> に移したので消した。
 *   1ページに2回読み込むとコンソールに警告が出る。
 *
 * ★ いまの唯一の呼び出しは pages/posts/[...slug].astro で、**slot を渡していない。**
 *   審査に通ってユニットを作ったら、そこにIDを渡すこと。
 */
const enabled = Boolean(ADSENSE_CLIENT && slot)
---

{
  enabled && (
    <aside class="ad" aria-label="広告">
      <span class="label">広告</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      {/* ローダーは <head>（BaseLayout）が読む。ここでは枠を1つ登録するだけ。 */}
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({})
      </script>
    </aside>
  )
}

<style>
  .ad {
    margin: 2rem 0;
  }
  .label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
</style>
