---
import BaseLayout from '../layouts/BaseLayout.astro'
import AffiliateNotice from './AffiliateNotice.astro'
import AmazonCta from './AmazonCta.astro'
import CalendarFilter from './CalendarFilter.astro'
import CalendarPicker from './CalendarPicker.astro'
import DayPager from './DayPager.astro'
import EventCalendar from './EventCalendar.astro'
import PostCard from './PostCard.astro'
import PrimeCta from './PrimeCta.astro'
import WorkSearch from './WorkSearch.astro'
import WorkTable from './WorkTable.astro'
import { ATTRIBUTION, CATEGORIES, CATEGORY_HUBS, EVERGREEN_BADGE, SERVICE_HUBS, SITE } from '../config'
import { buildCalendar, type CalendarKind } from '../lib/calendar'
import {
  ARRIVALS_WINDOW_DAYS,
  calendarPastStart,
  groupByDate,
  upcomingSources,
  type WorkRow,
} from '../lib/events-data'
import {
  calendarContent,
  evergreenTitle,
  evergreenTitleBase,
  posterOf,
  type CalendarDirection,
} from '../lib/evergreen'
import { primeAd } from '../lib/prime-ad'
import { serviceSection, type PostEntry } from '../lib/service-pages'
import { formatDate, isoDate } from '../utils/date'

interface Props {
  direction: CalendarDirection
  /** サービスキー（`netflix` など） */
  service: string
  /** サービス表示名 */
  label: string
  /** 公開中の記事全部。このサービス×向きの記事だけをここで拾う */
  posts: PostEntry[]
}

const { direction, service, label, posts } = Astro.props

/**
 * 配信カレンダーのページ本体。**`/leaving/<サービス>` と `/arrivals/<サービス>` が共有する。**
 *
 * ■ 2026-09-17 に1つの部品にまとめた
 * それまでは pages/leaving/[service].astro と pages/arrivals/[service].astro が
 * ほぼ同じ250行をそれぞれ持ち、「同じ形にすること」と注意書きで縛っていた。
 *
 * ■ 1ページに並ぶもの
 *
 *   /leaving/<サービス>   これから＝終了予定（loadLeaving）   過去＝終了済み（loadEnded・前月から）
 *   /arrivals/<サービス>  これから＝配信開始予定（loadUpcoming） 過去＝新着（loadArrivals・直近60日）
 *
 * ■ 2026-09-19 に「日付めくり」へ作り直した（運用者の指定）
 * それまでは「見放題配信が終了する予定」「見放題配信が終了した作品」という**2つの節**に分かれ、
 * その中で日付ごとの表が上から全部並んでいた。いまは節をやめて、
 * **きょうを基準に1日ずつめくる**（components/DayPager.astro）。
 *
 *   ‹    9月19日（土）    ›
 *
 * ★ **過去と未来は1本のめくりに統合してある。** ‹ で終了済み、› で終了予定へ進む。
 *   「これからが先、過去が後」という並びは無くなり、**暦の順**だけが残った。
 * ★ **節の見出し（h2）も説明文も消した。** めくりの日付がこの日の見出しで、
 *   「近い順に並べています」のような並びの説明は、めくりになった時点で意味を失った。
 *   **書き戻さないこと。**
 * ★ **日付が出るのはめくりの1か所だけ**（2026-09-19・運用者の指定）。
 *   下の表の日付見出しは日付を伏せて「5本終了予定」だけになる（DayPager の `.is-paged`）。
 * ★ 記事の一覧は**表より後ろ**に移した（同じく運用者の指定）。
 *   升目と表のあいだにあると、日付から作品へ行く道の途中に記事が挟まる。
 *
 * ■ 検索から来るページでもある（ここを崩さないこと）
 * `/leaving/netflix` は「◯◯ netflix 配信終了」で表示を集めている（docs/FUNNEL.md 4-1）。
 * **表（作品名の並び）が検索に当たっている本文**なので、升目だけのページにしない。
 * ★ 日付めくりで隠れる日も **HTML には全部出ている**（隠すのはスクリプト。DayPager.astro）。
 *   ビルド時に「きょうの日だけ書き出す」ような直しを入れると、本文が消える。
 *
 * ■ 絶対に守ること
 * **「配信中」と書かない。** 新着は「始まった記録」、配信開始予定は「告知された予定」、
 * 終了済みは「終了を確認した記録」。どれも**いま観られるか**は言っていない（下の注記）。
 */

const content = calendarContent(direction, service)
const futureWorks: WorkRow[] = content.future?.works ?? []
const pastWorks: WorkRow[] = content.past.works
const since = calendarPastStart()
const isPrime = service === 'prime-video'

interface Section {
  kind: CalendarKind
  /** 升目の行き先の頭と、表の見出しの id の頭。**必ず同じ文字列**（EventCalendar の kinds） */
  prefix: string
  /**
   * 日付見出しの意味づけ（「12本終了予定」の「終了予定」）。
   *
   * ★ **4つとも別の言葉にすること**（2026-09-19）。節の見出しを外したので、
   *   同じ日に終了済みと終了予定が両方ある日は、**ここだけが2つの表を読み分ける手がかり**になる。
   *   以前は終了予定も終了済みも「終了」で、並べると見分けが付かない。
   * ★ 作品検索の候補に出る日付（WorkTable の `whenLabel`）もこの言葉を使う。
   */
  dateNoun: string
  works: WorkRow[]
}

/*
 * 節の定義。**文言はここに集める。** 2枚のページで言い回しがずれないように。
 */
const future: Section =
  direction === 'leaving'
    ? { kind: 'leaving', prefix: 'leaving-', dateNoun: '終了予定', works: futureWorks }
    : { kind: 'upcoming', prefix: 'upcoming-', dateNoun: '配信開始予定', works: futureWorks }

const past: Section =
  direction === 'leaving'
    ? { kind: 'ended', prefix: 'ended-', dateNoun: '終了', works: pastWorks }
    : { kind: 'arrivals', prefix: 'arrivals-', dateNoun: '追加', works: pastWorks }

/*
 * ★ **過去が先。** 1日の中に2種類ある日（きょう終了した作品と、きょう終了する予定の作品）で
 *   表を並べる順。暦と同じ向き（左から右へ時間が進む）にそろえてある
 *   （升目の印の並びと同じ規則。EventCalendar.astro の ORDER）。
 */
const sections = [past, future]

/*
 * 日付めくりに渡す1日ぶん。**2つの節を日付で合流させる。**
 * 同じ日に両方あれば、その日の中に表が2つ並ぶ（上の ORDER の順）。
 */
const dayMap = new Map<string, { date: Date; parts: { section: Section; works: WorkRow[] }[] }>()
for (const s of sections) {
  for (const g of groupByDate(s.works)) {
    const iso = isoDate(g.date)
    const hit = dayMap.get(iso) ?? { date: g.date, parts: [] }
    hit.parts.push({ section: s, works: g.works })
    dayMap.set(iso, hit)
  }
}
/** 暦の順（古い日が先）。**めくりの ‹ › はこの並びを前後にたどる。** */
const days = [...dayMap.entries()].sort(([a], [b]) => a.localeCompare(b))

/**
 * めくりの下に出す1行。**この社のデータに穴があるときだけ。**
 *
 * ★ 「近い順に並べています」のような**並びの説明は書かない**（2026-09-19 に削除）。
 *   めくりになった以上、並び順は読者の操作そのもので、説明する対象が無い。
 * ★ 「さかのぼれるのは◯月◯日までです」も**書かない**（2026-09-19・運用者の指定）。
 *   端まで行けば ‹ が押せなくなるので、日付を先に言う必要が無い。**書き戻さないこと。**
 * ★ 残してあるのは**社ごとのデータの穴**だけ。どちらも「押しても進まない」理由で、
 *   ページを見ただけでは分からない。
 */
const notes: string[] = []
if (direction === 'leaving' && isPrime) {
  notes.push('Prime Video は終了の約11日前にならないと終了予定が出ないため、先の日付ほど件数が少なくなります。')
}
/*
 * ★ Disney+ は配信データが終了予定を返さない（events-data.ts の LEAVING_SERVICES）。
 *   黙って未来の日付が空になると、**観測できていないだけ**のことが、無いことのように見える。
 */
if (direction === 'leaving' && content.future === null) {
  notes.push(
    `${label}の終了予定日は、当サイトが使っている配信データに含まれないため載せていません。このカレンダーに出るのは、終了を確認した作品だけです。`,
  )
}

/** その日に1本も無いときの文。**過去の日にも未来の日にも出る**ので、時制を持たせないこと。 */
const dayEmpty =
  direction === 'leaving'
    ? 'この日は、見放題配信の終了を取得できていません。'
    : 'この日は、見放題配信の開始を取得できていません。'

/** 1本も無いページ（めくる日が1日も無い）。**めくりごと出さずにこの文だけ出す。** */
const pageEmpty =
  direction === 'leaving'
    ? `現在、${label}で見放題配信の終了予定・終了済みとして取得できている作品はありません。` +
      (isPrime ? 'Prime Video は終了の約11日前にならないと終了予定が出ないため、時期によっては空になります。' : '')
    : `現在、${label}で見放題配信の開始予定・新着として取得できている作品はありません。翌月ぶんの告知は、例月の月末ごろに出ます。`

/*
 * 升目。**渡すのは表に出しているのと同じ配列**（lib/calendar.ts）。
 * 別の絞り込みを掛けると、点いているのに飛び先が無い日ができる。
 */
const calendar = buildCalendar(
  sections.map((s) => ({ kind: s.kind, works: s.works })),
  /*
   * 升目に敷く作品の絵（2026-09-17 追加・運用者の指定）。
   * **表の行に出しているサムネイルと同じもの**（components/WorkTable.astro の `primary`）。
   * 「日にちを押すと作品の一覧へ移動します」という案内文の代わりに、
   * 升目そのものに作品が見えていれば、押すと作品に行けることが伝わる。
   * ★ ジャンルの汎用画像は使わない（`isPosterThumb`）。同じ絵が升目に並ぶだけになる。
   */
  posterOf(service),
)
const hasRows = futureWorks.length + pastWorks.length > 0

/*
 * 作品検索の説明文。**升目の上と、升目が出ないときの単独置きで同じ文字列を使う。**
 * ★ 表は日付ごとに分かれているが、検索窓は**1つでページ全部に当たる**
 *   （WorkSearch は文書内の `[data-work-row]` を全部見る。**いま見せていない日の行も含めて**）。
 */
const SEARCH_LABEL = 'このカレンダーから作品を探す'
/*
 * 入力欄の中に出す短い文（2026-09-19）。**窓は 13rem しか無い**ので、上の説明文は入らない。
 * ★ 読み上げの名前は `SEARCH_LABEL` のまま（WorkSearch の `label` と `placeholder` の違い）。
 */
const SEARCH_PLACEHOLDER = '作品を探す'

/*
 * タイトルの末尾に基準日を出す（`Netflix 見放題・配信終了カレンダー【9月14日更新】`）。
 * **素のタイトルも組み立ても lib/evergreen.ts の1か所。ここで文字列を作らないこと。**
 */
const title = evergreenTitle(evergreenTitleBase(direction, service, label), content.dataAsOf)

const nearest = futureWorks[0]
const description =
  direction === 'leaving'
    ? content.future === null
      ? `${label}で${formatDate(since)}以降に見放題配信が終了した作品${pastWorks.length}本を、日付ごとに確認できます。`
      : futureWorks.length > 0
        ? `${label}で見放題配信が終了する予定の作品${futureWorks.length}本（最も近い終了日は${formatDate(nearest!.at)}）と、${formatDate(since)}以降に終了した作品${pastWorks.length}本を、日付ごとに確認できます。`
        : `${label}で見放題配信が終了する予定の作品と、${formatDate(since)}以降に終了した作品${pastWorks.length}本を、日付ごとに確認できます。現在、終了予定として取得できている作品はありません。`
    : futureWorks.length > 0
      ? `${label}で見放題配信が始まる予定の作品${futureWorks.length}本と、直近${ARRIVALS_WINDOW_DAYS}日間に見放題になった作品${pastWorks.length}本を、日付ごとに確認できます。`
      : `${label}で直近${ARRIVALS_WINDOW_DAYS}日間に見放題になった作品${pastWorks.length}本を、日付ごとに確認できます。`

/*
 * このサービス×向きの記事（2026-09-17 追加）。
 *
 * ★ ヘッダーのメニューの行き先だった `/category/<ハブ>/<サービス>` を、このページへ転送した。
 *   あのページが持っていた**記事の一覧をここで引き継ぐ**（転送した先で記事が見つからない、を作らない）。
 *   ハブの中身（終了＝配信終了予定と終了済み／新着）は config.ts の CATEGORY_HUBS が決める。
 */
const hub = CATEGORY_HUBS.find((h) => h.slug === direction)!
const serviceHub = SERVICE_HUBS.find((s) => s.slug === service)
const allArticles = serviceHub ? serviceSection(posts, serviceHub, hub.includes).posts : []
/*
 * ★ **新しい5本まで。** 升目と表のあいだに置くので、全部並べると表が遠くなる
 *   （実測: Prime Video の新着側で14本）。残りは「すべて見る」から
 *   サービス別まとめ（/service/<サービス>・カテゴリ問わず全部の記事）へ送る。
 */
const ARTICLES_SHOWN = 5
const articles = allArticles.slice(0, ARTICLES_SHOWN)

/*
 * 本文のCTA。**Prime Video の面だけ行き先が変わる**（判断と文言は lib/prime-ad.ts の1か所）。
 *
 * ★ **「これから」（終了予定）が1本も無い終了側では出さない。** 終わった作品しか並ばない面で
 *   会員を勧めると、prime-ad.ts の「出してよい面」の線を越える。
 * ★ 新着側は、新着が1本も無く配信予定だけのときは出さない（文言が「始まった作品」を前提にする）。
 */
const primeProps =
  direction === 'leaving'
    ? futureWorks.length > 0
      ? { service, category: 'leaving' as const, alsoEnded: pastWorks.length > 0 }
      : null
    : pastWorks.length > 0
      ? { service, category: 'arrivals' as const, alsoUpcoming: futureWorks.length > 0 }
      : null
const primeSlot = primeProps ? primeAd(primeProps) : null

/* 配信開始予定の出典（告知のページ）。**取り込んだ告知があるときだけ並べる** */
const announcementSources = direction === 'arrivals' && futureWorks.length > 0 ? upcomingSources(service) : []
---

<BaseLayout title={title} description={description}>
  <nav class="breadcrumb" aria-label="パンくず">
    <a href="/">ホーム</a> ›
    <a href={`/category/${hub.slug}`}>{hub.label}</a>
  </nav>

  {/*
    ★ 見出しの直上に置いていたサービス画像（LeadImage）は**外してある**（2026-09-07）。
      汎用の絵（再生記号）で、本命のカレンダーと表を画面の外へ押し下げていた。
      カードのサムネイル（Thumb.astro）としては残してある。
  */}
  <h1>{title}</h1>

  {/*
    ★ 記事ページ（pages/posts/[...slug].astro）の `.meta` と同じ位置・同じ形。
      **違いはバッジだけ**にしてある。記事は「公開 ◯月◯日」が並び、ここは「随時更新」が並ぶ。
    ★ 終了側は、終了予定と終了済みの**両方があるときはバッジも2つ**。
      片方だけ出すと、出さなかったほうの作品が載っていることが伝わらない。
  */}
  <div class="meta">
    {
      direction === 'leaving' ? (
        <>
          {futureWorks.length > 0 && (
            <span class="badge" data-category={CATEGORIES.leaving.slug}>
              {CATEGORIES.leaving.label}
            </span>
          )}
          {pastWorks.length > 0 && (
            <span class="badge" data-category={CATEGORIES.ended.slug}>
              {CATEGORIES.ended.label}
            </span>
          )}
        </>
      ) : (
        <span class="badge" data-category={CATEGORIES.arrivals.slug}>
          {CATEGORIES.arrivals.label}
        </span>
      )
    }
    <span class="badge evergreen">{EVERGREEN_BADGE.label}</span>
  </div>

  <AffiliateNotice />

  {/* 配信状況は変わる。いつ時点のデータかを必ず出す。 */}
  <p class="notice">
    {
      content.dataAsOf ? (
        <>
          配信情報は <strong>{formatDate(content.dataAsOf)}時点</strong>のものです。
        </>
      ) : (
        <>配信情報の取得時刻が不明です。</>
      )
    }
    {label}の都合により変更される場合があります。ご視聴前に公式サイトでご確認ください。
  </p>

  {/*
    操作の2段（2026-09-19 にこの形にした）。**升目が出る時期も出ない時期も同じ並び。**

      1段目  ［Netflix ▾］［配信終了 ▾］          （右端に）作品を探す窓
      2段目  すべて 映画 TVシリーズ ／ すべて アニメ 洋画 邦画

    ★ **切り替えと検索窓は同じ行。** h2「配信カレンダー」を外したとき、検索窓だけが
      1つの行に取り残されて切り替えと2段になっていた（2026-09-19・運用者の指摘）。
    ★ 切り替えは**必ず出す**（ほかのサービス・表示へ移る道がここにしか無い）。
      検索窓と絞り込みは、行が1本も無いページでは出さない。
    ★ 検索窓は**ページに1つだけ**（WorkSearch のスクリプトは `[data-work-search]` を1つしか見ない）。
      だから下の2つの分岐で**同じ中身を2回描かない**こと。
  */}
  {
    calendar.hasEvents ? (
      <EventCalendar
        months={calendar.months}
        buildMonth={calendar.buildMonth}
        kinds={sections.map((s) => ({ kind: s.kind, prefix: `#${s.prefix}` }))}
      >
        <Fragment slot="controls">
          <div class="controls">
            <CalendarPicker service={service} direction={direction} />
            {hasRows && <WorkSearch label={SEARCH_LABEL} placeholder={SEARCH_PLACEHOLDER} />}
          </div>
          {hasRows && <CalendarFilter />}
        </Fragment>
      </EventCalendar>
    ) : (
      <>
        <div class="controls">
          <CalendarPicker service={service} direction={direction} />
          {hasRows && <WorkSearch label={SEARCH_LABEL} placeholder={SEARCH_PLACEHOLDER} />}
        </div>
        {hasRows && <CalendarFilter />}
      </>
    )
  }

  {/*
    日付めくり（2026-09-19・運用者の指定）。**このページの本体。**

    ★ 1日ぶんを `[data-day]` で包む。**この入れ物を出し入れするのは DayPager だけ。**
      中の `section.day` を出し入れするのは絞り込み（CalendarFilter）で、役割が分かれている。
    ★ 日付見出しは h2（ページの h1 の直下）。節の見出しを外したのでここが2階層目になった。
    ★ 表の `idPrefix` は**升目のリンク先**（EventCalendar の `kinds`）と必ず同じ文字列。
      片方だけ変えると升目を押しても何も起きない。
  */}
  {
    days.length === 0 ? (
      <p class="empty">{pageEmpty}</p>
    ) : (
      <>
        <DayPager buildToday={isoDate(new Date())} emptyLabel={dayEmpty}>
          {days.map(([iso, day]) => (
            <div class="day-page" data-day={iso}>
              {day.parts.map((p) => (
                <WorkTable
                  groups={[{ date: day.date, works: p.works }]}
                  dateNoun={p.section.dateNoun}
                  service={service}
                  idPrefix={p.section.prefix}
                />
              ))}
            </div>
          ))}
        </DayPager>
        {/* ★ 注記が無い社では**1バイトも出さない**（空の <p> が表と記事のあいだに残らないように） */}
        {notes.length > 0 && <p class="day-note">{notes.join(' ')}</p>}
      </>
    )
  }

  {/*
    ★ 記事の一覧は**表より後ろ**（2026-09-19・運用者の指定。それまでは升目と表のあいだ）。
      日付から作品へ行く道の途中に記事が挟まると、このページの用（いつ何が消えるか）が遠くなる。
  */}
  {
    articles.length > 0 && (
      <section class="articles" aria-labelledby="articles-title">
        <h2 id="articles-title">
          {label}の{hub.label}の記事
        </h2>
        {/*
          ★ **記事カード（PostCard）で出す**（2026-09-17・運用者の指定）。
            最初は題名と日付の行だけにしていたが、トップや記事一覧と同じ見出し画像つきのカードでないと、
            ほかの一覧と同じ記事だと分かりにくい。節の見出しが h2 なので、カードの題名は h3 に下げる。
        */}
        {articles.map((p) => (
          <PostCard post={p} headingLevel={3} />
        ))}
        {allArticles.length > ARTICLES_SHOWN && (
          <p class="more">
            <a href={`/service/${service}`}>{label}の記事をすべて見る</a>
          </p>
        )}
      </section>
    )
  }

  {
    primeSlot && primeProps ? (
      <PrimeCta {...primeProps} />
    ) : (
      <AmazonCta category={direction} />
    )
  }

  <section class="sources">
    <h2>出典</h2>
    <ul>
      <li>
        <a href={ATTRIBUTION.url} rel="noopener noreferrer" target="_blank">
          {ATTRIBUTION.text}
