---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import type { ImageMetadata } from 'astro'
import { AFFILIATE, CATEGORIES } from '../config'
import { withAmazonTag } from '../lib/affiliate'
import { EVERGREEN_PAGES } from '../lib/evergreen'

/**
 * 本文の右の余白に置く追従枠。上から3ブロック。
 *
 *   1. 最新の配信終了・配信開始一覧 … 常設ページのカード。広告ではない
 *   2. 新着記事                     … カテゴリ横断の最新記事
 *   3. PR                          … 広告カード。**ここだけ追従する**
 *
 * ■ 追従するのは 3 だけ
 * 枠全体を追従させると、画面に収まらないときPR枠に手が届かなくなる。
 * 枠内スクロールで解決すると読者がスクロールを2回することになる。
 * 上2ブロックは流し、PR枠だけを sticky にするのが両立する唯一の形。
 *
 * ■ 広告とそれ以外を混ぜない
 * まとめて `aria-label="広告"` にすると 1・2 まで広告と称することになり、
 * 逆に 3 のPR表記を外すと景品表示法（ステマ規制）に触れる。**必ず分ける。**
 *
 * ■ 並びは全ページで固定（重要）
 * 以前は「いま見ているページのカードを消す」実装にしていたが、
 * **ページを移動するたびに一覧の中身と順番が変わり、読者が混乱する**
 * （2026-08-23 に修正）。いまは常に同じ順で全件出し、
 * 現在地のカードだけリンクを外して `aria-current="page"` を付けている。
 * **項目を出し分ける実装に戻さないこと。**
 *
 * ■ なぜ「余白」なのか
 * 本文は `--max-width: 46rem`（736px）中央寄せで、ワイド画面では左右が余っている。
 * そこに置けば**本文カラムを1mmも削らずに**面を作れる。
 *
 * ■ position: sticky を使う理由（fixed ではなく）
 * fixed だと本文が終わってもレールが残りフッターに重なる。
 * sticky なら親グリッド行の高さが自然な上限になるので、JSなしで同じ挙動になる。
 *
 * ■ 出す条件
 * 画面幅 75rem(1200px) 以上（styles/global.css の `.layout`）。
 * **狭い画面では枠ごと消える**ので、常設ページへの導線は
 * カテゴリページ側にも置いてある（そちらが狭い画面での入口）。
 */

/**
 * 新着記事に出す本数。
 * ★ 増やすと枠が縦に伸び、追従する画面高さの下限（下の @media）も上げる必要が出る。
 */
const RECENT_POSTS = 3

/**
 * サムネイル。`src/assets/services/<キー>.{png,jpg,jpeg,webp}` を置くと拾う。
 * ★ 画像が無くても壊れない。サービス名の頭文字が入る。
 *   推奨サイズと注意は src/assets/services/README.md。
 */
const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/services/*.{png,jpg,jpeg,webp}',
  { eager: true },
)

function thumbFor(key: string): ImageMetadata | undefined {
  const hit = Object.entries(thumbs).find(([path]) =>
    path.match(new RegExp(`/${key}\\.(png|jpg|jpeg|webp)$`)),
  )
  return hit?.[1].default
}

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, RECENT_POSTS)

/** 現在地の判定にだけ使う。**項目の出し分けには使わない。** */
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '')

const tag = AFFILIATE.amazonTag
const adHref = withAmazonTag('https://www.amazon.co.jp/gp/video/storefront', tag)
---

<aside class="follow-rail">
  <nav class="block" aria-label="最新の配信終了・配信開始一覧">
    <p class="block-title">最新の配信終了・配信開始一覧</p>
    <ul class="cards">
      {
        EVERGREEN_PAGES.map((p) => {
          const isCurrent = p.href === current
          const Inner = (
            <>
              <span class="thumb-slot">
                {thumbFor(p.thumbKey) ? (
                  <Image class="thumb" src={thumbFor(p.thumbKey)!} alt="" width={48} height={48} />
                ) : (
                  <span class="thumb thumb-fallback" aria-hidden="true">
                    {p.label.charAt(0)}
                  </span>
                )}
              </span>
              <span class="body">
                <span class="badge" data-category={p.category}>
                  {CATEGORIES[p.category].label}
                </span>
                <span class="name">{p.shortLabel}</span>
              </span>
            </>
          )
          return (
            <li>
              {/* 現在地は消さずに、リンクだけ外す。並びを崩さないため */}
              {isCurrent ? (
                <span class="rail-card is-current" aria-current="page">
                  {Inner}
                </span>
              ) : (
                <a class="rail-card" href={p.href}>
                  {Inner}
                </a>
              )}
            </li>
          )
        })
      }
    </ul>
  </nav>

  {
    posts.length > 0 && (
      <nav class="block" aria-label="新着記事">
        <p class="block-title">新着記事</p>
        <ul class="posts">
          {posts.map((post) => {
            const href = `/posts/${post.id}`
            const isCurrent = href === current
            return (
              <li>
                <span class="badge" data-category={post.data.category}>
                  {CATEGORIES[post.data.category].label}
                </span>
                {isCurrent ? (
                  <span class="post-title is-current" aria-current="page">
                    {post.data.title}
                  </span>
                ) : (
                  <a class="post-title" href={href}>
                    {post.data.title}
                  </a>
                )}
              </li>
            )
          })}
        </ul>
      </nav>
    )
  }

  {
    tag && (
      <div class="rail-ad" aria-label="広告">
        <p class="pr">PR</p>
        <p class="ad-label">Amazon Prime Video</p>
        <p class="ad-heading">観たかった作品、まだ間に合うかも</p>
        <p class="ad-body">
          見放題が終わった作品も、レンタル・購入なら観られることがあります。
        </p>
        <a
          class="ad-action"
          href={adHref}
          rel="sponsored noopener"
          target="_blank"
          data-affiliate="true"
        >
          Prime Videoで探す
        </a>
      </div>
    )
  }
</aside>

<style>
  /* 表示・非表示と配置は styles/global.css の .layout 側。ここは中身の見た目だけ。 */
  /*
   * ★ 追従するのは PR枠だけ（2026-08-23 に変更）。
   *
   * 枠全体を sticky にすると、枠が画面より高いときに上端で貼り付き、
   * 下端のPR枠に永久に手が届かなくなる。かといって枠の中をスクロールさせると
   * 読者がスクロールを2回することになる。
   * そこで**上2ブロックはページと一緒に流し、PR枠だけを追従**させている。
   * PR枠は約230pxしかないので、どんな画面高さでも必ず収まる。
   *
   * sticky の効く範囲は「直近のブロックコンテナ」＝ .follow-rail（グリッドの列）。
   * **ラッパーで囲むとその高さまでしか追従しなくなる**ので、
   * .follow-rail の直下に置いている。div でくくらないこと。
   */
  .block,
  .rail-ad {
    max-width: 17rem;
  }
  .rail-ad {
    position: sticky;
    top: 1rem;
  }

  .block {
    margin-bottom: 0.8rem;
  }
  /*
   * ★ この見出しはカードの外＝**背景の紺の上に直接載る**。
   *   --text-muted（本文用の暗いグレー）だと紺に沈んで読めない。
   *   地の上に置く文字用の明るい色を使う（フッターと同じ考え方）。
   *   docs/APPEARANCE.md「文字は白いカードの中にしか置かないこと」の例外なので、
   *   色を変えるときはコントラストを必ず確認する。
   */
  .block-title {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--footer-text);
  }

  /* --- 1. 常設ページのカード --- */
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rail-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    /*
     * サムネイル 48px ＋ 上下padding で 64px。
     * 文字が2行になってもこの高さを下回らせないことで、
     * カードの高さが揃い、縦の並びが乱れない。
     */
    min-height: 64px;
    padding: 0.45rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
  }
  a.rail-card:hover {
    border-color: var(--accent);
  }
  /* 現在地。押せないことが分かる見た目にする（項目自体は消さない） */
  .rail-card.is-current {
    background: var(--bg-subtle);
    border-color: var(--accent);
  }
  .thumb-slot {
    flex: none;
    width: 48px;
    height: 48px;
  }
  .thumb {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
  }
  .thumb-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
  }
  .badge {
    font-size: 0.68rem;
    padding: 0.05rem 0.45rem;
  }
  .name {
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
  }
  a.rail-card:hover .name {
    color: var(--accent);
  }

  /* --- 2. 新着記事 --- */
  .posts {
    margin: 0;
    padding: 0.85rem 0.9rem;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .posts li + li {
    margin-top: 0.55rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--border);
  }
  .post-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    /* 記事タイトルは長い。2行で切らないと枠が縦に伸びすぎる */
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    text-decoration: none;
  }
  a.post-title:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .post-title.is-current {
    color: var(--text-muted);
  }

  /* --- 3. 広告 --- */
  .rail-ad {
    padding: 0.85rem 0.9rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  /* 景品表示法（ステマ規制）上、広告面には表記が要る */
  .pr {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--text-muted);
    border-radius: 3px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .ad-label {
    margin: 0 0 0.3rem;
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .ad-heading {
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .ad-body {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .ad-action {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 0.84rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .ad-action:hover {
    opacity: 0.9;
  }
</style>
