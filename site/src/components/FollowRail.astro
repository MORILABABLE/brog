---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { AFFILIATE, CATEGORIES } from '../config'
import { withAmazonTag } from '../lib/affiliate'
import { EVERGREEN_PAGES } from '../lib/evergreen'

/**
 * 本文の右の余白に置く追従枠。
 *
 * ■ 中身は2種類。**性質が違うので必ず分けて扱う。**
 *   1. 常設ページのカード … 広告ではない。常に出す
 *   2. 広告カード         … アフィリエイト有効時のみ。PR表記が要る
 *   まとめて `aria-label="広告"` にすると、ナビまで広告と称することになる。
 *   逆にPR表記を外すと景品表示法（ステマ規制）に触れる。**混ぜない。**
 *
 * ■ 1枚ずつ独立したカードにしている
 * 当初は「いつでも最新」という見出しの下にリンクを箇条書きしていたが、
 * **サービスごとの見分けがつかず、サイト内の他のカードから浮いていた**
 * （2026-08-23 に作り直し）。いまはサムネイル＋カテゴリバッジを持つ
 * 独立したカードを縦に並べ、記事カード（PostCard）と同じ語彙で見せている。
 *
 * ■ なぜ「余白」なのか
 * 本文は `--max-width: 46rem`（736px）中央寄せで、ワイド画面では左右が余っている。
 * そこに置けば**本文カラムを1mmも削らずに**面を作れる。
 *
 * ■ position: sticky を使う理由（fixed ではなく）
 * fixed だと本文が終わってもレールが残りフッターに重なる。
 * sticky なら親グリッド行の高さが自然な上限になるので、JSなしで同じ挙動になる。
 *
 * ■ 出す条件
 * 画面幅 75rem(1200px) 以上（styles/global.css の `.layout`）。
 * **狭い画面では枠ごと消える**ので、常設ページへの導線は
 * カテゴリページ側にも置いてある（そちらが狭い画面での入口）。
 */

/**
 * サムネイル。`src/assets/services/<キー>.{png,jpg,jpeg,webp}` を置くと拾う。
 * ★ 画像が無くても壊れない。絵の場所が空くだけ。
 *   推奨サイズと注意は src/assets/services/README.md。
 */
const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/services/*.{png,jpg,jpeg,webp}',
  { eager: true },
)

function thumbFor(key: string): ImageMetadata | undefined {
  const hit = Object.entries(thumbs).find(([path]) =>
    path.match(new RegExp(`/${key}\\.(png|jpg|jpeg|webp)$`)),
  )
  return hit?.[1].default
}

// いま見ているページ自身へのカードは出さない
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '')
const pages = EVERGREEN_PAGES.filter((p) => p.href !== current)

const tag = AFFILIATE.amazonTag
const adHref = withAmazonTag('https://www.amazon.co.jp/gp/video/storefront', tag)
---

<aside class="follow-rail">
  <div class="inner">
    <ul class="rail-list">
      {
        pages.map((p) => (
          <li>
            <a class="rail-card" href={p.href}>
              <span class="thumb-slot">
                {thumbFor(p.thumbKey) ? (
                  <Image
                    class="thumb"
                    src={thumbFor(p.thumbKey)!}
                    alt=""
                    width={56}
                    height={56}
                  />
                ) : (
                  /* 画像が無いときは頭文字だけ置く。枠の高さが揃うので並びが崩れない */
                  <span class="thumb thumb-fallback" aria-hidden="true">
                    {p.label.charAt(0)}
                  </span>
                )}
              </span>
              <span class="body">
                {/* 記事カードと同じバッジ。色は styles/global.css の :root */}
                <span class="badge" data-category={p.category}>
                  {CATEGORIES[p.category].label}
                </span>
                <span class="name">{p.shortLabel}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      tag && (
        <div class="rail-ad" aria-label="広告">
          <p class="pr">PR</p>
          <p class="ad-label">Amazon Prime Video</p>
          <p class="ad-heading">観たかった作品、まだ間に合うかも</p>
          <p class="ad-body">
            見放題が終わった作品も、レンタル・購入なら観られることがあります。
          </p>
          <a
            class="ad-action"
            href={adHref}
            rel="sponsored noopener"
            target="_blank"
            data-affiliate="true"
          >
            Prime Videoで探す
          </a>
        </div>
      )
    }
  </div>
</aside>

<style>
  /* 表示・非表示と配置は styles/global.css の .layout 側。ここは中身の見た目だけ。 */
  .inner {
    position: sticky;
    top: 1rem;
    max-width: 17rem;
  }

  /* --- 常設ページのカード --- */
  .rail-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rail-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    /*
     * サムネイル 56px ＋ 上下padding で 72px。
     * 文字が2行になってもこの高さを下回らせないことで、
     * カードの高さが揃い、縦の並びが乱れない。
     */
    min-height: 72px;
    padding: 0.5rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
  }
  .rail-card:hover {
    border-color: var(--accent);
  }
  .thumb-slot {
    flex: none;
    width: 56px;
    height: 56px;
  }
  .thumb {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    object-fit: cover;
  }
  /* 画像未配置のとき。頭文字を淡く置くだけの控えめな見た目にする */
  .thumb-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
  }
  .body .badge {
    font-size: 0.68rem;
    padding: 0.05rem 0.45rem;
  }
  .name {
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
  }
  .rail-card:hover .name {
    color: var(--accent);
  }

  /* --- 広告 --- */
  .rail-ad {
    margin-top: 0.9rem;
    padding: 1rem 1rem 1.15rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  /* 景品表示法（ステマ規制）上、広告面には表記が要る */
  .pr {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--text-muted);
    border-radius: 3px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .ad-label {
    margin: 0 0 0.3rem;
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .ad-heading {
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .ad-body {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .ad-action {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 0.84rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .ad-action:hover {
    opacity: 0.9;
  }
</style>
