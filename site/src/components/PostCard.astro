---
import Thumb from './Thumb.astro'
import { CATEGORIES } from '../config'
import { genreBadges } from '../lib/genres'
import { firstPublished, formatDate, isNew, isoDate } from '../utils/date'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
  /**
   * 題名の見出しレベル。既定は `h2`。
   *
   * ★ 上に節の見出し（h2）を置くページでは `3` を渡す（2026-09-17 追加）。
   *   配信カレンダーの「◯◯の配信終了済み・予定の記事」（components/ServiceCalendarPage.astro）がそれ。
   *   h2 の節の中に h2 のカードが並ぶと、読み上げの見出しの木が崩れる。
   */
  headingLevel?: 2 | 3
  /**
   * 日付に**初回公開日**を出す（2026-09-25 追加）。既定は `pubDate`（最後に書き出した日）。
   *
   * ★ 並びと日付を揃えるためのもの。**初回公開日で並べる一覧（トップ）だけが渡す。**
   *   `pubDate` で並べる一覧（カテゴリ・月別まとめなど）で渡すと、日付が前後して見える。
   *   書き直した日は題名の【◯月◯日更新】が持っているので、ここに2つ並べない。
   */
  firstDate?: boolean
}
const { post, headingLevel = 2, firstDate = false } = Astro.props
/* 動的なタグ名は**大文字で始まる変数**にしないと Astro が要素として書き出さない（WorkTable.astro と同じ） */
const Heading = headingLevel === 3 ? 'h3' : 'h2'
const cat = CATEGORIES[post.data.category]
/*
 * ジャンルは**全記事が名乗る**（2026-09-15）。入っているものを全部出すので
 * 最大3枚（アニメ／洋画／邦画）並ぶ。文言の組み立ては lib/genres.ts。
 * 収集データと突き合わなかった記事では空になり、バッジごと出ない。
 */
const genres = genreBadges(post.data)
const published = firstPublished(post.data)
const shownDate = firstDate ? published : post.data.pubDate

/**
 * 記事カード。
 *
 * ★ 常設ページのカード（EvergreenCard.astro）と**体裁を揃えること**。
 *   一覧では両者が並ぶので、片方だけ形が違うと浮く。
 *   左サムネイル・バッジ・日付・見出し・説明という並びは共通。
 *
 * サムネイルは frontmatter の `heroImage`。いまは未設定なので
 * カテゴリ色のタイルが出る（Thumb.astro）。
 * ポスター再ホストの可否が確定したら、パイプラインがここに絵を入れる。
 */
---

<article class="card">
  {/*
    ★ 初回公開から3日以内は、絵の角に「NEW」の帯を出す（2026-09-24）。
      判定は utils/date.ts の isNew。**書き直しただけの記事には出さない**（2026-09-25・運用者の指定）。
      見ているのは初回公開日（`firstPublished`）で、`pubDate` ではない。
  */}
  <Thumb
    src={post.data.heroImage}
    category={post.data.category}
    size={72}
    ribbon={isNew(published) ? 'NEW' : undefined}
  />

  <div class="main">
    <div class="meta">
      {/* data-category で色が変わる。配色は styles/global.css の :root。 */}
      <span class="badge" data-category={cat.slug}>{cat.label}</span>
      {genres.map((label) => <span class="badge genre">{label}</span>)}
      <time datetime={isoDate(shownDate)}>{formatDate(shownDate)}</time>
    </div>
    <Heading class="title"><a href={`/posts/${post.id}`}>{post.data.title}</a></Heading>
    <p class="desc">{post.data.description}</p>
  </div>
</article>

<style>
  /* --- EvergreenCard.astro と同じ値。ずらさないこと。 --- */
  .card {
    display: flex;
    gap: 0.9rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--border);
  }
  .main {
    min-width: 0;
  }
  .meta {
    display: flex;
    /* バッジが最大4つ並ぶので、狭い画面では日付が下に落ちてよい */
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  /* 見出しレベルが変わっても見た目は同じ（`headingLevel`）。タグではなくクラスで当てる */
  .title {
    margin: 0.5rem 0 0.4rem;
    padding: 0;
    border: none;
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
