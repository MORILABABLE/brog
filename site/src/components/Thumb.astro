---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { CategorySlug } from '../config'

interface Props {
  /** src/assets 由来の画像（最適化される） */
  image?: ImageMetadata
  /** public/ 由来の画像パス（最適化されない）。frontmatter の heroImage 用 */
  src?: string
  /** 画像が無いときのタイルの色分けに使う */
  category?: CategorySlug
  /** 一辺の px。正方形で切り抜く */
  size?: number
  /**
   * 角丸の px。既定 10。
   * 左の枠だけ 8 にしてある（カード側の角丸 10px との入れ子で決めた値）。
   */
  radius?: number
  /** 画像が無いときにタイルへ置く1文字。省略可 */
  initial?: string
  /**
   * 左上の角に斜めにかける帯の文字（例: `NEW`）。省略すれば帯は出ない。
   *
   * ★ **短い語だけ。** 45度に傾けた帯の幅はタイルの対角線までしか無く、
   *   4文字を超えると 60px のタイルで潰れる（`--thumb-size` から字送りを決めている）。
   */
  ribbon?: string
}

const { image, src, category, size = 72, radius = 10, initial, ribbon } = Astro.props

/**
 * カードの左に置く正方形サムネイル。
 *
 * ★ 画像が無くても**必ず同じ大きさの枠を出す**。
 *   ここで何も描かないと、画像のあるカードと無いカードで高さが揃わず、
 *   一覧の並びが乱れる（追従枠で一度踏んだ）。
 */
---

<span
  class="thumb"
  style={`--thumb-size:${size}px;--thumb-radius:${radius}px`}
  data-category={category}
>
  {
    image ? (
      <Image class="img" src={image} alt="" width={size * 2} height={size * 2} />
    ) : src ? (
      /* public/ 配下は astro:assets を通せないので素の img。寸法は必ず指定する */
      <img class="img" src={src} alt="" width={size} height={size} loading="lazy" decoding="async" />
    ) : (
      <span class="fallback" aria-hidden="true">
        {initial}
      </span>
    )
  }
  {ribbon && <span class="ribbon">{ribbon}</span>}
</span>

<style>
  .thumb {
    flex: none;
    /* 帯を角に重ねるための基準。overflow:hidden が角丸の外へはみ出した分を切る */
    position: relative;
    display: block;
    width: var(--thumb-size);
    height: var(--thumb-size);
    border-radius: var(--thumb-radius);
    overflow: hidden;
  }
  /*
   * 左上の角を斜めに切る帯（2026-09-24 追加）。
   *
   * ★ **寸法は全部 `--thumb-size` から出す。** このタイルは 60 / 72 / 132px の
   *   3通りで使われていて、px で書くと小さい枠だけ文字が潰れる。
   * ★ **角だけを覆う。** 画像の中心（人物の顔・題字）に帯をかけない
   *   （運用者の指定・2026-09-24）。`work-cover-design` と同じ理由で、
   *   48×72 のような小さい絵ほど中心を隠すと何の作品か分からなくなる。
   * ★ 帯は `.thumb` の overflow で切られるので、左右に余分に伸ばして角から角へ通す。
   */
  /*
   * ★ **この4つの値は連動している。1つだけ動かさないこと**（2026-09-24 に3回調整）。
   *
   *     帯の中心X = left + width/2      帯の中心Y = top + (font-size × line-height)/2
   *
   *   中心を角（0,0）へ寄せるほど三角形らしくなるが、**帯の上に載る文字の幅も
   *   同じだけ狭くなる**。寄せるなら font-size も一緒に下げる。
   *
   *   実際に踏んだ順: top:13%/left:-32%/0.16em → 頭の N が角丸に食われた
   *                 → 内側へ逃がしたら帯が大きすぎた
   *                 → 角へ寄せ直し、font-size を 0.16 → 0.105 に下げていまの値
   *
   * ★ width が 100% を超えているのは、**帯の両端を必ずタイルの外へ出す**ため。
   *   足りないと角を切り終わる前に帯が途切れ、切り口が見える。
   * ★ 変えたら 72px（記事カード）で必ず目で見ること。数値だけでは文字の切れが分からない。
   */
  .ribbon {
    position: absolute;
    top: 5.4%;
    left: -44.5%;
    width: 115%;
    transform: rotate(-45deg);
    text-align: center;
    background: var(--ribbon-new-bg);
    color: var(--ribbon-new-fg);
    font-size: calc(var(--thumb-size) * 0.105);
    font-weight: 800;
    line-height: 1.45;
    letter-spacing: 0.05em;
    /* テープらしく見せる薄い影。帯の下辺にだけ出る */
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /*
   * 画像が無いときのタイル。カテゴリバッジと同じ色を使うので、
   * 画像が揃うまでの間も一覧の色分けとして機能する。
   * 配色は styles/global.css の :root（--cat-*）。
   */
  .fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: calc(var(--thumb-size) / 3);
    font-weight: 700;
  }
  .thumb[data-category='leaving'] .fallback {
    background: var(--cat-leaving-bg);
    color: var(--cat-leaving-fg);
  }
  .thumb[data-category='ended'] .fallback {
    background: var(--cat-ended-bg);
    color: var(--cat-ended-fg);
  }
  .thumb[data-category='arrivals'] .fallback {
    background: var(--cat-arrivals-bg);
    color: var(--cat-arrivals-fg);
  }
  .thumb[data-category='ranking'] .fallback {
    background: var(--cat-ranking-bg);
    color: var(--cat-ranking-fg);
  }
</style>
