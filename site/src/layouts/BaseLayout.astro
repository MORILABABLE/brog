---
import { SITE, OG_IMAGE } from '../config'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** 記事ページなら published 日時（JSON-LD 用） */
  publishedAt?: Date
  updatedAt?: Date
  /** 検索結果に出したくないページ（お問い合わせ等）は true */
  noindex?: boolean
}

const { title, description, publishedAt, updatedAt, noindex = false } = Astro.props

/**
 * 公開URLの形にパスを正規化する。
 *
 * astro.config の build.format: 'file' により、ビルド中の pathname には
 * `.html` が付く（トップは `/index.html`）。Cloudflare Pages は拡張子なしで
 * 配信するため、canonical をそのまま出すと実在しないURLを正規URLとして
 * 宣言してしまい、重複コンテンツ扱いになる。
 */
function toPublicPath(pathname: string): string {
  if (pathname === '/index.html') return '/'
  return pathname.replace(/index\.html$/, '').replace(/\.html$/, '')
}

const publicPath = toPublicPath(Astro.url.pathname)
const canonical = new URL(publicPath, Astro.site ?? SITE.url).href

// OGP画像は絶対URLでないと各SNSが解決できない
const ogImage = new URL(OG_IMAGE.path, Astro.site ?? SITE.url).href

// トップだけはタグラインを併記し、下層ページはサイト名を後置する
const isHome = publicPath === '/'
const fullTitle = isHome ? `${SITE.name}｜${SITE.tagline}` : `${title}｜${SITE.name}`

// 記事なら Article、それ以外は WebSite として構造化データを出す
const jsonLd = publishedAt
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: publishedAt.toISOString(),
      dateModified: (updatedAt ?? publishedAt).toISOString(),
      author: { '@type': 'Organization', name: SITE.author },
      publisher: { '@type': 'Organization', name: SITE.name },
      mainEntityOfPage: canonical,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
    }
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    {/* ファビコン。SVG非対応の古いブラウザ向けに PNG も併記する。 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={publishedAt ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* 構造化データはビルド時に加工されず、そのまま出力される必要がある */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    {/* 背景グラフィックから浮かせる本文カード。styles/global.css の .content-card。 */}
    <main id="main" class="content-card">
      <slot />
    </main>
    <Footer />
  </body>
</html>
