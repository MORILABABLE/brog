---
import { SITE, OG_IMAGE, CARD_IMAGE, GA_MEASUREMENT_ID, ADSENSE_CLIENT } from '../config'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import LinkSwitch from '../components/LinkSwitch.astro'
import LeftRail from '../components/LeftRail.astro'
import FollowRail from '../components/FollowRail.astro'
import { UNEXT_AD_ENABLED } from '../lib/unext-ad'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** 記事ページなら published 日時（JSON-LD 用） */
  publishedAt?: Date
  updatedAt?: Date
  /** 検索結果に出したくないページ（お問い合わせ等）は true */
  noindex?: boolean
  /**
   * このページ専用のOGP画像パス（絶対URLではなく `/cards/xxx.jpg` の形）。
   * 記事ページは記事ごとのカード画像を渡す。省略時はサイト共通の既定画像。
   * カードは `cd site && node scripts/make-cards.mjs` で生成する。
   */
  ogImagePath?: string
  /**
   * このページ専用の構造化データ。渡すと既定（Article / WebSite）を**置き換える**。
   *
   * 作品ページが `Movie` / `TVSeries` を出すために開けてある口
   * （docs/WORK-PAGES.md 9節）。渡さなければ今までどおりの挙動。
   *
   * ★ 配信の可否や価格を主張する型（`offers` / `WatchAction`）を入れないこと。
   *   このサイトは「いま観られるか」を観測していない。
   *   画面で断定しないものを、構造化データでだけ断定してはいけない。
   */
  jsonLd?: Record<string, unknown>
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  noindex = false,
  ogImagePath,
  jsonLd: jsonLdOverride,
} = Astro.props

/**
 * 公開URLの形にパスを正規化する。
 *
 * astro.config の build.format: 'file' により、ビルド中の pathname には
 * `.html` が付く（トップは `/index.html`）。Cloudflare Pages は拡張子なしで
 * 配信するため、canonical をそのまま出すと実在しないURLを正規URLとして
 * 宣言してしまい、重複コンテンツ扱いになる。
 */
function toPublicPath(pathname: string): string {
  if (pathname === '/index.html') return '/'
  return pathname.replace(/index\.html$/, '').replace(/\.html$/, '')
}

const publicPath = toPublicPath(Astro.url.pathname)
const canonical = new URL(publicPath, Astro.site ?? SITE.url).href

// OGP画像は絶対URLでないと各SNSが解決できない
const ogImage = new URL(ogImagePath ?? OG_IMAGE.path, Astro.site ?? SITE.url).href
// 記事ごとのカードは記事タイトルそのものが描かれているので、alt もタイトルにする
const ogImageAlt = ogImagePath ? title : OG_IMAGE.alt
// 既定画像とカードでは縦横比が違う。宣言する寸法も切り替える。
const ogSize = ogImagePath ? CARD_IMAGE : OG_IMAGE

// トップだけはタグラインを併記し、下層ページはサイト名を後置する
const isHome = publicPath === '/'
const fullTitle = isHome ? `${SITE.name}｜${SITE.tagline}` : `${title}｜${SITE.name}`

// ページから渡されればそれを使う。無ければ記事は Article、それ以外は WebSite。
const jsonLd = jsonLdOverride ?? (publishedAt
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: publishedAt.toISOString(),
      dateModified: (updatedAt ?? publishedAt).toISOString(),
      author: { '@type': 'Organization', name: SITE.author },
      publisher: { '@type': 'Organization', name: SITE.name },
      mainEntityOfPage: canonical,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
    })
---

<!doctype html>
<html lang="ja">
  <head>
    {/*
      Google アナリティクス（GA4）。全ページ共通なのでここに1か所だけ置く。

      ★ is:inline を外さないこと。
        Astro は通常の <script> をバンドルして module として読み込むため、
        gtag() がグローバルに定義されず、あとから
        gtag('event', ...) を書いたときに ReferenceError になる。
        JSON-LD と同じで、書いたものをそのまま出す必要がある。

      ★ define:vars は使わない。
        Astro がスクリプトを IIFE で包むので gtag が関数スコープに閉じる
        （LinkSwitch.astro の注意書きと同じ理由）。IDの差し込みは set:html で行う。

      測定IDは config.ts の GA_MEASUREMENT_ID。
    */}
    {/*
      ローカル開発とプレビュー環境を計測から外す。

      `window['ga-disable-<測定ID>'] = true` は GA 公式のオプトアウト用フラグで、
      立っているとタグは読み込まれても計測データを送らない。
      タグごと消さないのは、gtag() を未定義にしないため
      （上の ★ と同じ理由。dev で gtag('event', ...) が ReferenceError になる）。

      ★ このスクリプトは gtag.js の <script> より**前**に置くこと。
        後ろだと読み込み完了のタイミング次第で最初の1発が送られてしまう。

      ★ ここで正規表現リテラルを使わないこと。
        set:html の中身はテンプレートリテラルなので、`\[` のような
        バックスラッシュはHTMLに出る前に潰れる（`\[::1\]` が `[::1]` になり、
        IPv6アドレスのつもりが文字クラスになる）。配列の includes なら
        バックスラッシュが要らないので、この罠を踏まない。

      除外するホスト:
        localhost / 127.0.0.1 / [::1] … npm run dev, astro preview
        *.pages.dev                    … Cloudflare Pages のプレビュー配信
      本番は mihoudairader.com（config.ts の SITE.url）だけが計測対象になる。
    */}
    <script
      is:inline
      set:html={`window['ga-disable-${GA_MEASUREMENT_ID}'] =
        ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname) ||
        location.hostname.endsWith('.pages.dev');`}
    />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '${GA_MEASUREMENT_ID}');`}
    />

    {/*
      AdSense のコード（2026-09-03 追加）。**全ページの <head> に1本だけ。**

      ■ なぜここに要るのか
      **審査はサイトにこのコードが貼られてから始まる。** それまでサイト内の
      AdSense コードは components/AdSlot.astro の中だけにあり、
      その AdSlot は `PUBLIC_ADSENSE_CLIENT` と `slot` の**両方**を要求していた。
      唯一の呼び出し（pages/posts/[...slug].astro）は slot を渡していないので、
      パブリッシャーIDを入れても永久に1バイトも出力されない状態だった。
      広告ユニットIDは審査に通ってからでないと作れないので、
      **枠とは切り離して、ここでコードだけを出す。**

      ★ 未設定なら何も出さない。既定はオフのまま（config.ts の ADSENSE_CLIENT）。

      ★ GA や LinkSwitch と違い、**ホスト名で止めていない。**
        あちらは「登録していないドメインで動くと規約違反・自己クリックになる」ので
        除外リスト方式にしてあるが、こちらは逆で、
        **審査のクローラーがHTMLの中にこのタグを見つけられないと審査が始まらない。**
        JSで後から差し込む形にすると見つけてもらえない可能性がある。
        広告の配信自体は Google 側がアカウントに登録済みのドメインに限るので、
        プレビュー配信（*.pages.dev）にタグが出ても広告は出ない。

      ★ **審査に通ったら `public/ads.txt` を置くこと。**
        `google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0`
        （パブリッシャーIDは自分のものに置き換える）。審査前には不要。
    */}
    {ADSENSE_CLIENT && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    {/* ファビコン。SVG非対応の古いブラウザ向けに PNG も併記する。 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={publishedAt ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* 構造化データはビルド時に加工されず、そのまま出力される必要がある */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {/*
      バリューコマース LinkSwitch。
      本文中の U-NEXT / Hulu などの通常リンクを、ブラウザ側で
      アフィリエイトリンクに変換する。未設定なら何も出力されない
      （＝サイトはJSゼロのまま）。詳細は docs/AFFILIATE.md。
    */}
    <LinkSwitch />

    {/*
      afb の vref.js（2026-09-04 追加）。**afb のリンクを置いたときだけ出す。**

      ■ 何をするスクリプトか
      ページ内の `t.afi-b.com` 宛のリンクに `v_ref=<いまのページURL>` を足すだけ。
      これが無いと、成果データの「リンク元ページ」は**オリジンだけ**になり
      （ブラウザ既定の `strict-origin-when-cross-origin`）、
      700ページのどこで成果が出たのかが永久に分からない（docs/AFFILIATE.md 11-5）。

      ★ **リンクを置く前に入れないこと。** afb のリンクが1本も無いページで
        外部スクリプトを1本増やすだけになる。判定は U-NEXT の広告と同じ
        `UNEXT_AD_ENABLED`（＝リンクコードが .env に入っているか）。
      ★ 成果が出てから遡って直せない値なので、**リンクを置くのと同時に入れる。**
    */}
    {UNEXT_AD_ENABLED && <script is:inline async src="https://t.afi-b.com/jslib/vref.js" />}
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />

    {/*
      ★ 以前はここに全ページ共通のヘッダーバナー（src/assets/header-banner.png）を
        出していたが、2026-08-24 に外した。画面の一番上をヘッダーと本文だけにして、
        読者がすぐ一覧に入れるようにするため。
        画像ファイル自体は消していない。**OG画像（SNS共有画像）の元になっている**
        （site/scripts/make-og.mjs）ので、消すとその生成が落ちる。

      本文カード＋左右の枠。
      .layout は 1200px 未満では block（＝1カラム）、
      それ以上で3カラムのグリッドになり、左右の余白に枠が載る。
      本文の幅はどちらでも変わらない。styles/global.css の .layout を参照。

      ★ 並びは 左枠 → 本文 → 右枠。
        画面での並びと同じ順に置くこと（読み上げ・キーボード操作がこの順になる）。
        本文へは先頭の「本文へスキップ」で直接飛べる。
    */}
    <div class="layout">
      {/* 常設ページ一覧。狭い画面では消える */}
      <LeftRail />
      {/* 背景グラフィックから浮かせる本文カード。styles/global.css の .content-card。 */}
      <main id="main" class="content-card">
        <slot />
      </main>
      {/* 新着記事＋PR枠。狭い画面では消える */}
      <FollowRail />
    </div>
    <Footer />
  </body>
</html>
