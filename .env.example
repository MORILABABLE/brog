# --- 配信情報の収集（P0） ---
# Streaming Availability API (Movie of the Night)
# https://developers.movieofthenight.com/ で無料登録して取得する。
# 無料枠 500リクエスト/月。商用利用（広告・アフィリエイト）が明示的に許可されている。
#
# ※ TMDB / Watchmode は無料枠が非商用限定のため、収益化するこのサイトでは使えない。
STREAMING_API_KEY=

# --- 記事生成（P2） ---
# プロバイダは3つから選ぶ。切り替えは下の行を書き換えるだけ。
#   anthropic     : Claude
#   gemini        : Google Gemini
#   openai-compat : OpenAI / DeepSeek / Groq / OpenRouter / Ollama（ローカル）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Gemini に切り替える場合
# LLM_PROVIDER=gemini
# LLM_MODEL=（モデルIDを指定）
# GEMINI_API_KEY=

# OpenAI互換に切り替える場合（DeepSeek の例）
# LLM_PROVIDER=openai-compat
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=

# Anthropic 以外は料金表を持っていないため、コスト表示を出したい場合は
# 100万トークンあたりの単価をここで明示する（未設定ならコストは「不明」と表示される）。
# LLM_PRICE_INPUT=0.30
# LLM_PRICE_OUTPUT=1.20

# --- Search Console（P3・ページ別の検索語） ---
# `npm run queries` が「どのページに、どの検索語で来ているか」を取り込み、
# data/search-queries.json に書く。サイト側は Amazon 導線の検索語に使う
# （site/src/lib/page-intent.ts）。未設定なら何もしない。
#
# ★ サービスアカウントを作るだけでは読めない。**Search Console の
#   「設定 → ユーザーと権限」で、そのサービスアカウントのメールアドレスを
#   追加すること。** 忘れると 403 になる。手順は pipeline/cli/queries.ts の冒頭。
#
# ドメインプロパティなら sc-domain: 、URLプレフィックスなら https://…/ の形。
# GSC_SITE_URL=sc-domain:mihoudairader.com
# サービスアカウントのJSONキーへのパス（リポジトリに入れないこと）
# GSC_SERVICE_ACCOUNT=./secrets/gsc.json
